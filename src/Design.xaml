  <Style x:Key="Brand" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FsSubtitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Заголовок секции: «СЕРВЕР», «ИЗБРАННОЕ». -->
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu2}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Small" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu2}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="Icon" TargetType="Path">
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
  </Style>

  <!-- Основа всех кнопок: подложка со скруглением, затемнение при наведении, рамка фокуса. -->
  <Style x:Key="Plain" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource FsLabel}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Tag" Value="{DynamicResource Hov}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding o:Ui.CornerRadius}"/>
            <Border x:Name="Hover" Background="{TemplateBinding Tag}" CornerRadius="{TemplateBinding o:Ui.CornerRadius}" Opacity="0"/>
            <Border x:Name="Focus" BorderBrush="{DynamicResource Ac}" BorderThickness="2" CornerRadius="{TemplateBinding o:Ui.CornerRadius}" Visibility="Collapsed"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
  </Style>
  <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu2}"/>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Height" Value="42"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="Background" Value="{DynamicResource Ac}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Tag" Value="{DynamicResource OverlayOnAccent}"/>
  </Style>
  <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Tag" Value="{DynamicResource OverlayHover}"/>
  </Style>
  <Style x:Key="BtnOutline" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
    <Setter Property="Background" Value="{DynamicResource B2}"/>
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BL}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
    <Setter Property="Tag" Value="{DynamicResource OverlayPress}"/>
  </Style>
  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Height" Value="34"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
  </Style>
  <Style x:Key="BtnLink" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="8,0,6,0"/>
    <Setter Property="FontSize" Value="{StaticResource FsNote}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ac}"/>
  </Style>

  <!-- Строка списка: сервер, вариант меню. Выбранная строка подсвечена через Tag-триггер в коде строки. -->
  <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Height" Value="54"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="Padding" Value="10,0,12,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <!-- Переключатель 40×24, ручка 18 px; анимация 200 мс. -->
  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="40" Height="24" Background="Transparent">
            <Border x:Name="Track" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Ring}"/>
            <Border x:Name="Focus" CornerRadius="{StaticResource RadiusLg}" BorderBrush="{DynamicResource Ac}" BorderThickness="2" Margin="-3" Visibility="Collapsed"/>
            <Ellipse x:Name="Dot" Width="18" Height="18" Fill="{DynamicResource Knob}" HorizontalAlignment="Left" Margin="3,0,3,0">
              <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/></Ellipse.Effect>
              <Ellipse.RenderTransform><TranslateTransform x:Name="Knob" X="0"/></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Ac}"/>
              <!-- Положение ручки задаёт состояние, анимация только добавляет движение: иначе
                   включённый переключатель, ещё не показанный на экране, выглядел выключенным. -->
              <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" From="-16" To="0" Duration="0:0:0.2" FillBehavior="Stop"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" From="16" To="0" Duration="0:0:0.2" FillBehavior="Stop"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Поле ввода: фон field, подсказка из Tag, рамка акцента при фокусе. -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Tx}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Plate" CornerRadius="{StaticResource RadiusMd}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ac}" BorderThickness="0">
            <Grid>
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Fa}" Margin="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Plate" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Bg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Подложка с тенью под всплывающими панелями. Тень мягкая и короткая; текст лежит
       в соседнем слое без эффекта, иначе WPF рисует его размыто. -->
  <Style x:Key="ShadowLayer" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Pop}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Effect">
      <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="{StaticResource DialogShadow}" Opacity="0.13"/></Setter.Value>
    </Setter>
  </Style>

  <!-- Чипы-переключатели — это ListBox: выбранный чип и есть значение (порядок серверов, действие правила). -->
  <Style x:Key="ChipItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chip" Height="30" CornerRadius="{StaticResource RadiusXl}" Padding="12,0" Margin="0,0,6,0" Background="{DynamicResource Field}">
            <TextBlock x:Name="Label" Text="{Binding}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Ac}"/>
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OnAccent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
