<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Сгенерировано scripts/tokens.ps1 из theme/tokens.json. Руками не править: изменения пропадут. -->
  <Color x:Key="DialogShadow">#0D1B30</Color>  <!-- тень диалогов (общая для тем: эффект в стиле не меняет цвет на лету) -->
  <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Golos Text, Segoe UI</FontFamily>  <!-- интерфейс -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>  <!-- ключи, адреса, домены -->
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Onest, Segoe UI</FontFamily>  <!-- статус, заголовки разделов, цифры -->
  <sys:Double x:Key="FsCaption">11.5</sys:Double>  <!-- заголовки секций, мелкие подписи -->
  <sys:Double x:Key="FsSmall">12</sys:Double>  <!-- вторичные строки, подсказки -->
  <sys:Double x:Key="FsNote">12.5</sys:Double>  <!-- пояснения под переключателями -->
  <sys:Double x:Key="FsBody">13</sys:Double>  <!-- основной текст карточек -->
  <sys:Double x:Key="FsLabel">13.5</sys:Double>  <!-- кнопки, строки списков -->
  <sys:Double x:Key="FsRow">14</sys:Double>  <!-- названия настроек и серверов -->
  <sys:Double x:Key="FsRowLarge">14.5</sys:Double>  <!-- крупные строки -->
  <sys:Double x:Key="FsLead">15</sys:Double>  <!-- вводный текст -->
  <sys:Double x:Key="FsSubtitle">17</sys:Double>  <!-- заголовок диалога, название в шапке -->
  <sys:Double x:Key="FsTitle">20</sys:Double>  <!-- заголовок экрана -->
  <sys:Double x:Key="FsHeadline">24</sys:Double>  <!-- статус на главном экране -->
  <sys:Double x:Key="FsDisplay">26</sys:Double>  <!-- приветствие -->
  <sys:Double x:Key="FsDisplayStatus">18</sys:Double>  <!-- статус в карточке и крупные цифры боковой колонки -->
  <CornerRadius x:Key="RadiusXs">3</CornerRadius>  <!-- мелкие метки -->
  <CornerRadius x:Key="RadiusInner">8</CornerRadius>  <!-- сегмент внутри переключателя -->
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>  <!-- маленькие кнопки -->
  <CornerRadius x:Key="RadiusSeg">12</CornerRadius>  <!-- рамка переключателя-сегментов -->
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>  <!-- кнопки, строки -->
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>  <!-- поля, карточки -->
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>  <!-- крупные карточки, окна -->
  <CornerRadius x:Key="RadiusSheet">16</CornerRadius>  <!-- диалоги, выезжающие панели -->
  <CornerRadius x:Key="RadiusBadge">5</CornerRadius>  <!-- мелкие значки (YouTube и Discord в карточке обхода) -->
  <CornerRadius x:Key="RadiusAvatar">15</CornerRadius>  <!-- кружок аккаунта 30 px -->
  <CornerRadius x:Key="RadiusSky">16</CornerRadius>  <!-- карточка неба в боковой панели -->
  <CornerRadius x:Key="RadiusOrb">27</CornerRadius>  <!-- круглая кнопка подключения -->
  <CornerRadius x:Key="RadiusIcon">7</CornerRadius>  <!-- Цветной значок в настройках (как в iOS) -->
  <CornerRadius x:Key="RadiusIsland">16</CornerRadius>  <!-- остров содержимого справа -->
  <CornerRadius x:Key="RadiusToggle">14</CornerRadius>  <!-- дорожка тумблера -->
</ResourceDictionary>
