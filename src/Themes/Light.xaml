<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Сгенерировано scripts/tokens.ps1 из theme/tokens.json. Руками не править: изменения пропадут. -->
  <SolidColorBrush x:Key="Page" Color="#E4E8EE"/>  <!-- фон вокруг окна в превью -->
  <SolidColorBrush x:Key="Side" Color="#EEF1F5"/>  <!-- фон окна и боковой панели, под островом содержимого -->
  <SolidColorBrush x:Key="Bg" Color="#FFFFFF"/>  <!-- фон окна -->
  <SolidColorBrush x:Key="CardBg" Color="#F4F6F9"/>  <!-- карточки в настройках -->
  <SolidColorBrush x:Key="Field" Color="#F2F4F7"/>  <!-- поля ввода, вторичные кнопки, сегменты -->
  <SolidColorBrush x:Key="Seg" Color="#FFFFFF"/>  <!-- активный сегмент -->
  <SolidColorBrush x:Key="Tx" Color="#18243A"/>  <!-- основной текст -->
  <SolidColorBrush x:Key="Mu" Color="#5E6B80"/>  <!-- вторичный текст -->
  <SolidColorBrush x:Key="Mu2" Color="#6B7890"/>  <!-- подписи, заголовки секций -->
  <SolidColorBrush x:Key="Fa" Color="#8A96A8"/>  <!-- самый бледный текст, плейсхолдеры -->
  <SolidColorBrush x:Key="Divider" Color="#EDF0F4"/>  <!-- разделители -->
  <SolidColorBrush x:Key="Ac" Color="#2F64E9"/>  <!-- акцент -->
  <SolidColorBrush x:Key="Acs" Color="#EEF3FE"/>  <!-- фон выбранной строки -->
  <SolidColorBrush x:Key="Aci" Color="#E6EDFD"/>  <!-- фон иконок-кружков -->
  <SolidColorBrush x:Key="Hov" Color="#F3F6FA"/>  <!-- наведение -->
  <SolidColorBrush x:Key="Hovs" Color="#E9F0FE"/>  <!-- наведение на выбранную строку -->
  <SolidColorBrush x:Key="Ring" Color="#C9D1DD"/>  <!-- контуры радио и чекбоксов -->
  <SolidColorBrush x:Key="OkB" Color="#E9F7EF"/>  <!-- плашка «связь проверена» — фон -->
  <SolidColorBrush x:Key="OkF" Color="#17703F"/>  <!-- плашка «связь проверена» — текст -->
  <SolidColorBrush x:Key="Ok" Color="#2FB36A"/>  <!-- зелёные точки и галочки -->
  <SolidColorBrush x:Key="NB" Color="#F1F5FE"/>  <!-- объявление — фон -->
  <SolidColorBrush x:Key="NF" Color="#2A3A57"/>  <!-- объявление — текст -->
  <SolidColorBrush x:Key="WB" Color="#FFF4E8"/>  <!-- предупреждение — фон -->
  <SolidColorBrush x:Key="WF" Color="#5A4632"/>  <!-- предупреждение — текст -->
  <SolidColorBrush x:Key="WI" Color="#C25E0A"/>  <!-- предупреждение — значок -->
  <SolidColorBrush x:Key="WL" Color="#EBD6BF"/>  <!-- предупреждение — обводка -->
  <SolidColorBrush x:Key="EB" Color="#FDF0EF"/>  <!-- ошибка — фон -->
  <SolidColorBrush x:Key="EF" Color="#5A2B29"/>  <!-- ошибка — текст -->
  <SolidColorBrush x:Key="EI" Color="#C9302C"/>  <!-- ошибка — значок -->
  <SolidColorBrush x:Key="EL" Color="#EFC9C7"/>  <!-- ошибка — обводка -->
  <SolidColorBrush x:Key="ETrack" Color="#F3D6D5"/>  <!-- тумблер в состоянии ошибки -->
  <SolidColorBrush x:Key="SB" Color="#FFF6E0"/>  <!-- подписка заканчивается — фон -->
  <SolidColorBrush x:Key="SF" Color="#5A4520"/>  <!-- подписка заканчивается — текст -->
  <SolidColorBrush x:Key="SBtn" Color="#F2B01E"/>  <!-- подписка заканчивается — кнопка -->
  <SolidColorBrush x:Key="RB" Color="#FDECEB"/>  <!-- правило «блок» — фон -->
  <SolidColorBrush x:Key="RF" Color="#B3261E"/>  <!-- правило «блок» — текст -->
  <SolidColorBrush x:Key="Off" Color="#DCE2EA"/>  <!-- дорожка тумблера «выкл» -->
  <SolidColorBrush x:Key="Mid" Color="#8FAEF4"/>  <!-- тумблер «подключаемся» -->
  <SolidColorBrush x:Key="MidI" Color="#7FA2F2"/>  <!-- значок тумблера «подключаемся» -->
  <SolidColorBrush x:Key="Knob" Color="#FFFFFF"/>  <!-- ручка тумблера -->
  <SolidColorBrush x:Key="Pop" Color="#FFFFFF"/>  <!-- всплывающие окна и меню -->
  <SolidColorBrush x:Key="B2" Color="#FFFFFF"/>  <!-- кнопка-обводка на карточке — фон -->
  <SolidColorBrush x:Key="BL" Color="#DDE3EB"/>  <!-- кнопка-обводка на карточке — обводка -->
  <SolidColorBrush x:Key="Sky" Color="#EAF1FE"/>  <!-- небо в приветствии -->
  <SolidColorBrush x:Key="Cloud" Color="#FFFFFF"/>  <!-- облака в приветствии -->
  <SolidColorBrush x:Key="RingSoft" Color="#D3DEF7"/>  <!-- мягкое кольцо вокруг тумблера -->
  <SolidColorBrush x:Key="FootWarn" Color="#B26B00"/>  <!-- предупреждение в подвале -->
  <Color x:Key="ShadowColor">#2E0D1B30</Color>  <!-- тень окон -->
  <Color x:Key="GlowColor">#522F64E9</Color>  <!-- свечение главной кнопки (синее) -->
  <Color x:Key="OkGlowColor">#662FB36A</Color>  <!-- свечение кнопки подключения, когда VPN включён -->
  <SolidColorBrush x:Key="LatFast" Color="#2FB36A"/>  <!-- пинг меньше 160 мс -->
  <SolidColorBrush x:Key="LatMid" Color="#D9A01E"/>  <!-- пинг 160–250 мс -->
  <SolidColorBrush x:Key="LatSlow" Color="#D9731E"/>  <!-- пинг больше 250 мс -->
  <SolidColorBrush x:Key="LatFail" Color="#D9483B"/>  <!-- сервер не ответил -->
  <SolidColorBrush x:Key="Alert" Color="#D9731E"/>  <!-- кружок «!» на карточке восстановления -->
  <SolidColorBrush x:Key="Star" Color="#F2B01E"/>  <!-- звезда избранного -->
  <SolidColorBrush x:Key="FlagRing" Color="#40808CA0"/>  <!-- тонкий контур вокруг флага -->
  <SolidColorBrush x:Key="OverlayOnAccent" Color="#14FFFFFF"/>  <!-- подсветка при наведении на акцентную кнопку -->
  <SolidColorBrush x:Key="OverlayHover" Color="#0A000000"/>  <!-- подсветка при наведении на простую кнопку -->
  <SolidColorBrush x:Key="OverlayPress" Color="#08000000"/>  <!-- подсветка нажатия -->
  <SolidColorBrush x:Key="OverlayTray" Color="#1A000000"/>  <!-- подсветка тумблера в трее -->
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>  <!-- текст и значки на акцентном и цветном фоне -->
  <SolidColorBrush x:Key="SBtnText" Color="#2E2205"/>  <!-- подписка заканчивается — текст кнопки «Продлить» -->
  <SolidColorBrush x:Key="OverlayDanger" Color="#14000000"/>  <!-- подсветка при наведении на красную кнопку «Выйти» в трее -->
  <SolidColorBrush x:Key="OnSky" Color="#E6FFFFFF"/>  <!-- подпись статуса на небе -->
  <SolidColorBrush x:Key="BrandYouTube" Color="#FF0033"/>  <!-- значок YouTube в карточке обхода -->
  <SolidColorBrush x:Key="BrandDiscord" Color="#5865F2"/>  <!-- значок Discord в карточке обхода -->
  <SolidColorBrush x:Key="CloseHover" Color="#E81123"/>  <!-- наведение на кнопку «закрыть окно» -->
</ResourceDictionary>
