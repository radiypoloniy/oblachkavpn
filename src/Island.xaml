<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:o="clr-namespace:Oblachka">
  <!-- Разделы острова (редизайн 0.16): фильтры списка, плашка маршрута, переключатель
       «VPN · Напрямую · Блок» в строке программы. Цвета, размеры и скругления — только токены. -->
  <Geometry x:Key="IcoFolder">M2,6 L9,6 L11,8 L22,8 L22,19 L2,19 Z</Geometry>

  <!-- Фильтр списка: ListBox, выбранный пункт — значение. Мягкая подсветка, а не заливка акцентом. -->
  <Style x:Key="FilterChip" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chip" Height="30" CornerRadius="{StaticResource RadiusXl}" Padding="12,0" Margin="0,0,4,0" Background="Transparent">
            <TextBlock x:Name="Label" Text="{Binding}" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource Hov}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Aci}"/>
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Ac}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Куда идёт программа сейчас: «через VPN», «напрямую», «VPN 29 · напрямую 2». -->
  <Style x:Key="RoutePill" TargetType="Border">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource Field}"/>
  </Style>

  <!-- Метка «правило» рядом с именем программы. -->
  <Style x:Key="RuleTag" TargetType="Border">
    <Setter Property="Height" Value="18"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusBadge}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource Field}"/>
  </Style>

  <!-- Переключатель «VPN · Напрямую · Блок»: три кнопки на общей подложке, выбранная — цветом правила. -->
  <Style x:Key="PickPlate" TargetType="Border">
    <Setter Property="Padding" Value="3"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Background" Value="{DynamicResource Bg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PickButton" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
  </Style>
  <Style x:Key="PickVpn" TargetType="Button" BasedOn="{StaticResource PickButton}">
    <Style.Triggers>
      <Trigger Property="o:Ui.Selected" Value="True"><Setter Property="Background" Value="{DynamicResource Ac}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PickDirect" TargetType="Button" BasedOn="{StaticResource PickButton}">
    <Style.Triggers>
      <Trigger Property="o:Ui.Selected" Value="True"><Setter Property="Background" Value="{DynamicResource Ok}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PickBlock" TargetType="Button" BasedOn="{StaticResource PickButton}">
    <Style.Triggers>
      <Trigger Property="o:Ui.Selected" Value="True"><Setter Property="Background" Value="{DynamicResource EI}"/><Setter Property="Foreground" Value="{DynamicResource OnAccent}"/></Trigger>
    </Style.Triggers>
  </Style>

  <!-- Подпись над строкой подробностей: «Сейчас на связи с». -->
  <Style x:Key="DetailKey" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FsCaption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fa}"/>
    <Setter Property="Margin" Value="0,10,0,2"/>
  </Style>
</ResourceDictionary>
