<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views">
  <!-- Боковая панель и остров (редизайн 0.16): значки разделов, карточки-пульты, пункты разделов,
       шестерёнка. Цвета, размеры и скругления — только токены. -->
  <Geometry x:Key="IcoPulse">M3,12 L7,12 L10,5 L14,19 L17,12 L21,12</Geometry>
  <Geometry x:Key="IcoGlobe">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 M3,12 L21,12 M12,3 A14,14 0 0 1 12,21 M12,3 A14,14 0 0 0 12,21</Geometry>
  <Geometry x:Key="IcoRules">M4,7 L14,7 M18,7 L20,7 M4,17 L8,17 M12,17 L20,17 M18,7 A2,2 0 1 1 14,7 A2,2 0 1 1 18,7 M12,17 A2,2 0 1 1 8,17 A2,2 0 1 1 12,17</Geometry>
  <Geometry x:Key="IcoGear">M10.08,4.85 L10.50,2.52 L13.50,2.52 L13.92,4.85 L15.70,5.59 L17.64,4.23 L19.77,6.36 L18.41,8.30 L19.15,10.08 L21.48,10.50 L21.48,13.50 L19.15,13.92 L18.41,15.70 L19.77,17.64 L17.64,19.77 L15.70,18.41 L13.92,19.15 L13.50,21.48 L10.50,21.48 L10.08,19.15 L8.30,18.41 L6.36,19.77 L4.23,17.64 L5.59,15.70 L4.85,13.92 L2.52,13.50 L2.52,10.50 L4.85,10.08 L5.59,8.30 L4.23,6.36 L6.36,4.23 L8.30,5.59 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12</Geometry>
  <Geometry x:Key="IcoMaximize">M5,5 L19,5 L19,19 L5,19 Z</Geometry>
  <Geometry x:Key="IcoKit">M4,8 L20,8 L20,20 L4,20 Z M9,8 L9,5 L15,5 L15,8 M12,11 L12,17 M9,14 L15,14</Geometry>

  <!-- Строка сервера на карточке статуса: полупрозрачная поверх цвета погоды. -->
  <Style x:Key="GlassRow" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Background" Value="{DynamicResource Glass}"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Height" Value="50"/>
    <Setter Property="Padding" Value="12,0,10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <!-- Карточка-пульт (сервер): белая подложка на фоне окна. Тень — отдельным слоем SideShadow
       под карточкой: эффект на самой карточке размывал бы текст и пересчитывался бы при каждом
       обновлении пинга и времени подключения (в 0.16-rc это стоило ~10% процессора). -->
  <Style x:Key="SideCard" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Background" Value="{DynamicResource Bg}"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusXl}"/>
    <Setter Property="Padding" Value="11,9"/>
    <Setter Property="MinHeight" Value="54"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <!-- Та же карточка без нажатия целиком: внутри свои кнопки (обход блокировок). -->
  <Style x:Key="SideCardPlate" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
    <Setter Property="Padding" Value="11,9"/>
    <Setter Property="MinHeight" Value="54"/>
  </Style>
  <!-- Тень карточки: пустая подложка с эффектом, закэшированная картинкой. -->
  <Style x:Key="SideShadow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Bg}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <!-- Теней в боковой колонке нет: слои различаются цветом (облик 0.20). -->
  </Style>

  <!-- Пункт раздела — пилюля. Выбранный — чернильный (o:Ui.Selected), размер одинаковый. -->
  <Style x:Key="SideNav" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="FontSize" Value="{StaticResource FsRowLarge}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="o:Ui.Selected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Ink}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnInk}"/>
        <Setter Property="Tag" Value="{DynamicResource OverlayOnAccent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SideIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="SideCount" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FsSmall}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Fa}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Шестерёнка в строке аккаунта: всегда 34×34 на одном месте; выбранная — подложкой и цветом. -->
  <Style x:Key="SideGear" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
    <Style.Triggers>
      <Trigger Property="o:Ui.Selected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ac}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Кнопки окна в строке заголовка (на общем фоне, над островом). -->
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource Plain}">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
    <Setter Property="o:Ui.CornerRadius" Value="0"/>
  </Style>
  <!-- Строка сервера (прежний быстрый список главного экрана; его строки берёт меню в трее). -->
    <DataTemplate x:Key="ServerRowTemplate" DataType="{x:Type o:ServerRow}">
      <Button x:Name="RowButton" Style="{StaticResource Row}" AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="32" Height="32" Visibility="{Binding FlagVisibility}" Stroke="{DynamicResource FlagRing}" StrokeThickness="1">
            <Ellipse.Fill><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Ellipse.Fill>
          </Ellipse>
          <Border x:Name="IconPlate" Width="32" Height="32" CornerRadius="{StaticResource RadiusSheet}" Background="{DynamicResource Aci}" Visibility="{Binding IconVisibility}">
            <Path x:Name="IconGlyph" Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource Ac}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsLead}" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Tx}"/>
            <TextBlock Text="{Binding Note}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Visibility="{Binding NoteVisibility}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding LatencyVisibility}">
            <Ellipse Width="6" Height="6" Fill="{Binding LatencyDot}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Latency}" FontSize="{StaticResource FsBody}" Foreground="{DynamicResource Mu2}"/>
          </StackPanel>
          <Grid Grid.Column="3" Width="22" Height="22" VerticalAlignment="Center">
            <Ellipse x:Name="MarkRing" Stroke="{DynamicResource Ring}" StrokeThickness="1.5"/>
            <Ellipse x:Name="MarkFill" Fill="{DynamicResource Ac}" Visibility="Collapsed"/>
            <Path x:Name="MarkCheck" Data="{StaticResource IcoCheck}" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource OnAccent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/></Path.RenderTransform>
            </Path>
          </Grid>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="RowButton" Property="Background" Value="{DynamicResource Acs}"/>
          <Setter TargetName="RowButton" Property="Tag" Value="{DynamicResource Hovs}"/>
          <Setter TargetName="MarkRing" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="MarkFill" Property="Visibility" Value="Visible"/>
          <Setter TargetName="MarkCheck" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconOnAccent}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Ac}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="{DynamicResource OnAccent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconMuted}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Field}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="{DynamicResource Mu2}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
