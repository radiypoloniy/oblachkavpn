<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Oblachka</AssemblyName>
    <Version>0.18.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>Oblachka.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RestoreSources></RestoreSources>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!-- Тестовые части MainWindow и захват превью (Window/Fixtures) собираются только по явному флагу.
       build.ps1 собирает без него: в поставляемом Oblachka.exe тестового кода нет.
       test.ps1 собирает с -p:IncludeTestCode=true. -->
  <PropertyGroup Condition="'$(IncludeTestCode)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(IncludeTestCode)' != 'true'">
    <Compile Remove="Window/Fixtures/**"/>
  </ItemGroup>
  <ItemGroup>
    <!-- Проверки лежат в отдельной сборке и пользуются internal-членами клиента. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Oblachka.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/countries-*.json"/>
    <Resource Include="Assets/Flags/*.png"/>
    <!-- Иконка: exe (ApplicationIcon), окна и трей (ресурс). -->
    <Resource Include="Assets/app.ico"/>
    <!-- Манифест zapret из репозитория: запасной, если GitHub недоступен. -->
    <EmbeddedResource Include="../zapret/manifest.json" LogicalName="Oblachka.zapret.manifest.json" Condition="Exists('../zapret/manifest.json')"/>
  </ItemGroup>
</Project>


