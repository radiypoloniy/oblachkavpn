<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Oblachka.Views" xmlns:o="clr-namespace:Oblachka"
        x:Class="Oblachka.MainWindow" Title="Облачка" Icon="/Assets/app.ico" Width="1040" Height="700" MinWidth="380" MinHeight="640" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Side}" Foreground="{DynamicResource Tx}" FontFamily="{StaticResource UiFont}" PreviewKeyDown="WindowKeyDown">
  <!-- Окно 0.16 (редизайн): фон — боковая панель (Home) во всю высоту; содержимое разделов —
       на скруглённом острове справа, как в Параметрах Windows 11. Кнопки окна — в строке
       заголовка над островом. Узкое окно (MainWindow.Layout): только боковая панель, раздел
       открывается островом поверх неё. Перетаскивание — за строку заголовка высотой 44 px. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Стили старых экранов: уйдут вместе с ними. -->
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Shell">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SideColumn" Width="276"/>
      <ColumnDefinition x:Name="IslandColumn" Width="*"/>
    </Grid.ColumnDefinitions>

    <views:HomeView x:Name="Home"/>

    <!-- Остров: тень — отдельным слоем (эффект на контейнере с текстом размывает текст). -->
    <Grid x:Name="Island" Grid.Column="1" Margin="0,44,10,10">
      <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSky}" Background="{DynamicResource Bg}"/>
      <Border x:Name="IslandPlate" CornerRadius="{StaticResource RadiusSky}" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <Grid x:Name="IslandHost">
          <views:ConnectionsView x:Name="Live" Visibility="Collapsed"/>
          <views:ServersSheet x:Name="Servers" Visibility="Collapsed"/>
          <views:SettingsPanel x:Name="Settings" Visibility="Collapsed"/>
          <views:AppPicker x:Name="Picker" Visibility="Collapsed"/>
          <views:NetworkDoctorView x:Name="Doctor" Visibility="Collapsed"/>
          <views:SiteCheckView x:Name="SiteCheck" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>

    <views:OnboardingView x:Name="Onboarding" Grid.ColumnSpan="2" Visibility="Collapsed"/>

    <!-- Меню режима: всплывает над строкой режима. -->
    <Grid x:Name="ModeMenuLayer" Grid.ColumnSpan="2" Background="Transparent" Visibility="Collapsed" MouseDown="ModeMenuLayerMouseDown">
      <Grid x:Name="ModeMenu" Width="300" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,64" RenderTransformOrigin="0,1">
        <Grid.RenderTransform>
          <TransformGroup><ScaleTransform x:Name="ModeMenuScale"/><TranslateTransform x:Name="ModeMenuShift"/></TransformGroup>
        </Grid.RenderTransform>
        <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusXl}"/>
        <Border Padding="6" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <StackPanel>
          <Button x:Name="ModeTunOption" Style="{StaticResource Row}" Height="Auto" Padding="12,10" o:Ui.CornerRadius="{StaticResource RadiusMd}" AutomationProperties.Name="Весь компьютер">
            <DockPanel>
              <Ellipse x:Name="ModeTunRadio" DockPanel.Dock="Right" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="10,2,0,0"/>
              <StackPanel>
                <TextBlock Text="Весь компьютер" FontSize="{StaticResource FsLabel}" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModeTunNote" Text="Системный VPN: игры и любые программы." Style="{StaticResource Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="ModeProxyOption" Style="{StaticResource Row}" Height="Auto" Padding="12,10" o:Ui.CornerRadius="{StaticResource RadiusMd}" Margin="0,2,0,0" AutomationProperties.Name="Браузеры и программы">
            <DockPanel>
              <Ellipse x:Name="ModeProxyRadio" DockPanel.Dock="Right" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="10,2,0,0"/>
              <StackPanel>
                <TextBlock Text="Браузеры и программы" FontSize="{StaticResource FsLabel}" FontWeight="SemiBold"/>
                <TextBlock Text="Прокси Windows: без прав администратора, но не для всех приложений." Style="{StaticResource Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <!-- Короткие сообщения: только о том, чего не видно по статусу (ошибки, итоги действий). -->
    <Grid x:Name="Toast" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="460" Margin="24,0,24,28" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusLg}"/>
      <Border Padding="16,12" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Pop}" BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <TextBlock x:Name="ShellFeedback" FontSize="{StaticResource FsBody}" Foreground="{DynamicResource Tx}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
      </Border>
    </Grid>
    <!-- Кнопки окна: в строке заголовка, на общем фоне, над островом. -->
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Свернуть" Click="MinimizeClick">
        <Path Data="M1,7 L13,7" Style="{StaticResource Icon}" Stretch="None" Width="14" Height="14" StrokeThickness="1.4"/>
      </Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Развернуть" Click="MaximizeClick">
        <Path Data="{StaticResource IcoMaximize}" Style="{StaticResource Icon}" Width="11" Height="11" StrokeThickness="1.4"/>
      </Button>
      <Button x:Name="CloseWindowButton" Style="{StaticResource CaptionButton}" Tag="{DynamicResource CloseHover}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Закрыть" Click="CloseWindowClick">
        <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="11" Height="11" StrokeThickness="1.4"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
