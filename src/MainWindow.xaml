<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Oblachka.Views" xmlns:o="clr-namespace:Oblachka"
        x:Class="Oblachka.MainWindow" Title="Облачка" Width="420" Height="660" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Tx}" FontFamily="{StaticResource UiFont}" PreviewKeyDown="WindowKeyDown">
  <!-- Окно 420×660 без системного заголовка: шапку рисует каждый экран сам (design/redesign-2026-10-14).
       Свернуть и закрыть — справа в шапке, перетаскивание — за шапку высотой 56 px. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Стили старых экранов: уйдут вместе с ними. -->
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <views:HomeView x:Name="Home"/>
    <views:ServersSheet x:Name="Servers" Visibility="Collapsed"/>
    <views:SettingsPanel x:Name="Settings" Visibility="Collapsed"/>

    <views:OnboardingView x:Name="Onboarding" Visibility="Collapsed"/>

    <!-- Меню режима над подвалом. -->
    <Grid x:Name="ModeMenuLayer" Background="Transparent" Visibility="Collapsed" MouseDown="ModeMenuLayerMouseDown">
      <Border x:Name="ModeMenu" Width="290" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,50" Padding="6" CornerRadius="14"
              Background="{DynamicResource Pop}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" RenderTransformOrigin="1,1">
        <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="1"/></Border.Effect>
        <Border.RenderTransform>
          <TransformGroup><ScaleTransform x:Name="ModeMenuScale"/><TranslateTransform x:Name="ModeMenuShift"/></TransformGroup>
        </Border.RenderTransform>
        <StackPanel>
          <Button x:Name="ModeTunOption" Style="{StaticResource Row}" Height="Auto" Padding="12,10" o:Ui.CornerRadius="10" AutomationProperties.Name="Весь компьютер">
            <DockPanel>
              <Ellipse x:Name="ModeTunRadio" DockPanel.Dock="Right" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="10,2,0,0"/>
              <StackPanel>
                <TextBlock Text="Весь компьютер" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="ModeTunNote" Text="Системный VPN: игры и любые программы." Style="{StaticResource Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="ModeProxyOption" Style="{StaticResource Row}" Height="Auto" Padding="12,10" o:Ui.CornerRadius="10" Margin="0,2,0,0" AutomationProperties.Name="Браузеры и программы">
            <DockPanel>
              <Ellipse x:Name="ModeProxyRadio" DockPanel.Dock="Right" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" VerticalAlignment="Top" Margin="10,2,0,0"/>
              <StackPanel>
                <TextBlock Text="Браузеры и программы" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Text="Прокси Windows: без прав администратора, но не для всех приложений." Style="{StaticResource Small}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Короткие сообщения о ходе операций: всплывают над подвалом и прячутся сами. -->
    <Border x:Name="Toast" VerticalAlignment="Bottom" Margin="14,0,14,54" Padding="14,10" CornerRadius="12" Background="{DynamicResource Pop}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="1"/></Border.Effect>
      <TextBlock x:Name="ShellFeedback" FontSize="12.5" Foreground="{DynamicResource Tx}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
    </Border>


    <!-- Кнопки окна поверх всех экранов. -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
      <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Width="36" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Свернуть" Click="MinimizeClick">
        <Path Data="M1,7 L13,7" Style="{StaticResource Icon}" Stretch="None" Width="14" Height="14"/>
      </Button>
      <Button x:Name="CloseWindowButton" Style="{StaticResource IconButton}" Width="36" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Закрыть" Click="CloseWindowClick">
        <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13"/>
      </Button>
    </StackPanel>
  </Grid>
</Window>
