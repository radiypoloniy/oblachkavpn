<UserControl x:Class="Oblachka.Views.BypassPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Настройки → Обход блокировок (0.16): что открывается без VPN. YouTube и Discord — через
       zapret (MainWindow.Zapret), запасной путь — VPN только для них (MainWindow.Selective);
       российские сайты и правила сервиса — напрямую. Свои правила — раздел «Правила» на острове. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,0,20,16">
      <TextBlock Text="YOUTUBE И DISCORD" Style="{StaticResource SetCaption}" Margin="8,4,8,6"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="ZapretToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="YouTube и Discord без VPN"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcRed}"><Path Data="{StaticResource IcoPlay}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="Без VPN" Style="{StaticResource SetTitle}"/>
              <TextBlock x:Name="ZapretText" Text="Через обход блокировок zapret: быстрее и не тратит VPN" Style="{StaticResource SetSub}"/>
              <Button x:Name="ZapretPick" Content="Проверить заново" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="-8,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>
          <!-- Группы обхода раздельно: где обход в сети не справляется (YouTube), группу можно оставить
               в VPN, не выключая обход для другой (Discord). Подбор такую группу не проверяет. -->
          <StackPanel x:Name="ZapretGroups" Visibility="Collapsed">
            <DockPanel Style="{StaticResource SetLine}">
              <CheckBox x:Name="YouTubeBypass" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="YouTube через обход"/>
              <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcRed}"><Path Data="{StaticResource IcoPlay}" Style="{StaticResource SetGlyph}"/></Border>
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="YouTube через обход" Style="{StaticResource SetTitle}"/>
                <TextBlock x:Name="YouTubeState" Style="{StaticResource SetSub}"/>
              </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource SetLine}">
              <CheckBox x:Name="DiscordBypass" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Discord через обход"/>
              <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcBlue}"><Path Data="{StaticResource IcoSpeaker}" Style="{StaticResource SetGlyph}"/></Border>
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Discord и сайты из общего списка через обход" Style="{StaticResource SetTitle}"/>
                <TextBlock x:Name="DiscordState" Style="{StaticResource SetSub}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="SelectiveToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Через VPN только YouTube и Discord"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcPurple}"><Path Data="{StaticResource IcoRoute}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="Через VPN — только они" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Если обход в вашей сети не справляется. Остальное — напрямую: загрузки и игры не тратят VPN, ваши правила «через VPN» действуют." Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="НАПРЯМУЮ" Style="{StaticResource SetCaption}"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="RussiaDirect" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Российские сайты напрямую"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGreen}"><Path Data="{StaticResource IcoFlag}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock Text="Российские сайты" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Госуслуги, банки и почти весь рунет — не видят VPN" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel x:Name="ProviderRoutingRow" Style="{StaticResource SetLine}" Visibility="Collapsed">
            <CheckBox x:Name="ProviderRouting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Маршрутизация сервиса"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcTeal}"><Path Data="{StaticResource IcoRules}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
              <TextBlock x:Name="ProviderRoutingTitle" Text="Правила сервиса" Style="{StaticResource SetTitle}"/>
              <TextBlock x:Name="ProviderRoutingText" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
      <Button x:Name="OpenRules" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="2,10,0,0" Content="Свои правила для сайтов и программ — в «Правилах»"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
