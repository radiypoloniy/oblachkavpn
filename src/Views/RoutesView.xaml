<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RoutePilot.Views.RoutesView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32">
      <TextBlock Text="Маршруты" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Как программы используют туннель" Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
      <UniformGrid Columns="3">
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Opacity="0.5">
          <StackPanel>
            <TextBlock Text="Весь компьютер" FontWeight="SemiBold"/>
            <TextBlock Text="Появится с системным VPN" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Opacity="0.5">
          <StackPanel>
            <TextBlock Text="Умный режим" FontWeight="SemiBold"/>
            <TextBlock Text="Раздельные маршруты добавим позже" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Background="#F7F9FF" BorderBrush="{StaticResource Blue}">
          <StackPanel>
            <TextBlock Text="Только SOCKS5" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
            <TextBlock Text="Для программ с ручной настройкой прокси" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Background="#F5F6F8" CornerRadius="18" Padding="24" Margin="0,28,0,0">
        <StackPanel>
          <TextBlock Text="Адрес подключения" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="EndpointText" Text="Адрес SOCKS появится после запуска" Style="{StaticResource MutedText}" Margin="0,12,0,18"/>
          <Button x:Name="CopyEndpointButton" Content="Скопировать адрес" HorizontalAlignment="Left" Background="White" IsEnabled="False"/>
          <TextBlock Text="Выбери SOCKS5 в нужной программе и передавай имена сайтов через прокси. Не настраивай этот адрес как HTTP-прокси." Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Свои правила" FontSize="18" FontWeight="SemiBold" Margin="0,32,0,10"/>
      <TextBlock Text="Правила для сайтов и программ добавим вместе с системным режимом. Сейчас импортируем только подключение, без правил и DNS из полного JSON." Style="{StaticResource MutedText}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
