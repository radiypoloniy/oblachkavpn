<UserControl x:Class="Oblachka.Views.HelpTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Помощь (экран 13): проверка связи, подбор сервера, события сессии, отчёт. -->
  <DockPanel Margin="20,18,20,16">
    <Border DockPanel.Dock="Top" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource CardBg}" Padding="14,6,14,12">
      <StackPanel>
        <DockPanel Height="38">
          <Ellipse x:Name="CoreOk" Width="18" Height="18" Fill="{DynamicResource Ok}" Margin="0,0,10,0"/>
          <TextBlock x:Name="CoreState" DockPanel.Dock="Right" Text="не запущено" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center" FontSize="{StaticResource FsLabel}"/>
          <TextBlock Text="Ядро туннеля" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Height="38">
          <Ellipse x:Name="ProbeOk" Width="18" Height="18" Fill="{DynamicResource Ok}" Margin="0,0,10,0"/>
          <TextBlock x:Name="TunnelState" DockPanel.Dock="Right" Text="Не проверен" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center" FontSize="{StaticResource FsLabel}"/>
          <TextBlock Text="HTTPS-запрос через сервер" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Height="38">
          <Ellipse Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" Margin="0,0,10,0"/>
          <TextBlock DockPanel.Dock="Right" Text="не проверялись" Foreground="{DynamicResource Fa}" VerticalAlignment="Center" FontSize="{StaticResource FsLabel}"/>
          <TextBlock Text="DNS и IPv6 компьютера" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="ProbeButton" Content="Проверить" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}"/>
          <Button x:Name="FindRouteButton" Grid.Column="2" Content="Найти сервер" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}"/>
          <Button x:Name="ReconnectButton" Grid.Column="4" Content="Переподключить" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}"/>
        </Grid>
        <!-- Сайт проверки: адрес по умолчанию, поле для опытных скрыто. -->
        <TextBox x:Name="ProbeUrl" Text="https://www.gstatic.com/generate_204" Visibility="Collapsed"/>
        <TextBlock x:Name="LastCheck" Style="{StaticResource Small}" Margin="2,8,0,0"/>
        <TextBlock x:Name="NetworkNote" Visibility="Collapsed"/>
        <TextBlock x:Name="Heading" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom">
      <!-- Обновление без переустановки (AppUpdate): релизы GitHub, установщик по нажатию. -->
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource CardBg}" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <DockPanel>
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnOutline}" Height="34" Padding="14,0" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="UpdateTitle" Text="Обновления" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
              <TextBlock x:Name="UpdateText" Text="Проверим, нет ли новой версии" Style="{StaticResource Small}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <CheckBox x:Name="UpdateAuto" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Проверять обновления сами"/>
            <TextBlock Text="Проверять сами раз в 12 часов" Style="{StaticResource Small}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <CheckBox x:Name="UpdatePrerelease" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Получать пробные версии"/>
            <TextBlock Text="Получать пробные версии" Style="{StaticResource Small}" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <!-- Поломки, которые оставляют упавшие VPN и обходы блокировок (NetworkDoctor). -->
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource CardBg}" Padding="14,12" Margin="0,0,0,8">
        <DockPanel>
          <Button x:Name="NetworkCheckButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnOutline}" Height="34" Padding="14,0" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Сеть Windows" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
            <TextBlock Text="Интернет пропал после Throne, zapret или другого VPN? Найдём, что они оставили" Style="{StaticResource Small}" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource CardBg}" Padding="14,12">
        <StackPanel>
          <TextBlock Text="Не работает? Отправьте отчёт" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
          <TextBlock Text="Без ключей, адресов серверов и истории сайтов" Style="{StaticResource Small}" Margin="0,2,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CopyReportButton" Content="Скопировать" Style="{StaticResource BtnPrimary}" Height="36" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}"/>
            <Button x:Name="ExportButton" Grid.Column="2" Content="Сохранить файл" Style="{StaticResource BtnOutline}" Height="36" o:Ui.CornerRadius="{StaticResource RadiusMd}"/>
          </Grid>
        </StackPanel>
      </Border>
      <Button x:Name="VmTunButton" Content="Проверить TUN в виртуалке" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,6,0,0"/>
      <TextBlock x:Name="VmTunNote" Visibility="Collapsed"/>
      <TextBlock x:Name="VersionText" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Fa}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>

    <StackPanel Margin="0,10,0,10">
      <TextBlock Text="СОБЫТИЯ СЕССИИ" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,4,6,6"/>
      <TextBlock x:Name="EventText" Visibility="Collapsed"/>
      <ItemsControl x:Name="EventList" Margin="6,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,6">
              <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" Width="38" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Fa}"/>
              <TextBlock Text="{Binding Message}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DockPanel>
</UserControl>
