<UserControl x:Class="Oblachka.Views.HelpTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views">
  <!-- «Помощь» (облик 0.20): сначала беда, потом лекарство. Сверху — проверка сети Windows
       целиком; ниже симптомы, у каждого своё средство (QUIC через TCP, совместимость с играми,
       обход DPI, проверка сайта, локальный прокси, отчёт). Затем связь сейчас, «Для знающих»
       и события сессии. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,0,24,20">
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Ink}" Padding="18,16">
        <DockPanel>
          <Button x:Name="NetworkCheckButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnSun}" Padding="18,0" VerticalAlignment="Center"/>
          <v:CloudFace Margin="0,0,14,0" Mood="Wait" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Проверить сеть Windows целиком" FontSize="{StaticResource FsLead}" FontWeight="Bold" Foreground="{DynamicResource CloudWhite}" TextWrapping="Wrap"/>
            <TextBlock Text="DNS, маршруты, прокси и что оставили другие VPN" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource NightMu}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="SystemTunnelNote" Style="{StaticResource OptSub}" Margin="4,8,4,0"/>
      <Button x:Name="RestoreNetwork" Content="Восстановить сеть" Style="{StaticResource BtnOutline}" Height="36" Padding="16,0" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"/>

      <TextBlock Text="Что случилось?" Style="{StaticResource SecHead}"/>
      <UniformGrid Columns="2" Margin="0,4,-10,0">
        <Border Style="{StaticResource Symptom}" Background="{DynamicResource SkyTint}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Видео через VPN тормозит или рвётся" Style="{StaticResource SymptomQ}"/>
            <DockPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
              <CheckBox x:Name="QuicOverTcp" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="QUIC через TCP"/>
              <TextBlock Text="Браузеры перейдут с QUIC на обычный TCP" Style="{StaticResource SymptomFix}"/>
            </DockPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Symptom}" Background="{DynamicResource Lilac}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Игра раз в минуту теряет сервер" Style="{StaticResource SymptomQ}"/>
            <DockPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
              <CheckBox x:Name="CompatibleStack" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Совместимость с играми"/>
              <TextBlock Text="Туннель как в Throne: ровнее, но медленнее" Style="{StaticResource SymptomFix}"/>
            </DockPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Symptom}" Background="{DynamicResource Mint}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Провайдер режет подключение к VPN" Style="{StaticResource SymptomQ}"/>
            <StackPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
              <TextBlock x:Name="DpiNote" Text="Обход DPI: режем рукопожатие с сервером" Style="{StaticResource SymptomFix}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource SegTrack}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="DpiAuto" Content="Сам" Style="{StaticResource SegButton}" AutomationProperties.Name="Обход DPI: сам"/>
                  <Button x:Name="DpiAlways" Content="Всегда" Style="{StaticResource SegButton}" AutomationProperties.Name="Обход DPI: всегда"/>
                  <Button x:Name="DpiOff" Content="Нет" Style="{StaticResource SegButton}" AutomationProperties.Name="Обход DPI: выключен"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Symptom}" Background="{DynamicResource Cream}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Не открывается один сайт" Style="{StaticResource SymptomQ}"/>
            <DockPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
              <Button x:Name="SiteCheckOpenButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnPrimary}" Height="34" Padding="16,0" Margin="10,0,0,0"/>
              <TextBlock Text="Узнаем, кто мешает: провайдер, DPI или сам сайт" Style="{StaticResource SymptomFix}"/>
            </DockPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Symptom}" Background="{DynamicResource Peach}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Программа не видит VPN" Style="{StaticResource SymptomQ}"/>
            <DockPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
              <Button x:Name="CopyEndpointButton" DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource BtnOutline}" Height="34" Padding="14,0" Margin="10,0,0,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Укажите в ней прокси" Style="{StaticResource SymptomFix}"/>
                <TextBlock x:Name="EndpointText" Text="после подключения" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Tx}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Symptom}" Background="{DynamicResource Field}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Ничего не помогло" Style="{StaticResource SymptomQ}"/>
            <StackPanel VerticalAlignment="Bottom" Margin="0,10,0,0">
              <TextBlock Text="Отчёт для поддержки без ключей, адресов серверов и истории сайтов" Style="{StaticResource SymptomFix}" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="CopyReportButton" Content="Скопировать отчёт" Style="{StaticResource BtnPrimary}" Height="34" Padding="14,0"/>
                <Button x:Name="ExportButton" Content="В файл" Style="{StaticResource BtnOutline}" Height="34" Padding="14,0" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>
      </UniformGrid>

      <TextBlock Text="Связь сейчас" Style="{StaticResource SecHead}" Margin="0,8,0,4"/>
      <Border Style="{StaticResource OptRow}">
        <DockPanel>
          <TextBlock x:Name="CoreState" DockPanel.Dock="Right" Text="не запущено" Style="{StaticResource OptSub}" VerticalAlignment="Center"/>
          <Ellipse x:Name="CoreOk" Width="12" Height="12" Fill="{DynamicResource Ok}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="Ядро туннеля" Style="{StaticResource OptTitle}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource OptRow}">
        <DockPanel>
          <TextBlock x:Name="TunnelState" DockPanel.Dock="Right" Text="Не проверен" Style="{StaticResource OptSub}" VerticalAlignment="Center"/>
          <Ellipse x:Name="ProbeOk" Width="12" Height="12" Fill="{DynamicResource Ok}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="HTTPS-запрос через сервер" Style="{StaticResource OptTitle}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <WrapPanel Margin="0,10,0,0">
        <Button x:Name="ProbeButton" Content="Проверить связь" Style="{StaticResource BtnSecondary}" Height="34" Padding="14,0" Margin="0,0,8,8"/>
        <Button x:Name="FindRouteButton" Content="Найти рабочий сервер" Style="{StaticResource BtnSecondary}" Height="34" Padding="14,0" Margin="0,0,8,8"/>
        <Button x:Name="ReconnectButton" Content="Переподключить" Style="{StaticResource BtnSecondary}" Height="34" Padding="14,0" Margin="0,0,8,8"/>
      </WrapPanel>
      <!-- Сайт проверки: адрес по умолчанию, поле для опытных скрыто. -->
      <TextBox x:Name="ProbeUrl" Text="https://www.gstatic.com/generate_204" Visibility="Collapsed"/>
      <TextBlock x:Name="LastCheck" Style="{StaticResource OptSub}"/>
      <TextBlock x:Name="NetworkNote" Visibility="Collapsed"/>
      <TextBlock x:Name="Heading" Visibility="Collapsed"/>

      <Expander Margin="0,16,0,0" Foreground="{DynamicResource Mu}" FontSize="{StaticResource FsLabel}" Header="Для знающих" AutomationProperties.Name="Для знающих">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Куда пойдёт сайт?" Style="{StaticResource OptTitle}"/>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="WhereResult" DockPanel.Dock="Right" FontSize="{StaticResource FsBody}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="WhereInput" Style="{StaticResource FieldBox}" Height="34" Tag="music.youtube.com" FontSize="{StaticResource FsBody}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Проверить, куда пойдёт сайт"/>
          </DockPanel>
          <!-- Базы адресов скачиваются сами, проверка правил — для разработки: на экране их нет. -->
          <StackPanel Visibility="Collapsed">
            <Button x:Name="GeoButton" Content="Скачать"/>
            <TextBlock x:Name="GeoStatus"/>
            <Button x:Name="ValidateRulesButton" Content="Проверить правила"/>
          </StackPanel>
        </StackPanel>
      </Expander>
      <Button x:Name="VmTunButton" Content="Проверить TUN в виртуалке" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,6,0,0"/>
      <TextBlock x:Name="VmTunNote" Visibility="Collapsed"/>

      <TextBlock Text="События сессии" Style="{StaticResource SecHead}"/>
      <TextBlock x:Name="EventText" Visibility="Collapsed"/>
      <ItemsControl x:Name="EventList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,6">
              <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" Width="40" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Fa}"/>
              <TextBlock Text="{Binding Message}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
