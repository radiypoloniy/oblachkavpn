<UserControl x:Class="Oblachka.Views.HelpTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Помощь (0.16): проверка связи, «Не открывается сайт?», сеть Windows, отчёт,
       события сессии. Обновления — в «Приложении». -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,0,20,16">
      <TextBlock Text="СВЯЗЬ" Style="{StaticResource SetCaption}" Margin="8,4,8,6"/>
      <Border Style="{StaticResource SetGroup}" Padding="14,6,14,12">
        <StackPanel>
          <DockPanel Height="38">
            <Ellipse x:Name="CoreOk" Width="18" Height="18" Fill="{DynamicResource Ok}" Margin="0,0,10,0"/>
            <TextBlock x:Name="CoreState" DockPanel.Dock="Right" Text="не запущено" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center" FontSize="{StaticResource FsLabel}"/>
            <TextBlock Text="Ядро туннеля" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Height="38">
            <Ellipse x:Name="ProbeOk" Width="18" Height="18" Fill="{DynamicResource Ok}" Margin="0,0,10,0"/>
            <TextBlock x:Name="TunnelState" DockPanel.Dock="Right" Text="Не проверен" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center" FontSize="{StaticResource FsLabel}"/>
            <TextBlock Text="HTTPS-запрос через сервер" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ProbeButton" Content="Проверить" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}"/>
            <Button x:Name="FindRouteButton" Grid.Column="2" Content="Найти сервер" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}"/>
            <Button x:Name="ReconnectButton" Grid.Column="4" Content="Переподключить" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}"/>
          </Grid>
          <!-- Сайт проверки: адрес по умолчанию, поле для опытных скрыто. -->
          <TextBox x:Name="ProbeUrl" Text="https://www.gstatic.com/generate_204" Visibility="Collapsed"/>
          <TextBlock x:Name="LastCheck" Style="{StaticResource Small}" Margin="2,8,0,0"/>
          <TextBlock x:Name="NetworkNote" Visibility="Collapsed"/>
          <TextBlock x:Name="Heading" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <TextBlock Text="ЕСЛИ ЧТО-ТО НЕ ТАК" Style="{StaticResource SetCaption}"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <!-- «Почему не открывается сайт?» (SiteProbe, SiteVerdict). -->
          <DockPanel Style="{StaticResource SetLine}">
            <Button x:Name="SiteCheckOpenButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcOrange}"><Path Data="{StaticResource IcoSearch}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Не открывается сайт?" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Узнаем, кто мешает — провайдер, DPI или сам сайт — и починим в один клик" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
          <!-- Поломки, которые оставляют упавшие VPN и обходы блокировок (NetworkDoctor). -->
          <DockPanel Style="{StaticResource SetLine}">
            <Button x:Name="NetworkCheckButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcBlue}"><Path Data="{StaticResource IcoGlobe}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Сеть Windows" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Интернет пропал после Throne, zapret или другого VPN? Найдём, что они оставили" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
          <StackPanel Margin="12,8,12,10">
            <DockPanel>
              <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGray}"><Path Data="{StaticResource IcoFile}" Style="{StaticResource SetGlyph}"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Сообщить о проблеме" Style="{StaticResource SetTitle}"/>
                <TextBlock Text="Отчёт для поддержки: настройки, программы в сети и проверки обхода. Без ключей, адресов серверов и истории сайтов" Style="{StaticResource SetSub}" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            <Grid Margin="40,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="CopyReportButton" Content="Скопировать" Style="{StaticResource BtnPrimary}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}"/>
              <Button x:Name="ExportButton" Grid.Column="2" Content="Сохранить файл" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusMd}"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
      <Button x:Name="VmTunButton" Content="Проверить TUN в виртуалке" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,6,0,0"/>
      <TextBlock x:Name="VmTunNote" Visibility="Collapsed"/>

      <TextBlock Text="СОБЫТИЯ СЕССИИ" Style="{StaticResource SetCaption}"/>
      <TextBlock x:Name="EventText" Visibility="Collapsed"/>
      <ItemsControl x:Name="EventList" Margin="8,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,6">
              <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" Width="38" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Fa}"/>
              <TextBlock Text="{Binding Message}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
