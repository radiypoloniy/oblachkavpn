<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Oblachka.Views.TrayPopup" Title="Облачка — подключение" Width="430" Height="366" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#18243A">
  <Border Style="{StaticResource Card}" BorderBrush="#CAD2DF" Padding="22" Margin="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <Button x:Name="PowerButton" DockPanel.Dock="Right" Style="{StaticResource Power}" HorizontalContentAlignment="Left" Foreground="#8A96A8" ToolTip="Включить">
          <Button.LayoutTransform>
            <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
          </Button.LayoutTransform>
        </Button>
        <StackPanel>
          <TextBlock x:Name="StateText" Text="Не подключено" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="CheckText" Text="Туннель не проверен" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,20,0,14">
        <Border Background="#F5F6F9" CornerRadius="16" Padding="16">
          <StackPanel>
            <TextBlock x:Name="ProfileText" Text="Нет профиля" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TransportText" Text="Подписка, ключ или файл" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0"/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
              <TextBlock Text="Только SOCKS5" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Border>
        <TextBlock x:Name="SessionText" Text="Туннель выключен" Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0"/>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="OpenButton" Content="Открыть окно"/>
        <Button x:Name="ExitButton" Grid.Column="2" Content="Выйти"/>
      </Grid>
    </Grid>
  </Border>
</Window>
