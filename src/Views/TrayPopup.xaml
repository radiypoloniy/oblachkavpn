<Window x:Class="Oblachka.Views.TrayPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views" Title="Облачка" Width="352" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}">
  <!-- Меню в трее в облике 0.20: та же «погодная» карточка статуса, что в боковой колонке,
       быстрая смена сервера строками «Серверов», открыть окно и выйти. -->
  <Window.Resources>
    <DataTemplate DataType="{x:Type o:ServerRow}">
      <Button x:Name="Row" Style="{StaticResource Row}" Height="42" o:Ui.CornerRadius="{StaticResource RadiusMd}" Padding="10,0" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}">
        <DockPanel>
          <Grid Width="22" Height="22" Margin="0,0,12,0">
            <Ellipse Visibility="{Binding FlagVisibility}" Stroke="{DynamicResource FlagRing}" StrokeThickness="1">
              <Ellipse.Fill><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Ellipse.Fill>
            </Ellipse>
            <Border x:Name="IconPlate" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Field}" Visibility="{Binding IconVisibility}">
              <Path x:Name="IconGlyph" Data="{Binding Icon}" Width="11" Height="11" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" Stroke="{DynamicResource Mu}"/>
            </Border>
          </Grid>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" FontSize="{StaticResource FsNote}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <v:PixelBars DockPanel.Dock="Right" Kind="Steps" Width="20" Height="9" VerticalAlignment="Center" Filled="{Binding PingSteps}" Fill="{Binding LatencyDot}" Empty="{DynamicResource Pixel}"
                       Visibility="{Binding LatencyVisibility}"/>
          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsLabel}" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Lilac}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconOnAccent}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Sun}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="{x:Null}"/>
          <Setter TargetName="IconGlyph" Property="Fill" Value="{DynamicResource Orb}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="10">
    <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusIsland}"/>
    <Border CornerRadius="{StaticResource RadiusIsland}" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" Padding="10,10,10,12">
      <DockPanel>
        <Border x:Name="StatusCard" DockPanel.Dock="Top" CornerRadius="{StaticResource RadiusSky}" Background="{DynamicResource Night}" Padding="14,14,12,14">
          <DockPanel>
            <v:PowerSwitch x:Name="Power" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            <v:CloudFace x:Name="Face" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="StateText" Text="Выключено" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsDisplayStatus}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="SubText" FontSize="{StaticResource FsNote}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid DockPanel.Dock="Bottom" Margin="4,10,4,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="OpenButton" Content="Открыть окно" Style="{StaticResource BtnPrimary}" Height="40"/>
          <!-- Выход останавливает VPN — тихая кнопка с цветом опасного действия. -->
          <Button x:Name="ExitButton" Grid.Column="2" Content="Выйти" Style="{StaticResource Plain}" Height="40" Padding="18,0" o:Ui.CornerRadius="{StaticResource RadiusLg}" FontWeight="SemiBold" Foreground="{DynamicResource RF}" Tag="{DynamicResource OverlayDanger}"/>
        </Grid>
        <Border CornerRadius="{StaticResource RadiusSheet}" Background="{DynamicResource Bg}" Margin="0,10,0,0" Padding="8,10,8,8">
          <StackPanel>
            <TextBlock Text="Быстрая смена" FontSize="{StaticResource FsNote}" FontWeight="Bold" Foreground="{DynamicResource Mu}" Margin="10,0,0,6"/>
            <ItemsControl x:Name="QuickList" Focusable="False"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</Window>
