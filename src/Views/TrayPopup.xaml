<Window x:Class="Oblachka.Views.TrayPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:o="clr-namespace:Oblachka" Title="Облачка" Width="372" Height="476" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}">
  <!-- Меню в трее (экран 14): статус и тумблер, быстрая смена сервера, открыть окно, выйти. -->
  <Window.Resources>
    <DataTemplate DataType="{x:Type o:ServerRow}">
      <Button x:Name="Row" Style="{StaticResource Row}" Height="46" o:Ui.CornerRadius="10" Padding="10,0" Margin="0,0,0,2" AutomationProperties.Name="{Binding Name}">
        <DockPanel>
          <Grid Width="22" Height="22" Margin="0,0,10,0">
            <Ellipse Visibility="{Binding FlagVisibility}" Stroke="#40808CA0" StrokeThickness="1">
              <Ellipse.Fill><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Ellipse.Fill>
            </Ellipse>
            <Border x:Name="IconPlate" CornerRadius="11" Background="{DynamicResource Aci}" Visibility="{Binding IconVisibility}">
              <Path x:Name="IconGlyph" Data="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="2" StrokeLineJoin="Round" Stroke="{DynamicResource Ac}"/>
            </Border>
          </Grid>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" FontSize="12" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Acs}"/>
          <Setter TargetName="Row" Property="Tag" Value="{DynamicResource Hovs}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconOnAccent}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Ac}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="White"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="10">
  <Border Style="{StaticResource ShadowLayer}" CornerRadius="16"/>
  <Border CornerRadius="16" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" Padding="18,22,18,18">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="4,0">
        <Button x:Name="PowerButton" DockPanel.Dock="Right" Style="{StaticResource Plain}" Width="68" Height="38" o:Ui.CornerRadius="19" Background="{DynamicResource Off}" AutomationProperties.Name="Включить">
          <Grid Width="68" Height="38">
            <Ellipse x:Name="Knob" Width="30" Height="30" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
              <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25"/></Ellipse.Effect>
            </Ellipse>
          </Grid>
        </Button>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StateText" Text="Не подключено" FontSize="18" FontWeight="Bold"/>
          <TextBlock x:Name="SubText" FontSize="12.5" Foreground="{DynamicResource Mu}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
      <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="OpenButton" Content="Открыть окно" Style="{StaticResource BtnSecondary}" Height="38" o:Ui.CornerRadius="10" FontSize="13"/>
        <Button x:Name="ExitButton" Grid.Column="2" Content="Выйти" Style="{StaticResource BtnSecondary}" Height="38" o:Ui.CornerRadius="10" Padding="16,0" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource Mu}"/>
      </Grid>
      <StackPanel>
        <TextBlock Text="БЫСТРАЯ СМЕНА" Style="{StaticResource Caption}" FontSize="11.5" Margin="6,20,6,8"/>
        <ItemsControl x:Name="QuickList" Focusable="False"/>
      </StackPanel>
    </DockPanel>
  </Border>
  </Grid>
</Window>
