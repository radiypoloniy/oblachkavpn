<UserControl x:Class="Oblachka.Views.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Oblachka.Views" xmlns:o="clr-namespace:Oblachka"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Страницы острова (облик 0.20): «Приложение», «Помощь», «Обход блокировок», «Подписки и
       ключ», «Серверы автовыбора». Разделы выбираются в боковой колонке, поэтому списка разделов
       здесь нет: заголовок страницы и «Назад». -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="10,0,24,0">
      <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock x:Name="PageTitle" Text="Приложение" Style="{StaticResource PageHead}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>

    <Grid Grid.Row="1" x:Name="Pages">
      <v:GeneralTab x:Name="General"/>
      <v:BypassPage x:Name="Bypass" Visibility="Collapsed"/>
      <v:SubscriptionTab x:Name="Subscription" Visibility="Collapsed"/>
      <v:HelpTab x:Name="Help" Visibility="Collapsed"/>
      <v:AutoPoolPage x:Name="AutoPool" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</UserControl>
