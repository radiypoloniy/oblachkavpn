<UserControl x:Class="Oblachka.Views.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Oblachka.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Настройки (экраны 10–13): одно окно, сегментированные вкладки. -->
  <UserControl.Resources>
    <Style x:Key="SegItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Seg" CornerRadius="8" Background="Transparent" Margin="1,0">
              <TextBlock x:Name="Label" Text="{Binding}" FontSize="13" Foreground="{DynamicResource Mu}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Seg" Property="Background" Value="{DynamicResource Seg}"/>
                <Setter TargetName="Seg" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.14"/></Setter.Value></Setter>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Tx}"/>
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="6,0,90,0">
      <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Настройки" Style="{StaticResource Brand}" Margin="4,0,0,0"/>
    </DockPanel>

    <Border Grid.Row="1" Margin="14,0" Height="38" CornerRadius="11" Background="{DynamicResource Field}" Padding="3">
      <ListBox x:Name="SettingsTabs" ItemContainerStyle="{StaticResource SegItem}" Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Разделы настроек">
        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <sys:String>Основное</sys:String>
        <sys:String>Правила</sys:String>
        <sys:String>Подписка</sys:String>
        <sys:String>Помощь</sys:String>
      </ListBox>
    </Border>

    <Grid Grid.Row="2" x:Name="Pages">
      <v:GeneralTab x:Name="General"/>
      <v:RulesTab x:Name="Rules" Visibility="Collapsed"/>
      <v:SubscriptionTab x:Name="Subscription" Visibility="Collapsed"/>
      <v:HelpTab x:Name="Help" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</UserControl>
