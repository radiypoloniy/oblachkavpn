<UserControl x:Class="Oblachka.Views.AppPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- «Правила → Программы → Выбрать программы»: список программ компьютера с поиском по имени,
       несколько сразу, одно действие для выбранных. Поверх настроек, как «Все серверы». -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type v:AppRow}">
      <Button x:Name="RowButton" Style="{StaticResource Row}" Height="54" Margin="0,0,0,2" Padding="10,0,12,0" AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource Field}" Visibility="{Binding PlaceholderVisibility}">
            <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsRowLarge}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Note}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Grid Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center">
            <Ellipse x:Name="MarkRing" Stroke="{DynamicResource Ring}" StrokeThickness="1.5"/>
            <Ellipse x:Name="MarkFill" Fill="{DynamicResource Ac}" Visibility="Collapsed"/>
            <Path x:Name="MarkCheck" Data="{StaticResource IcoCheck}" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource OnAccent}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Checked}" Value="True">
          <Setter TargetName="RowButton" Property="Background" Value="{DynamicResource Acs}"/>
          <Setter TargetName="MarkRing" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="MarkFill" Property="Visibility" Value="Visible"/>
          <Setter TargetName="MarkCheck" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Added}" Value="True">
          <Setter TargetName="RowButton" Property="IsEnabled" Value="False"/>
          <Setter TargetName="MarkRing" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="10,0,96,0">
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Выбор программ" Style="{StaticResource Brand}" Margin="4,0,0,0"/>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="20,0,20,8">
      <TextBox x:Name="SearchBox" Style="{StaticResource FieldBox}" Height="42" Tag="Название, например «тел» или «steam»" FontSize="{StaticResource FsRow}"
               AutomationProperties.Name="Найти программу"/>
      <TextBlock x:Name="ModeNote" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" Margin="2,8,0,0"
                 Text="Правила программ действуют в режиме «Весь компьютер». В режиме «Браузеры и программы» трафик программ, которые не смотрят на системный прокси, к нам не попадает."/>
    </StackPanel>

    <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,0">
        <ItemsControl x:Name="AppList" Focusable="False"/>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Text="Ищем программы на компьютере…" FontSize="{StaticResource FsLabel}" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="32,0"/>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
      <StackPanel>
        <TextBlock Text="Что делать с выбранными" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" Margin="2,0,0,6"/>
        <ListBox x:Name="ActionChoice" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Действие для выбранных программ" SelectedIndex="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          <sys:String>Через VPN</sys:String>
          <sys:String>Напрямую</sys:String>
          <sys:String>Блокировать</sys:String>
        </ListBox>
        <DockPanel Margin="0,12,0,0">
          <Button x:Name="FileButton" Content="Выбрать файл…" Style="{StaticResource BtnLink}" VerticalAlignment="Center"/>
          <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource BtnPrimary}" Height="44" Padding="20,0" o:Ui.CornerRadius="{StaticResource RadiusLg}"
                  HorizontalAlignment="Right" IsEnabled="False"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
