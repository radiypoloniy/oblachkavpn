<UserControl x:Class="Oblachka.Views.GeneralTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки целиком (редизайн 0.14): аккаунт, «Без VPN», «Серверы», «Приложение» и двери
       в подробные страницы. Всё, что решается само, сюда не выносится («Для продвинутых»). -->
  <UserControl.Resources>
    <Style x:Key="NavRow" TargetType="Button" BasedOn="{StaticResource Row}">
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="12,8,10,8"/>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsRow}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FsBody}"/>
      <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0,6,0"/>
    </Style>
    <Style x:Key="Chevron" TargetType="Path">
      <Setter Property="Data" Value="{StaticResource IcoChevronRight}"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource Fa}"/>
      <Setter Property="StrokeThickness" Value="2.2"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,6,20,16">
      <!-- Аккаунт: срок и трафик подписки сервиса; «Продлить» — если сервис прислал ссылку. -->
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Acs}" Padding="14,12">
        <DockPanel>
          <Button x:Name="AccountRenew" DockPanel.Dock="Right" Content="Продлить" Style="{StaticResource BtnPrimary}" Height="34" Padding="14,0" o:Ui.CornerRadius="{StaticResource RadiusMd}"
                  FontSize="{StaticResource FsBody}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="AccountTitle" Text="Подписка" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="AccountSub" Style="{StaticResource Small}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="БЕЗ VPN" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,20,6,6"/>
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <DockPanel Margin="12,10,10,10">
            <CheckBox x:Name="RussiaDirect" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Российские сайты напрямую"/>
            <StackPanel>
              <TextBlock Text="Российские сайты" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="Госуслуги, банки и почти весь рунет" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Button x:Name="OpenZapret" Style="{StaticResource NavRow}" AutomationProperties.Name="YouTube и Discord без VPN">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
              <StackPanel>
                <TextBlock Text="YouTube и Discord" Style="{StaticResource RowTitle}"/>
                <TextBlock x:Name="ZapretSummary" Text="Выключено" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="OpenRules" Style="{StaticResource NavRow}" AutomationProperties.Name="Свои правила">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
              <TextBlock x:Name="RulesSummary" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Свои правила" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>

      <TextBlock Text="СЕРВЕРЫ" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,20,6,6"/>
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <Button x:Name="OpenAutoPool" Style="{StaticResource NavRow}" AutomationProperties.Name="Серверы автовыбора">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
              <TextBlock x:Name="AutoPoolSummary" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Автовыбор" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <DockPanel Margin="12,10,10,10">
            <CheckBox x:Name="AutoRecover" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Переключать сервер при обрыве"/>
            <StackPanel>
              <TextBlock Text="Сервер упал — переключить" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="Проверяем связь и находим рабочий сервер" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,20,6,6"/>
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <DockPanel Margin="12,12,10,12">
            <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Запускать вместе с Windows"/>
            <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="12,0,10,12">
            <CheckBox x:Name="ConnectOnLaunch" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Подключаться при запуске"/>
            <StackPanel>
              <TextBlock Text="Подключаться при запуске" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="Если VPN был включён, когда вы выключили компьютер или закрыли Облачку" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="12,8,8,8">
            <Border DockPanel.Dock="Right" Height="32" CornerRadius="{StaticResource RadiusSeg}" Background="{DynamicResource Field}" Padding="3">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ThemeSystem" Content="Как в Windows" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
                <Button x:Name="ThemeLight" Content="Светлая" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}" Margin="2,0"/>
                <Button x:Name="ThemeDark" Content="Тёмная" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Тема" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <Button x:Name="OpenVersion" Style="{StaticResource NavRow}" AutomationProperties.Name="Версия и обновления">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
              <TextBlock x:Name="VersionSummary" DockPanel.Dock="Right" Style="{StaticResource RowValue}" Text="обновляется сама"/>
              <TextBlock x:Name="VersionTitle" Text="Версия" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Group}" Margin="0,16,0,0">
        <StackPanel>
          <Button x:Name="OpenSubscription" Style="{StaticResource NavRow}" AutomationProperties.Name="Подписки и ключ">
            <DockPanel><Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/><TextBlock Text="Подписки и ключ" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Button x:Name="OpenHelp" Style="{StaticResource NavRow}" AutomationProperties.Name="Помощь">
            <DockPanel><Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/><TextBlock Text="Помощь и проверка" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/></DockPanel>
          </Button>
          <Button x:Name="OpenAdvanced" Style="{StaticResource NavRow}" AutomationProperties.Name="Для продвинутых">
            <DockPanel><Path DockPanel.Dock="Right" Style="{StaticResource Chevron}"/><TextBlock Text="Для продвинутых" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/></DockPanel>
          </Button>
        </StackPanel>
      </Border>
      <!-- Выбор режима хранится в этих флажках: от них зависит вся логика подключения.
           Сам режим переключается внизу главного экрана и в «Для продвинутых». -->
      <CheckBox x:Name="SystemTunnel" Visibility="Collapsed"/>
      <CheckBox x:Name="SystemProxy" Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
