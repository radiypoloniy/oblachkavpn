<UserControl x:Class="Oblachka.Views.GeneralTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Приложение (0.16): тема, трей, живое небо, обновления и версия. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,0,20,16">
      <TextBlock Text="ВИД" Style="{StaticResource SetCaption}" Margin="8,4,8,6"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <Border DockPanel.Dock="Right" Height="32" CornerRadius="{StaticResource RadiusSeg}" Background="{DynamicResource Field}" Padding="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ThemeSystem" Content="Как в Windows" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
                <Button x:Name="ThemeLight" Content="Светлая" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}" Margin="2,0"/>
                <Button x:Name="ThemeDark" Content="Тёмная" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcPurple}"><Path Data="{StaticResource IcoMoon}" Style="{StaticResource SetGlyph}"/></Border>
            <TextBlock Text="Тема" Style="{StaticResource SetTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="SkyToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Живое небо"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcBlue}"><Path Data="{StaticResource IcoCloud}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Живое небо" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Облака плывут, звёзды мерцают. Выключите — останется картинка текущего часа" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="StayInTray" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Крестик сворачивает в трей"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGray}"><Path Data="{StaticResource IcoTray}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Крестик сворачивает в трей" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="VPN продолжает работать, Облачка — у часов" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Обновление без переустановки (AppUpdate): релизы GitHub, установщик по нажатию. -->
      <TextBlock Text="ОБНОВЛЕНИЯ" Style="{StaticResource SetCaption}"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="{StaticResource RadiusSeg}" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGreen}"><Path Data="{StaticResource IcoRefresh}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="UpdateTitle" Text="Обновления" Style="{StaticResource SetTitle}"/>
              <TextBlock x:Name="UpdateText" Text="Проверим, нет ли новой версии" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource SetLine}" Margin="52,4,12,4">
            <CheckBox x:Name="UpdateAuto" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Проверять обновления сами"/>
            <TextBlock Text="Проверять сами раз в 12 часов" Style="{StaticResource SetTitle}" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource SetLine}" Margin="52,4,12,8">
            <CheckBox x:Name="UpdatePrerelease" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Получать пробные версии"/>
            <TextBlock Text="Получать пробные версии" Style="{StaticResource SetTitle}" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="VersionText" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Fa}" HorizontalAlignment="Center" Margin="0,14,0,0"/>

      <!-- Выбор режима хранится в этих флажках: от них зависит вся логика подключения.
           Сам режим переключается в «Подключении». -->
      <CheckBox x:Name="SystemTunnel" Visibility="Collapsed"/>
      <CheckBox x:Name="SystemProxy" Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
