<UserControl x:Class="Oblachka.Views.GeneralTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- «Приложение» (облик 0.20): только сама программа — запуск, вид, обновления, перенос
       настроек. Всё про сеть — в «Программах и сайтах», «Серверах» и «Помощи». -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,0,24,20">
      <!-- Запуск слева, вид справа; обновления и перенос — на всю ширину (макет «Приложение»). -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
        <TextBlock Text="Запуск" Style="{StaticResource SecHead}" Margin="0,0,0,4"/>
        <Border Style="{StaticResource OptRow}">
          <DockPanel>
            <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Запускать вместе с Windows"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Вместе с Windows" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="В трее, без окна" Style="{StaticResource OptSub}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource OptRow}">
          <DockPanel>
            <CheckBox x:Name="ConnectOnLaunch" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Подключаться при запуске"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Сразу подключаться" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="Если VPN был включён, когда вы выключили компьютер или закрыли Облачку" Style="{StaticResource OptSub}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource OptRow}">
          <DockPanel>
            <CheckBox x:Name="StayInTray" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Крестик сворачивает в трей"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Крестик прячет в трей" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="VPN продолжает работать, Облачка — у часов" Style="{StaticResource OptSub}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource OptRow}" BorderThickness="0">
          <DockPanel>
            <CheckBox x:Name="Hotkey" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Ctrl+Alt+O показывает окно"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Ctrl+Alt+O" Style="{StaticResource OptTitle}"/>
              <TextBlock x:Name="HotkeyNote" Text="Показать окно из любой программы; ещё раз — спрятать в трей" Style="{StaticResource OptSub}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Вид" Style="{StaticResource SecHead}" Margin="0,0,0,8"/>
          <UniformGrid Columns="3">
            <Button x:Name="ThemeLight" Style="{StaticResource ThemeTile}" AutomationProperties.Name="Светлая тема">
              <StackPanel>
                <Border Height="44" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource CloudWhite}" Padding="5">
                  <DockPanel><Border Width="20" CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource Sun}" Margin="0,0,5,0"/><Border CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource NightInk}"/></DockPanel>
                </Border>
                <TextBlock Text="Светлая" Margin="2,8,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="ThemeDark" Style="{StaticResource ThemeTile}" AutomationProperties.Name="Тёмная тема">
              <StackPanel>
                <Border Height="44" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource Night}" Padding="5">
                  <DockPanel><Border Width="20" CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource Sun}" Margin="0,0,5,0"/><Border CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource NightCloud}"/></DockPanel>
                </Border>
                <TextBlock Text="Тёмная" Margin="2,8,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="ThemeSystem" Style="{StaticResource ThemeTile}" AutomationProperties.Name="Тема как в Windows">
              <StackPanel>
                <Border Height="44" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource NightInk}" Padding="5">
                  <UniformGrid Columns="2"><Border CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource CloudWhite}" Margin="0,0,3,0"/><Border CornerRadius="{StaticResource RadiusXs}" Background="{DynamicResource Night}" Margin="3,0,0,0"/></UniformGrid>
                </Border>
                <TextBlock Text="Системная" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="Как в Windows"/>
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
      </Grid>

      <!-- Обновление без переустановки (AppUpdate): релизы GitHub, установщик по нажатию. -->
      <TextBlock Text="Обновления" Style="{StaticResource SecHead}"/>
      <Border Style="{StaticResource Plate}">
        <StackPanel>
          <DockPanel>
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnPrimary}" Height="36" Padding="16,0" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="UpdateTitle" Text="Обновления" Style="{StaticResource OptTitle}"/>
              <TextBlock x:Name="UpdateText" Text="Проверим, нет ли новой версии" Style="{StaticResource OptSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <CheckBox x:Name="UpdateAuto" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Проверять обновления сами"/>
            <TextBlock Text="Проверять сами раз в 12 часов" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <CheckBox x:Name="UpdatePrerelease" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Получать пробные версии"/>
            <TextBlock Text="Получать пробные версии" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Резервная копия настроек (ClientBackup): переезд на другой компьютер, переустановка. -->
      <TextBlock Text="Перенос на другой компьютер" Style="{StaticResource SecHead}"/>
      <Border Style="{StaticResource Plate}">
        <DockPanel>
          <Button x:Name="BackupRestore" DockPanel.Dock="Right" Style="{StaticResource BtnOutline}" Height="36" Padding="12,0,16,0" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Восстановить из файла">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoUpload}" Style="{StaticResource Icon}" Width="15" Height="15" StrokeThickness="2.2" Margin="0,0,8,0"/><TextBlock Text="Из файла" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="BackupSave" DockPanel.Dock="Right" Style="{StaticResource BtnOutline}" Height="36" Padding="12,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Сохранить настройки в файл">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoTray}" Style="{StaticResource Icon}" Width="15" Height="15" StrokeThickness="2.2" Margin="0,0,8,0"/><TextBlock Text="В файл" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Подписки, серверы и правила" Style="{StaticResource OptTitle}"/>
            <TextBlock Text="В файле ваши ключи — никому его не пересылайте" Style="{StaticResource OptSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="VersionText" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Fa}" HorizontalAlignment="Center" Margin="0,16,0,0"/>

      <!-- Выбор режима хранится в этих флажках: от них зависит вся логика подключения.
           Сам режим переключается в «Программах и сайтах». -->
      <CheckBox x:Name="SystemTunnel" Visibility="Collapsed"/>
      <CheckBox x:Name="SystemProxy" Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
