<UserControl x:Class="Oblachka.Views.SettingsHub" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views">
  <UserControl.Resources>
    <Style x:Key="Topic" TargetType="Button" BasedOn="{StaticResource Row}">
      <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusLg}"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="12,11"/>
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="MinHeight" Value="62"/>
    </Style>
    <DataTemplate x:Key="TopicContent">
      <DockPanel>
        <Path DockPanel.Dock="Right" Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="10" Height="12" Margin="8,0,0,0"/>
        <Border Visibility="Visible">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource SetIcon}">
              <Setter Property="Background" Value="{DynamicResource Acs}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IconKey}" Value="IcoShield"><Setter Property="Background" Value="{DynamicResource Clear}"/></DataTrigger>
                <DataTrigger Binding="{Binding IconKey}" Value="IcoRefresh"><Setter Property="Background" Value="{DynamicResource Cream}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Path Data="{Binding Icon}" Style="{StaticResource SetGlyph}" Stroke="{DynamicResource Tx}"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Style="{StaticResource OptTitle}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource OptSub}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,0,14,18">
      <Border Background="{DynamicResource Clear}" CornerRadius="{StaticResource RadiusXl}" Padding="14" Margin="0,0,6,14">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <v:CloudFace x:Name="LaunchCloud" Width="42" Height="32" VerticalAlignment="Top" Margin="0,1,12,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Что происходит при запуске?" Style="{StaticResource OptTitle}" TextWrapping="Wrap"/>
            <TextBlock x:Name="LaunchSummary" Style="{StaticResource OptSub}" TextWrapping="Wrap" Foreground="{DynamicResource ClearMu}" Margin="0,4,0,0"/>
            <Button x:Name="LaunchOpen" Content="Настроить запуск" Style="{StaticResource BtnPrimary}" Height="32" Padding="12,0"
                    HorizontalAlignment="Left" Margin="0,10,0,0" Background="{DynamicResource Sun}" Foreground="{DynamicResource Orb}"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Text="Что хотите настроить?" Style="{StaticResource SecHead}" Margin="0,0,0,8"/>
      <UniformGrid x:Name="Topics" Columns="1">
        <Button x:Name="NetworkOpen" Style="{StaticResource Topic}" ContentTemplate="{StaticResource TopicContent}"/>
        <Button x:Name="AppearanceOpen" Style="{StaticResource Topic}" ContentTemplate="{StaticResource TopicContent}"/>
        <Button x:Name="SubscriptionOpen" Style="{StaticResource Topic}" ContentTemplate="{StaticResource TopicContent}"/>
        <Button x:Name="TransferOpen" Style="{StaticResource Topic}" ContentTemplate="{StaticResource TopicContent}"/>
      </UniformGrid>
      <Button x:Name="AdvancedOpen" Style="{StaticResource Topic}" ContentTemplate="{StaticResource TopicContent}" Margin="0,5,6,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
