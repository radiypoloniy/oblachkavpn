<UserControl x:Class="Oblachka.Views.AddMenu" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}">
  <!-- «Добавить сервер»: поле для ссылки сразу под рукой, остальные способы — строками ниже.
       Всплывает у ключа в шапке «Серверов» и у «Добавить» под списком. -->
  <Grid Width="360" Margin="12,6,12,18">
    <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
    <Border Style="{StaticResource MenuCard}" Padding="16,14,16,10">
      <StackPanel>
        <TextBlock Text="Добавить сервер" FontSize="{StaticResource FsLead}" FontWeight="Bold"/>
        <TextBlock Text="Ссылка vless://, ss://, trojan://, hy2://, ссылка подписки https:// или текст конфигурации." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <TextBox x:Name="KeyInput" Style="{StaticResource FieldBox}" Height="64" Padding="12,8" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="{StaticResource FsBody}" Tag="Вставьте сюда ссылку" AutomationProperties.Name="Ссылка или ключ"/>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="AddKeyButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Добавить" Padding="20,0" Height="36" IsEnabled="False"/>
          <Button x:Name="PasteButton" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Padding="0" Content="Вставить из буфера"/>
        </DockPanel>
        <Border Height="1.5" Background="{DynamicResource Divider}" Margin="-16,12,-16,6"/>
        <Button x:Name="ImportFileButton" Style="{StaticResource MenuRow}" AutomationProperties.Name="Открыть файл">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IcoFile}" Style="{StaticResource Icon}" Width="16" Height="16" StrokeThickness="2"/>
            <TextBlock Text="Открыть файл" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="JSON, txt, conf" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ScanButton" Style="{StaticResource MenuRow}" AutomationProperties.Name="QR-код на экране">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IcoQr}" Style="{StaticResource Icon}" Width="16" Height="16" StrokeThickness="2"/>
            <TextBlock Text="Найти QR-код на экране" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="SubscriptionButton" Style="{StaticResource MenuRow}" AutomationProperties.Name="Подписки и ключ">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IcoKey}" Style="{StaticResource Icon}" Width="16" Height="16" StrokeThickness="2"/>
            <TextBlock Text="Подписки и ключ" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="обновить, убрать, сменить" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
