<UserControl x:Class="Oblachka.Views.AutoPoolPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Пул «Автовыбора» (AutoPool): строки — серверы, переключатель — участвует ли. -->
  <DockPanel Margin="20,6,20,16">
      <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
        <Button x:Name="AutoPoolMeasure" DockPanel.Dock="Right" Content="Обновить пинг" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="{StaticResource RadiusSm}" FontSize="{StaticResource FsBody}" VerticalAlignment="Top"/>
        <TextBlock x:Name="AutoPoolNote" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,10,0"
                   Text="Автовыбор берёт самый быстрый из отмеченных серверов и на них переключается при обрыве. Пинг — задержка через сам сервер. Обход белых списков по умолчанию выключен: эти серверы нужны для своей задачи."/>
      </DockPanel>
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource CardBg}" Padding="2" VerticalAlignment="Top">
        <o:AccessibleItems x:Name="AutoPoolList" Focusable="False"
                           VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
          <o:AccessibleItems.ItemTemplate><DataTemplate>
            <DockPanel Margin="12,7,6,7">
              <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Included, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}"/>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsRow}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Note}" Style="{StaticResource Small}" Visibility="{Binding NoteVisibility}"/>
              </StackPanel>
            </DockPanel>
          </DataTemplate></o:AccessibleItems.ItemTemplate>
          <o:AccessibleItems.Template><ControlTemplate TargetType="o:AccessibleItems">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
          </ControlTemplate></o:AccessibleItems.Template>
          <o:AccessibleItems.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></o:AccessibleItems.ItemsPanel>
        </o:AccessibleItems>
      </Border>
  </DockPanel>
</UserControl>
