<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RoutePilot.Views" x:Class="RoutePilot.Views.ServersView">
  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Серверы" Style="{StaticResource PageTitle}"/>
        <TextBox x:Name="SearchBox" Tag="Найти сервер" Height="40" ToolTip="Поиск по названию сервера или стране" AutomationProperties.Name="Поиск серверов" Margin="0,0,0,12"/>
      </StackPanel>
      <ListBox x:Name="ProfilePicker" Grid.Row="1" AutomationProperties.Name="Список подключений">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid MinHeight="32">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <local:CountryFlag Code="{Binding Country.Code}" Width="28" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="2" Background="#F5F6F8" CornerRadius="16" Padding="16" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock x:Name="SubscriptionSummary" Text="Пока нет подключений" FontWeight="SemiBold"/>
          <TextBlock Text="Добавь подписку или отдельный профиль" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,12"/>
          <WrapPanel>
            <Button x:Name="RefreshButton" Content="Обновить" IsEnabled="False" Margin="0,0,8,6"/>
            <Button x:Name="SubscriptionButton" Content="+ Подписка" Margin="0,0,0,6"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="SelectedName" Text="Выбери подключение" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Используем параметры из твоего профиля. Страна выхода и скорость пока не определяются." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
        <TextBlock Text="Протокол и транспорт" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Border Style="{StaticResource Card}" Background="#F7F9FF" BorderBrush="{StaticResource Blue}">
          <StackPanel>
            <TextBlock x:Name="SelectedTransport" Text="—" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SelectedCore" Text="Ядро выберется по формату профиля" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#F5F6F8" CornerRadius="16" Padding="16" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Измерения" FontWeight="SemiBold"/>
            <TextBlock x:Name="MeasurementDetails" Text="Ещё не проверяли" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
            <WrapPanel><Button x:Name="MeasureButton" Content="Проверить серверы" Margin="0,0,8,8"/><Button x:Name="BestButton" Content="Выбрать лучший" Margin="0,0,0,8"/></WrapPanel>
          </StackPanel>
        </Border>
        <Button x:Name="UseServerButton" Content="Перейти к подключению" Style="{StaticResource Primary}" Margin="0,26,0,16"/>
        <TextBlock Text="Свой ключ или файл" FontWeight="SemiBold" Margin="0,8,0,12"/>
        <WrapPanel>
          <Button x:Name="PasteButton" Content="Вставить ключ / JSON" Margin="0,0,8,8"/>
          <Button x:Name="ImportFileButton" Content="Открыть файл" Margin="0,0,0,8"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
