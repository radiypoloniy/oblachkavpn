<UserControl x:Class="Oblachka.Views.NetworkDoctorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- «Проверить сеть Windows»: найденное человеческим языком; исправляется только найденное. -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type o:NetworkFinding}">
      <Border CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource CardBg}" Padding="14,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Text}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="10,0,96,0">
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Сеть Windows" Style="{StaticResource Brand}" Margin="4,0,0,0"/>
    </DockPanel>
    <TextBlock x:Name="Summary" Grid.Row="1" Margin="22,0,22,10" FontSize="{StaticResource FsLabel}" TextWrapping="Wrap" Foreground="{DynamicResource Mu}" Text="Проверяем…"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,0,20,0">
      <ItemsControl x:Name="FindingList" Focusable="False"/>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="FixButton" Content="Исправить найденное" Style="{StaticResource BtnPrimary}" Height="42" o:Ui.CornerRadius="{StaticResource RadiusMd}"/>
          <Button x:Name="UndoButton" Grid.Column="2" Content="Вернуть как было" Style="{StaticResource BtnOutline}" Height="42" o:Ui.CornerRadius="{StaticResource RadiusMd}"/>
        </Grid>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="RecheckButton" Content="Проверить ещё раз" Style="{StaticResource BtnLink}"/>
          <Button x:Name="WindowsResetButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Полный сброс сети Windows…" Style="{StaticResource BtnLink}"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
