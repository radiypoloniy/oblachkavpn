<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views">
  <!-- Строка «Серверов» (ServersSheet) — отдельным словарём: с машинами (ServerMachines) шаблон
       вырос, и лист «Серверов» перерос лимит размера. -->
  <!-- Облик 0.21: в строке только флаг, название и пинг. Протокол, скорость, «проверить»,
       «изменить» и «убрать» — в меню «⋯» (появляется при наведении); выбранная строка — сиренью.
       Машина раскрывается плашкой «3 варианта» в одну карточку: пояснение (MachineNote) и протоколы. -->
  <DataTemplate DataType="{x:Type o:ServerRow}">
    <Border x:Name="Plate" Height="44" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,2" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Grid>
        <Grid x:Name="ServerLayout">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="RowButton" Style="{StaticResource Row}" Height="44" Padding="10,0,6,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" AutomationProperties.Name="{Binding Name}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" FontSize="{StaticResource FsBody}" FontWeight="Bold" MinWidth="50" TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding LatencyHint}"/>
              <v:PixelBars x:Name="RowBars" DockPanel.Dock="Right" Kind="Steps" Width="22" Height="10" Margin="10,0,8,0" VerticalAlignment="Center" Filled="{Binding PingSteps}" Fill="{Binding LatencyDot}" Empty="{DynamicResource Pixel}" Visibility="{Binding LatencyVisibility}" ToolTip="{Binding LatencyHint}"/>
              <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse Visibility="{Binding FlagVisibility}" Stroke="{DynamicResource FlagRing}" StrokeThickness="1">
                  <Ellipse.Fill><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Ellipse.Fill>
                </Ellipse>
                <Border x:Name="IconPlate" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource Aci}" Visibility="{Binding IconVisibility}">
                  <Path x:Name="IconGlyph" Data="{Binding Icon}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource Ac}"/>
                </Border>
              </Grid>
              <!-- Плашка, значок и подпись получают место первыми (прижаты справа внутри панели по ширине
                   содержимого), название — что осталось, с многоточием: в узком окне плашка не уходит за край. -->
              <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                <!-- Машина: плашка «3 варианта ⌄» раскрывает её протоколы; щелчок по строке подключает, протокол Облачка выбирает сама. -->
                <Button x:Name="ExpandChip" DockPanel.Dock="Right" Tag="expand" Style="{StaticResource Plain}" Height="24" Padding="10,0,8,0" Margin="10,0,0,0" o:Ui.CornerRadius="{StaticResource RadiusSm}" VerticalAlignment="Center"
                        Background="{DynamicResource Field}" Visibility="{Binding ExpandVisibility}" AutomationProperties.Name="{Binding ExpandName}" ToolTip="{Binding ExpandHint}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ExpandCount}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ExpandWord" Text="{Binding ExpandWord}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <Path x:Name="ExpandGlyph" Data="M6,9 L12,15 L18,9" Width="9" Height="9" Margin="6,1,0,0" Stretch="Uniform" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource Mu}" RenderTransformOrigin="0.5,0.5"/>
                  </StackPanel>
                </Button>
                <Path DockPanel.Dock="Right" Data="{StaticResource IcoSliders}" Width="13" Height="13" Margin="8,1,0,0" Stretch="Uniform" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Ac}" VerticalAlignment="Center"
                      Visibility="{Binding TunedVisibility}" ToolTip="Подстроен «Подобрать лучшее»"/>
                <TextBlock x:Name="DetailLine" DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Fa}" Margin="8,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" Visibility="{Binding DetailVisibility}"/>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsRowLarge}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center"/>
              </DockPanel>
            </DockPanel>
          </Button>
          <Button x:Name="MoreButton" Grid.Column="1" Tag="more" Style="{StaticResource IconButton}" Width="30" Height="30" Opacity="0" AutomationProperties.Name="Ещё: проверить, убрать" ToolTip="Проверить, убрать">
            <Path Data="M5,12 L5.01,12 M12,12 L12.01,12 M19,12 L19.01,12" Width="16" Height="4" Stretch="Uniform" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Mu2}"/>
          </Button>
          <Button x:Name="StarButton" Grid.Column="2" Tag="star" Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,2,0" AutomationProperties.Name="Избранное">
            <Path x:Name="StarGlyph" Data="{StaticResource IcoStar}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round" Stroke="{DynamicResource Ring}" Fill="Transparent"/>
          </Button>
        </Grid>

        <!-- Протокол в раскрытой машине: точка цвета пинга, имя, подпись простыми словами, «сейчас» или «закреплён». -->
        <Grid x:Name="MemberLayout" Visibility="Collapsed" Height="44" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="66"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="MemberButton" Style="{StaticResource Row}" Height="44" Margin="6,0,0,0" Padding="38,0,6,0" o:Ui.CornerRadius="{StaticResource RadiusInner}" AutomationProperties.Name="{Binding Name}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" FontSize="{StaticResource FsBody}" FontWeight="Bold" MinWidth="50" TextAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding LatencyHint}"/>
              <v:PixelBars x:Name="MemberBars" DockPanel.Dock="Right" Kind="Steps" Width="22" Height="10" Margin="10,0,8,0" VerticalAlignment="Center" Filled="{Binding PingSteps}" Fill="{Binding LatencyDot}" Empty="{DynamicResource Pixel}" Visibility="{Binding LatencyVisibility}"/>
              <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding LatencyDot}" Stroke="{DynamicResource Ring}" StrokeThickness="1"/>
              <!-- Метка «сейчас»/«закреплён» и имя — всегда целиком; подпись уступает место первой. -->
              <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border DockPanel.Dock="Right" Background="{DynamicResource Bg}" CornerRadius="{StaticResource RadiusIcon}" Padding="7,2" Margin="10,1,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                  <TextBlock Text="{Binding Badge}" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{DynamicResource Ac}"/>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Hint}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Fa}" Margin="10,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center"/>
              </DockPanel>
            </DockPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <!-- Раскрытая машина, пояснение и её протоколы — одна карточка CardBg. -->
      <DataTrigger Binding="{Binding Expanded}" Value="True">
        <Setter TargetName="Plate" Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter TargetName="Plate" Property="CornerRadius" Value="16,16,0,0"/>
        <Setter TargetName="Plate" Property="Margin" Value="0,2,0,0"/>
        <Setter TargetName="ExpandChip" Property="Background" Value="{DynamicResource Bg}"/>
        <Setter TargetName="ExpandGlyph" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMember}" Value="True">
        <Setter TargetName="Plate" Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter TargetName="Plate" Property="CornerRadius" Value="0"/>
        <Setter TargetName="Plate" Property="Margin" Value="0"/>
        <Setter TargetName="ServerLayout" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="MemberLayout" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsLastMember}" Value="True">
        <Setter TargetName="Plate" Property="CornerRadius" Value="0,0,16,16"/>
        <Setter TargetName="Plate" Property="Height" Value="48"/>
        <Setter TargetName="Plate" Property="Margin" Value="0,0,0,8"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Selected}" Value="True">
        <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Lilac}"/>
        <Setter TargetName="RowButton" Property="Tag" Value="Transparent"/>
      </DataTrigger>
      <!-- Закреплённый протокол — сиренью внутри карточки, карточка остаётся своего цвета. -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMember}" Value="True"/>
          <Condition Binding="{Binding Selected}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter TargetName="Plate" Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter TargetName="MemberButton" Property="Background" Value="{DynamicResource Lilac}"/>
        <Setter TargetName="MemberButton" Property="Tag" Value="Transparent"/>
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding Favorite}" Value="True">
        <Setter TargetName="StarGlyph" Property="Fill" Value="{DynamicResource Star}"/>
        <Setter TargetName="StarGlyph" Property="Stroke" Value="{DynamicResource Star}"/>
        <Setter TargetName="StarButton" Property="AutomationProperties.Name" Value="Убрать из избранного"/>
      </DataTrigger>
      <!-- Узкое окно (ServersSheet ставит списку Tag="narrow"): плашка — «3 ⌄», подпись под именем уходит. -->
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="narrow">
        <Setter TargetName="ExpandWord" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="DetailLine" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="RowBars" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="MemberBars" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding CanFavorite}" Value="False">
        <Setter TargetName="StarButton" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="MoreButton" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <Trigger SourceName="Plate" Property="IsMouseOver" Value="True">
        <Setter TargetName="MoreButton" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger SourceName="MoreButton" Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="MoreButton" Property="Opacity" Value="1"/>
      </Trigger>
      <DataTrigger Binding="{Binding IconMuted}" Value="True">
        <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Field}"/>
        <Setter TargetName="IconGlyph" Property="Stroke" Value="{DynamicResource Mu2}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Пояснение под раскрытой машиной — часть её карточки. -->
  <DataTemplate DataType="{x:Type o:MachineNote}">
    <Border Background="{DynamicResource CardBg}" Padding="44,0,14,2" Height="28" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <DockPanel HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button DockPanel.Dock="Right" Tag="machine-auto" Content="Пусть выбирает сама" Style="{StaticResource BtnLink}" Height="24" Padding="8,0" FontSize="{StaticResource FsNote}" Visibility="{Binding ResetVisibility}"/>
        <TextBlock Text="{Binding Text}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
