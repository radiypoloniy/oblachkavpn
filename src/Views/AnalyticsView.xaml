<UserControl x:Class="Oblachka.Views.AnalyticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Oblachka.Views" xmlns:o="clr-namespace:Oblachka" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Локальная статистика системного туннеля. Все карточки находятся в прокрутке; нижняя пара
       складывается в одну колонку на узком острове (Fit), поэтому содержимое не обрезается. -->
  <UserControl.Resources>
    <Style x:Key="AnalyticsCard" TargetType="Border" BasedOn="{StaticResource Plate}">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>
    <DataTemplate x:Key="RankRow">
      <StackPanel Margin="0,0,0,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontWeight="SemiBold" Margin="8,0,0,0"/>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        </DockPanel>
        <ProgressBar Value="{Binding Percent}" Height="7" Margin="0,5,0,0" AutomationProperties.Name="{Binding Name}">
          <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
            <Border Background="{DynamicResource Field}" CornerRadius="{StaticResource RadiusXs}">
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" Background="{DynamicResource AnalyticsVpn}" CornerRadius="{StaticResource RadiusXs}" HorizontalAlignment="Left"/>
              </Grid>
            </Border>
          </ControlTemplate></ProgressBar.Template>
        </ProgressBar>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type v:AnalyticsProgramRow}">
      <Grid MinHeight="52" Margin="0,1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource Field}" VerticalAlignment="Center" Visibility="{Binding PlaceholderVisibility}">
          <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Image Source="{Binding Icon}" Width="30" Height="30" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,1,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="10,0,20,0">
      <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Экспорт CSV" Style="{StaticResource BtnSecondary}" Height="36" Padding="14,0" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Экспорт аналитики в CSV"/>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Аналитика" Style="{StaticResource PageHead}" Margin="10,0,12,0" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="24,0,24,20">
        <DockPanel Margin="0,0,0,12">
          <Button x:Name="PeriodButton" DockPanel.Dock="Right" Style="{StaticResource BtnOutline}" Height="34" Padding="12,0" AutomationProperties.Name="Период аналитики">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ReportCaption" Text="Сегодня" VerticalAlignment="Center"/>
              <Path Data="M6,9 L12,15 L18,9" Style="{StaticResource Icon}" Width="11" Height="8" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <TextBlock Text="Трафик этого компьютера" Style="{StaticResource Small}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
        </DockPanel>
        <Popup x:Name="PeriodPopup" PlacementTarget="{Binding ElementName=PeriodButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Grid Width="198" Margin="9,4,9,12">
            <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
            <Border Style="{StaticResource MenuCard}" Padding="8">
              <StackPanel x:Name="PeriodItems"/>
            </Border>
          </Grid>
        </Popup>

        <Border Style="{StaticResource AnalyticsCard}" Background="{DynamicResource Acs}" Margin="0,0,0,14">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="DownloadText" Style="{StaticResource Small}"/>
              <TextBlock x:Name="UploadText" Style="{StaticResource Small}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Всего в туннеле" Style="{StaticResource Small}"/>
              <TextBlock x:Name="TotalText" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsTitle}" FontWeight="Bold"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <UniformGrid x:Name="DashboardGrid" Columns="2" Margin="0,0,-10,0">
          <Border Style="{StaticResource AnalyticsCard}">
            <StackPanel>
              <TextBlock Text="Динамика трафика" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="По учтённым программам" Style="{StaticResource Small}" Margin="0,2,0,6"/>
              <WrapPanel Margin="0,0,0,10">
                <DockPanel Margin="0,0,9,0"><Ellipse Width="7" Height="7" Fill="{DynamicResource AnalyticsVpn}" Margin="0,0,4,0"/><TextBlock Text="VPN" Style="{StaticResource Small}"/></DockPanel>
                <DockPanel Margin="0,0,9,0"><Ellipse Width="7" Height="7" Fill="{DynamicResource AnalyticsDirect}" Margin="0,0,4,0"/><TextBlock Text="Напрямую" Style="{StaticResource Small}"/></DockPanel>
                <DockPanel><Ellipse Width="7" Height="7" Fill="{DynamicResource AnalyticsUnknown}" Margin="0,0,4,0"/><TextBlock Text="Не определено" Style="{StaticResource Small}"/></DockPanel>
              </WrapPanel>
              <Grid Height="128">
                <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,7,0">
                  <TextBlock x:Name="ChartScale" Style="{StaticResource Small}" VerticalAlignment="Top"/>
                  <TextBlock Text="0" Style="{StaticResource Small}" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                </Grid>
                <v:TrafficChart Grid.Column="1" x:Name="Chart" Focusable="True" DownloadBrush="{DynamicResource AnalyticsVpn}" UploadBrush="{DynamicResource AnalyticsDirect}" UnclassifiedBrush="{DynamicResource AnalyticsUnknown}" SelectionBrush="{DynamicResource Acs}" GridBrush="{DynamicResource Divider}" AutomationProperties.Name="Динамика трафика. Стрелки выбирают интервал"/>
                <TextBlock Grid.Column="1" x:Name="ChartEmpty" Text="Пока нет данных по интервалам" Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
              </Grid>
              <Grid x:Name="AxisLabels" Height="22" Margin="62,3,0,0"/>
              <TextBlock x:Name="ChartDetail" Style="{StaticResource Small}" TextWrapping="Wrap" MinHeight="34" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AnalyticsCard}">
            <StackPanel>
              <TextBlock Text="Куда шёл трафик" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="По учтённым программам" Style="{StaticResource Small}" Margin="0,2,0,10"/>
              <Grid Width="116" Height="116" Margin="0,0,0,9">
                <v:TrafficRing x:Name="RouteRing" VpnBrush="{DynamicResource AnalyticsVpn}" DirectBrush="{DynamicResource AnalyticsDirect}"
                               UnknownBrush="{DynamicResource AnalyticsUnknown}" EmptyBrush="{DynamicResource Field}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="VpnShare" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsTitle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="через VPN" Style="{StaticResource Small}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <DockPanel Margin="0,0,0,4"><Ellipse Width="8" Height="8" Fill="{DynamicResource AnalyticsVpn}" Margin="0,0,7,0"/><TextBlock x:Name="VpnText"/></DockPanel>
              <DockPanel Margin="0,0,0,4"><Ellipse Width="8" Height="8" Fill="{DynamicResource AnalyticsDirect}" Margin="0,0,7,0"/><TextBlock x:Name="DirectText"/></DockPanel>
              <DockPanel><Ellipse Width="8" Height="8" Fill="{DynamicResource AnalyticsUnknown}" Margin="0,0,7,0"/><TextBlock x:Name="UnknownText"/></DockPanel>
            </StackPanel>
          </Border>
        </UniformGrid>
        <UniformGrid x:Name="RankGrid" Columns="2" Margin="0,0,-10,0">
          <Border Style="{StaticResource AnalyticsCard}">
            <StackPanel>
              <TextBlock Text="Подписки" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="Трафик с подтверждённым VPN-выходом" Style="{StaticResource Small}" Margin="0,2,0,12" TextWrapping="Wrap"/>
              <ItemsControl x:Name="SubscriptionsChart" ItemTemplate="{StaticResource RankRow}"/>
              <TextBlock x:Name="SubscriptionsEmpty" Text="Пока нет данных по подпискам" Style="{StaticResource Small}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AnalyticsCard}">
            <StackPanel>
              <TextBlock Text="Серверы" Style="{StaticResource OptTitle}"/>
              <TextBlock Text="Трафик с подтверждённым VPN-выходом" Style="{StaticResource Small}" Margin="0,2,0,12" TextWrapping="Wrap"/>
              <ItemsControl x:Name="ServersChart" ItemTemplate="{StaticResource RankRow}"/>
              <TextBlock x:Name="ServersEmpty" Text="Пока нет данных по серверам" Style="{StaticResource Small}"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Style="{StaticResource Plate}" Margin="0,12,0,0">
          <StackPanel>
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ServerText" Text="Сервер не выбран" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" TextAlignment="Right" MaxWidth="250"/>
              </StackPanel>
              <TextBlock Text="Скорость сейчас" FontSize="{StaticResource FsRowLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="↓ получение" Style="{StaticResource Caption}"/><TextBlock x:Name="CurrentDown" Text="0 КБ/с" FontSize="{StaticResource FsLead}" FontWeight="SemiBold" Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="↑ отправка" Style="{StaticResource Caption}"/><TextBlock x:Name="CurrentUp" Text="0 КБ/с" FontSize="{StaticResource FsLead}" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
            <v:TrafficChart x:Name="SpeedChart" Line="True" Height="82" Margin="0,12,0,0" UploadBrush="{DynamicResource Sun}" DownloadBrush="{DynamicResource RouteVpn}" GridBrush="{DynamicResource Divider}"/>
            <TextBlock Text="Средняя скорость по минутам за последний час" Style="{StaticResource Small}" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <Grid x:Name="LowerGrid" Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProgramsColumn" Width="*"/><ColumnDefinition x:Name="PlanColumn" Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="ProgramsCard" Style="{StaticResource Plate}" Margin="0,0,5,0">
            <StackPanel>
              <TextBlock Text="Программы" FontSize="{StaticResource FsRowLarge}" FontWeight="SemiBold"/>
              <TextBlock Text="Наибольший трафик за выбранный период" Style="{StaticResource Small}" Margin="0,3,0,8"/>
              <TextBox x:Name="ProgramSearch" AutomationProperties.Name="Найти программу" Visibility="Collapsed" Margin="0,0,0,6"/>
              <ItemsControl x:Name="ProgramList" Focusable="False"/>
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="PreviousPrograms" Content="Назад" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Visibility="Collapsed"/>
                <Button x:Name="MorePrograms" Content="Все программы" Style="{StaticResource BtnSecondary}" Visibility="Collapsed"/>
              </WrapPanel>
              <TextBlock x:Name="ProgramsEmpty" Text="Данные появятся после подключения в режиме «Весь компьютер»." Style="{StaticResource Small}" Margin="0,10,0,4"/>
            </StackPanel>
          </Border>
          <Border x:Name="PlanCard" Grid.Column="1" Style="{StaticResource Plate}" Margin="5,0,0,0">
            <StackPanel>
              <TextBlock x:Name="PlanTitle" TextWrapping="Wrap" Text="Подписка" FontSize="{StaticResource FsRowLarge}" FontWeight="SemiBold"/>
              <TextBlock x:Name="PlanText" Text="Нет данных о подписке" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
              <TextBlock x:Name="PlanRemaining" TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,5,0,0"/>
              <v:PixelBars x:Name="PlanBars" Kind="Segments" Count="6" Height="12" Margin="0,16,0,0" Fill="{DynamicResource RouteVpn}" Empty="{DynamicResource Lilac}"/>
              <TextBlock Text="Сведения подписки могут учитывать другие устройства. Локальная история считается отдельно." TextWrapping="Wrap" Style="{StaticResource Small}" Margin="0,10,0,0"/>
              <TextBlock x:Name="PlanSource" TextWrapping="Wrap" Text="Данные провайдера" Style="{StaticResource Small}" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Margin="0,12,0,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1.5,0,0" Padding="0,12,0,0">
          <DockPanel>
            <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="Сбросить статистику" Style="{StaticResource BtnGhost}" Foreground="{DynamicResource RF}" FontSize="{StaticResource FsNote}" VerticalAlignment="Center" AutomationProperties.Name="Сбросить статистику трафика"/>
            <TextBlock Text="Можно удалить историю трафика и программ. Настройки VPN и подписка останутся." Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
