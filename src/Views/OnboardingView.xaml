<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RoutePilot.Views.OnboardingView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="550" HorizontalAlignment="Center" Margin="30,44,30,32">
      <TextBlock Text="Добавьте подписку" FontSize="32" FontWeight="Bold" Margin="0,0,0,16"/>
      <TextBlock Text="Вставьте ссылку от вашего сервиса — подключения появятся в приложении. Обновить список можно в разделе серверов." Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,36"/>
      <TextBlock Text="Ссылка на подписку" Margin="0,0,0,10" FontWeight="SemiBold"/>
      <TextBox x:Name="SubscriptionUrl" Tag="HTTPS-ссылка на подписку" Height="42" MaxLength="20480" AutomationProperties.Name="Ссылка на подписку" ToolTip="Вставьте ссылку сочетанием Ctrl+V"/>
      <CheckBox x:Name="RememberSubscription" Content="Запомнить на этом компьютере" IsChecked="True" Margin="0,12,0,0"/>
      <Button x:Name="ContinueButton" Content="Добавить подписку" Style="{StaticResource Primary}" Margin="0,18,0,26" Padding="16,11"/>
      <Border Style="{StaticResource Card}" Padding="0">
        <StackPanel>
          <Button x:Name="KeyButton" Background="Transparent" Padding="20,18" HorizontalContentAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="У меня ключ или JSON" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="VLESS-ссылка, профиль Xray или sing-box" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="20,0"/>
          <Button x:Name="FileButton" Background="Transparent" Padding="20,18" HorizontalContentAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="Открыть файл профиля" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="Выберите собственный JSON или текстовый файл" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <TextBlock Text="Если включено запоминание, ссылка и подключения сохраняются в зашифрованном виде для вашей учётной записи Windows." Style="{StaticResource MutedText}" FontSize="13" Margin="0,24,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
