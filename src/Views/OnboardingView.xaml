<UserControl x:Class="Oblachka.Views.OnboardingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Первый запуск: «Вставьте ключ — и всё готово» (экран 04). Одно поле на всё: ключ Облачков,
       ссылка подписки любого сервиса, vless://, trojan://, hy2://, JSON. -->
  <DockPanel Margin="32,0,32,24">
    <TextBlock DockPanel.Dock="Top" Text="облачка" Style="{StaticResource Brand}" Height="64" Padding="0,21,0,0" Margin="-8,0,0,0"/>
    <TextBlock DockPanel.Dock="Bottom" Text="Ключ хранится в зашифрованном виде только на этом компьютере" FontSize="11.5" Foreground="{DynamicResource Fa}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <!-- Свечение — подложкой: эффект на самой кнопке размывал её текст. -->
    <Grid DockPanel.Dock="Bottom">
      <Border CornerRadius="14" Background="{DynamicResource Ac}" Margin="10,4,10,0" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="270" Color="{DynamicResource GlowColor}" Opacity="0.7"/></Border.Effect>
      </Border>
      <Button x:Name="ContinueButton" Content="Подключиться" Style="{StaticResource BtnPrimary}" Height="52" o:Ui.CornerRadius="14" FontSize="15"/>
    </Grid>
    <StackPanel>
      <TextBlock Text="Вставьте ключ —&#x0a;и всё готово" FontSize="26" FontWeight="Bold" LineHeight="31" Margin="0,32,0,0"/>
      <TextBlock Text="Подойдёт ключ Облачков, ссылка подписки другого сервиса или отдельный профиль vless://, trojan://, hy2://."
                 FontSize="14" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>
      <TextBlock Text="Ключ или ссылка" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" Margin="0,26,0,6"/>
      <TextBox x:Name="KeyInput" Style="{StaticResource FieldBox}" Height="96" Tag="Ctrl+V" MaxLength="20480" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" Padding="14,12" FontFamily="{StaticResource MonoFont}" FontSize="13.5"
               VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ключ или ссылка подписки"/>
      <Button x:Name="FileButton" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-6,8,0,0" Padding="6,0,10,0" Foreground="{DynamicResource Ac}">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IcoFile}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2" StrokeLineJoin="Round" Margin="0,0,8,0"/>
          <TextBlock Text="Открыть файл профиля (JSON, txt)" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </DockPanel>
</UserControl>
