<UserControl x:Class="Oblachka.Views.OnboardingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Первый запуск: «Вставьте ключ — и всё готово» (экран 04). Одно поле на всё: ключ Облачков,
       ссылка подписки любого сервиса, vless://, trojan://, hy2://, JSON. -->
  <!-- В широком окне колонка не растягивается: первый экран читается как раньше, по центру. -->
  <DockPanel Margin="32,0,32,24" MaxWidth="520">
    <TextBlock DockPanel.Dock="Top" Text="облачка" Style="{StaticResource Brand}" Height="64" Padding="0,21,0,0" Margin="-8,0,0,0"/>
    <TextBlock DockPanel.Dock="Bottom" Text="Ключ хранится в зашифрованном виде только на этом компьютере" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Fa}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <!-- Свечение — подложкой: эффект на самой кнопке размывал её текст. -->
    <Grid DockPanel.Dock="Bottom">
      <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Ac}" Margin="10,4,10,0" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="270" Color="{DynamicResource GlowColor}" Opacity="0.7"/></Border.Effect>
      </Border>
      <Button x:Name="ContinueButton" Content="Подключиться" Style="{StaticResource BtnPrimary}" Height="52" o:Ui.CornerRadius="{StaticResource RadiusXl}" FontSize="{StaticResource FsLead}"/>
    </Grid>
    <StackPanel>
      <TextBlock Text="Вставьте ключ —&#x0a;и всё готово" FontSize="{StaticResource FsDisplay}" FontWeight="Bold" LineHeight="31" Margin="0,32,0,0"/>
      <TextBlock Text="Подойдёт ключ Облачков, ссылка подписки другого сервиса или отдельное подключение: vless://, vmess://, ss://, trojan://, hy2://, tuic://, файл WireGuard."
                 FontSize="{StaticResource FsRow}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/>
      <TextBlock Text="Ключ или ссылка" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" Margin="0,26,0,6"/>
      <TextBox x:Name="KeyInput" Style="{StaticResource FieldBox}" Height="96" Tag="Ctrl+V" MaxLength="20480" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" Padding="14,12" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsLabel}"
               VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ключ или ссылка подписки"/>
      <Button x:Name="FileButton" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-6,8,0,0" Padding="6,0,10,0" Foreground="{DynamicResource Ac}">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IcoFile}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2" StrokeLineJoin="Round" Margin="0,0,8,0"/>
          <TextBlock Text="Открыть файл профиля (JSON, txt)" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button x:Name="ScanButton" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="-6,0,0,0" Padding="6,0,10,0" Foreground="{DynamicResource Ac}"
              ToolTip="Откройте QR-код в Telegram или браузере, чтобы он был виден на экране. Картинку с кодом можно и вставить в поле: Ctrl+V.">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IcoQr}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2" StrokeLineJoin="Round" Margin="0,0,8,0"/>
          <TextBlock Text="Сканировать QR-код на экране" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <!-- Подписки, найденные в других клиентах на этом компьютере (ForeignClients). Нажатие
           загружает выбранную и подключает, как «Подключиться» с этой ссылкой в поле. -->
      <StackPanel x:Name="ForeignPanel" Visibility="Collapsed" Margin="0,22,0,0">
        <TextBlock Text="Или перенесите из другого приложения" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" Margin="0,0,0,8"/>
        <ScrollViewer MaxHeight="124" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="ForeignList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type o:ForeignSubscription}">
                <Button Style="{StaticResource Row}" Height="56" Margin="0,0,0,6" Background="{DynamicResource Field}" Padding="14,0,12,0"
                        AutomationProperties.Name="{Binding Client}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="{StaticResource FsRowLarge}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Hint, Mode=OneWay}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Path Grid.Column="1" Data="{StaticResource IcoChevronRight}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Mu2}" StrokeThickness="2" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</UserControl>
