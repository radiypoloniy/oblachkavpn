<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RoutePilot.Views.OnboardingView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Width="550" HorizontalAlignment="Center" Margin="30,44,30,32">
      <TextBlock x:Name="BrandText" Text="Облачка" FontSize="14" FontWeight="SemiBold" Opacity="0.55" Margin="0,0,0,10"/>
      <TextBlock x:Name="HeadingText" Text="Введите ключ подписки" FontSize="32" FontWeight="Bold" Margin="0,0,0,16"/>
      <TextBlock x:Name="IntroText" Style="{StaticResource MutedText}" FontSize="15" Margin="0,0,0,36" TextWrapping="Wrap"
                 Text="Ключ выдают вместе с подпиской. Это строка из латинских букв, цифр, дефисов и подчёркиваний. Можно вставить и всю ссылку целиком — клиент сам возьмёт из неё ключ."/>
      <TextBlock Text="Ключ подписки" Margin="0,0,0,10" FontWeight="SemiBold"/>
      <TextBox x:Name="KeyInput" Tag="Например, hRDbej1hw9YC7rEc-QktKA5Rh" Height="42" MaxLength="20480" AutomationProperties.Name="Ключ подписки" ToolTip="Вставьте сочетанием Ctrl+V"/>
      <CheckBox x:Name="RememberSubscription" Content="Запомнить на этом компьютере" IsChecked="True" Margin="0,12,0,0"/>
      <Button x:Name="ContinueButton" Content="Подключиться" Style="{StaticResource Primary}" Margin="0,18,0,26" Padding="16,11"/>
      <Border Style="{StaticResource Card}" Padding="0">
        <StackPanel>
          <TextBlock Text="Подписка другого сервиса" FontWeight="SemiBold" FontSize="15" Margin="20,18,20,0"/>
          <TextBlock Style="{StaticResource MutedText}" Margin="20,6,20,14" TextWrapping="Wrap"
                     Text="Клиент умеет подключаться и к сторонним подпискам. Такие подключения помечаются отдельно, подбор и измерения для них не работают."/>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="20,0"/>
          <Button x:Name="KeyButton" Background="Transparent" Padding="20,18" HorizontalContentAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="Вставить ссылку или JSON" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="Ссылка подписки, vless://, trojan://, hy2:// или профиль Xray / sing-box" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="20,0"/>
          <Button x:Name="FileButton" Background="Transparent" Padding="20,18" HorizontalContentAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="Открыть файл профиля" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock Text="Свой JSON или текстовый файл со ссылками" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <TextBlock Text="Если включено запоминание, ключ и список подключений хранятся в зашифрованном виде для вашей учётной записи Windows." Style="{StaticResource MutedText}" FontSize="13" Margin="0,24,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
