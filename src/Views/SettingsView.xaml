<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Oblachka.Views.SettingsView">
  <Border Style="{StaticResource Card}" Background="#F5F6F9" Padding="26" Width="620" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="40" Padding="8" AutomationProperties.Name="Закрыть настройки"/>
        <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold"/>
      </DockPanel>
      <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
        <TabItem Header="Основное">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,18,0,0">
              <TextBlock Text="Запуск" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="12,0,0,10"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Запускать вместе с Windows" VerticalAlignment="Center"/>
                    <CheckBox x:Name="StartWithWindows" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Запускать вместе с Windows"/>
                  </Grid>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="При закрытии оставаться в трее" VerticalAlignment="Center"/>
                      <CheckBox x:Name="StayInTray" Grid.Column="1" Style="{StaticResource Switch}" IsChecked="True" AutomationProperties.Name="При закрытии оставаться в трее"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Text="Режим подключения" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="12,24,0,10"/>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Системный прокси Windows"/>
                    <TextBlock Text="Браузеры и большинство программ идут через Облачку, пока подключение запущено. Прежние настройки возвращаются после остановки. Права администратора не нужны." Style="{StaticResource MutedText}" FontSize="13" MaxWidth="400" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                  </StackPanel>
                  <CheckBox x:Name="SystemProxy" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Системный прокси Windows"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Системный VPN"/>
                      <TextBlock x:Name="SystemTunnelHint" Text="Весь трафик компьютера идёт через туннель, включая игры и программы без настроек прокси." Style="{StaticResource MutedText}" FontSize="13" MaxWidth="400" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="SystemTunnel" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Системный VPN"/>
                  </Grid>
                  <TextBlock x:Name="SystemTunnelNote" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                             Text="Весь трафик компьютера пойдёт через туннель, а мимо туннеля будет заблокирован фильтрами Windows."/>
                  <Button x:Name="RestoreNetwork" Content="Восстановить сеть" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Если связь прервалась" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="12,24,0,10"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Восстанавливать автоматически"/>
                      <TextBlock Text="Каждые 45 секунд проверяем связь через два сайта; если не отвечают — подбираем другой сервер." Style="{StaticResource MutedText}" FontSize="13" MaxWidth="400" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoRecover" Grid.Column="1" Style="{StaticResource Switch}" AutomationProperties.Name="Перезапускать ядро при сбое"/>
                  </Grid>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Блокировать интернет без VPN"/>
                        <TextBlock Text="Всегда действует в системном VPN: при обрыве связи программы не пойдут мимо туннеля." Style="{StaticResource MutedText}" FontSize="13" MaxWidth="400" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Text="Интерфейс" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="12,24,0,10"/>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="Светлая" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="Оформление"/>
                  </DockPanel>
                  <DockPanel Margin="0,16,0,0">
                    <TextBlock Text="Русский" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="Язык"/>
                  </DockPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="Когда включено запоминание подключений, изменения сохраняются автоматически." Style="{StaticResource MutedText}" FontSize="12" Margin="12,18,0,8"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Подписка">
          <StackPanel Margin="0,24,0,0">
            <TextBlock Text="Список подключений" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubscriptionDetails" Text="Сервер не передал срок и остаток трафика." Style="{StaticResource MutedText}" Margin="0,10,0,10"/>
            <CheckBox x:Name="AutoRefresh" Content="Обновлять каждые 6 часов и после запуска" IsChecked="True" Margin="0,0,0,12"/>
            <TextBlock Text="Обновление сохраняет работающий туннель. Новый список применяется после остановки." Style="{StaticResource MutedText}" Margin="0,12,0,24"/>
            <Button x:Name="ManageSubscriptionButton" Content="Открыть серверы" Style="{StaticResource Primary}"/>
            <TextBlock Text="Другие подписки" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,10"/>
            <TextBlock x:Name="ExternalSummary" Text="Сторонних подписок нет." Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
            <TextBlock Text="Подписка другого сервиса работает рядом с вашей и не заменяет её. Такие узлы помечены в списке серверов: автообновление, подбор и измерения по ним не выполняются." Style="{StaticResource MutedText}" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button x:Name="AddExternalButton" Content="Добавить стороннюю подписку" Margin="0,0,8,8"/>
              <Button x:Name="RemoveExternalButton" Content="Убрать сторонние" IsEnabled="False" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="На этом компьютере" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,12"/>
            <TextBlock x:Name="DeviceIdText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="Идентификатор устройства" ToolTip="Случайное значение, созданное при первом запуске. Аппаратные серийные номера не читаются."/>
            <TextBlock x:Name="StorageStatus" Text="При включённом запоминании подписка сохраняется автоматически. Данные шифруются Windows и доступны вашей учётной записи." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Button x:Name="SaveStateButton" Content="Сохранить на этом компьютере" IsEnabled="False"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Для опытных">
          <StackPanel Margin="0,24,0,0">
            <TextBlock x:Name="VersionText" Text="Облачка" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Xray 26.9.9 и sing-box 1.14.3. Формат профиля определяет ядро. Туннель работает как локальный SOCKS5/HTTP-прокси для TCP; системный прокси включается в «Основном»." Style="{StaticResource MutedText}" Margin="0,12,0,24"/>
            <Button x:Name="OpenDiagnosticsButton" Content="Открыть диагностику" Style="{StaticResource Primary}"/>
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</UserControl>
