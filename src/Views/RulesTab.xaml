<UserControl x:Class="Oblachka.Views.RulesTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Правила (экран 11): локальный прокси, правила сайтов и программ, «Куда пойдёт сайт?». -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type o:RuleRow}">
      <Border MinHeight="42" Padding="6,4,2,4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" Tag="delete" Style="{StaticResource SmallIconButton}" Width="30" Height="30" Foreground="{DynamicResource Fa}" AutomationProperties.Name="Удалить правило">
            <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4"/>
          </Button>
          <Button x:Name="Badge" DockPanel.Dock="Right" Tag="cycle" Style="{StaticResource Plain}" Height="26" Padding="10,0" o:Ui.CornerRadius="13" Margin="0,0,6,0"
                  FontSize="12" FontWeight="SemiBold" Content="{Binding ActionText}" Background="{DynamicResource Aci}" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Сменить действие"/>
          <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RuleText" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Visibility="{Binding SubVisibility}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Plain}" Value="True">
          <Setter TargetName="RuleText" Property="FontFamily" Value="{StaticResource UiFont}"/>
          <Setter TargetName="RuleText" Property="FontSize" Value="14"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Direct">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource OkB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource OkF}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Block">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource RF}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="20,18,20,16">
    <Border DockPanel.Dock="Top" CornerRadius="12" Background="{DynamicResource CardBg}" Padding="12,10,8,10">
      <DockPanel>
        <Button x:Name="CopyEndpointButton" DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="8" FontSize="12.5"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Локальный прокси для программ" FontSize="12" Foreground="{DynamicResource Mu2}"/>
          <TextBlock x:Name="EndpointText" Text="после подключения" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Margin="4,0">
        <Button x:Name="SitesTab" Content="Сайты" Style="{StaticResource Plain}" Height="34" Padding="2,0" FontSize="13.5" Margin="0,0,16,0"/>
        <Button x:Name="AppsTab" Content="Программы" Style="{StaticResource Plain}" Height="34" Padding="2,0" FontSize="13.5"/>
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
      <StackPanel x:Name="SiteInput">
      <!-- Списки: встроенный «Российские сайты напрямую» и маршрутизация сервиса. Категории
           разворачиваются из баз адресов, которые скачиваются по согласию. -->
      <Border CornerRadius="12" Background="{DynamicResource CardBg}" Padding="12,10,12,10" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel>
            <CheckBox x:Name="RussiaDirect" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Российские сайты напрямую"/>
            <StackPanel>
              <TextBlock Text="Российские сайты напрямую" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock Text="Госуслуги, банки, маркетплейсы и почти весь рунет — без VPN" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <!-- zapret в службе (MainWindow.Zapret): сайты из его списков — напрямую через обход DPI. -->
          <DockPanel Margin="0,10,0,0">
            <CheckBox x:Name="ZapretToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="YouTube и Discord без VPN"/>
            <StackPanel>
              <TextBlock Text="YouTube и Discord без VPN" FontSize="13.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="ZapretText" Text="Через обход блокировок zapret: быстрее и не тратит VPN" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
              <Button x:Name="ZapretPick" Content="Подобрать заново" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>
          <DockPanel x:Name="ProviderRoutingRow" Margin="0,10,0,0" Visibility="Collapsed">
            <CheckBox x:Name="ProviderRouting" DockPanel.Dock="Right" Style="{StaticResource Toggle}" AutomationProperties.Name="Маршрутизация сервиса"/>
            <StackPanel>
              <TextBlock x:Name="ProviderRoutingTitle" Text="Правила сервиса" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ProviderRoutingText" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <Button x:Name="GeoButton" DockPanel.Dock="Right" Content="Скачать" Style="{StaticResource BtnLink}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="GeoStatus" Text="Базы адресов не скачаны" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <DockPanel>
        <Button x:Name="AddRuleButton" DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource BtnPrimary}" Height="38" Padding="14,0" o:Ui.CornerRadius="10" FontSize="13" Margin="8,0,0,0"/>
        <TextBox x:Name="RuleDomain" Style="{StaticResource FieldBox}" Height="38" Tag="example.com — с поддоменами" FontSize="13.5" AutomationProperties.Name="Новое правило для сайта"/>
      </DockPanel>
      </StackPanel>
      <!-- Программы выбираются из списка компьютера (AppPicker), а не вписываются именем файла. -->
      <StackPanel x:Name="ProgramInput" Visibility="Collapsed">
        <Button x:Name="ChooseProgramsButton" Style="{StaticResource BtnPrimary}" Height="40" o:Ui.CornerRadius="10" FontSize="13.5">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IcoPlus}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/>
            <TextBlock Text="Выбрать программы" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="ProgramModeNote" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" Margin="2,8,0,0"
                   Text="Действуют в режиме «Весь компьютер»."/>
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom">
      <Border CornerRadius="12" Background="{DynamicResource CardBg}" Padding="12,10" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="Куда пойдёт сайт?" FontSize="12" Foreground="{DynamicResource Mu2}"/>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="WhereResult" DockPanel.Dock="Right" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="WhereInput" Style="{StaticResource FieldBox}" Height="32" Tag="music.youtube.com" FontSize="13" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Проверить, куда пойдёт сайт"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <DockPanel Margin="4,8,0,0">
        <Button x:Name="ValidateRulesButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnLink}" VerticalAlignment="Top"/>
        <TextBlock Text="Нажмите на метку, чтобы сменить действие. Правила программ сильнее правил сайтов; применяются со следующего подключения." Style="{StaticResource Small}" Foreground="{DynamicResource Fa}"/>
      </DockPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
      <Grid>
        <ItemsControl x:Name="RuleList" Focusable="False"/>
        <ItemsControl x:Name="ProgramList" Focusable="False" Visibility="Collapsed"/>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
