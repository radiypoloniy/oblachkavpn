<UserControl x:Class="Oblachka.Views.RulesTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views">
  <!-- Свои правила сайтов и программ: «через VPN», «напрямую», «блокировать». -->
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="RoutingPickers.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="RuleMenuRow" TargetType="Button" BasedOn="{StaticResource MenuRow}">
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="o:Ui.CornerRadius" Value="{StaticResource RadiusLg}"/>
    </Style>
    <DataTemplate DataType="{x:Type o:RuleRow}">
      <Border MinHeight="42" Padding="6,4,2,4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" Tag="delete" Style="{StaticResource SmallIconButton}" Width="30" Height="30" Foreground="{DynamicResource Fa}" AutomationProperties.Name="Удалить правило">
            <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4"/>
          </Button>
          <Button x:Name="Badge" DockPanel.Dock="Right" Tag="cycle" Style="{StaticResource Plain}" Height="26" Padding="10,0" o:Ui.CornerRadius="{StaticResource RadiusLg}" Margin="0,0,6,0"
                  FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Content="{Binding ActionText}" Background="{DynamicResource Aci}" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Сменить действие"/>
          <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RuleText" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsLabel}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Visibility="{Binding SubVisibility}"/>
            <TextBlock Text="{Binding Warning}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding WarningVisibility}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Plain}" Value="True">
          <Setter TargetName="RuleText" Property="FontFamily" Value="{StaticResource UiFont}"/>
          <Setter TargetName="RuleText" Property="FontSize" Value="{StaticResource FsRow}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Direct">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource OkB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource OkF}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Block">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource RF}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate DataType="{x:Type o:ServiceRouteRow}">
      <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <Button Tag="pinned" Style="{StaticResource Row}" Height="Auto" MinHeight="48" Padding="6,7,9,7"
                AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Targets}">
          <DockPanel>
            <Path DockPanel.Dock="Right" Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="8" Height="12"
                  StrokeThickness="1.8" Margin="9,0,0,0"/>
            <Border DockPanel.Dock="Right" Background="{DynamicResource Aci}" CornerRadius="{StaticResource RadiusLg}"
                    MaxWidth="160" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Server}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Ac}" TextTrimming="CharacterEllipsis"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="Status" Text="{Binding Status}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </Button>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Warning}" Value="True"><Setter TargetName="Status" Property="Foreground" Value="{DynamicResource WF}"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- «Правила» — раздел острова (0.16): свои правила для сайтов и программ. Что открывается
       без VPN целиком (YouTube и Discord, рунет) — в «Настройки → Обход блокировок». -->
  <DockPanel Margin="10,0,20,16">
    <DockPanel DockPanel.Dock="Top" Height="60">
      <!-- Правила файлом (RulesFile): перенос и обмен наборами, без ключей и серверов. -->
      <StackPanel x:Name="ImportActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="ImportRules" Style="{StaticResource BtnOutline}" Height="34" Padding="12,0,14,0" Margin="0,0,8,0" AutomationProperties.Name="Импорт правил из файла" ToolTip="Импорт правил из файла">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoUpload}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.2" Margin="0,0,6,0"/><TextBlock x:Name="ImportText" Text="Импорт" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="ExportRules" Style="{StaticResource BtnOutline}" Height="34" Padding="12,0,14,0" AutomationProperties.Name="Экспорт правил в файл" ToolTip="Экспорт правил в файл">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcoTray}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.2" Margin="0,0,6,0"/><TextBlock x:Name="ExportText" Text="Экспорт" VerticalAlignment="Center"/></StackPanel>
        </Button>
      </StackPanel>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Маршрутизация" Style="{StaticResource PageHead}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel>
        <!-- Набор правил (MainWindow.RuleSets): какой включён, через какие серверы, новый с чистого листа, удалить.
             В черновике нового набора — вместо этого «Отмена» и «Сохранить». -->
        <Grid DockPanel.Dock="Top" Margin="10,8,0,6" MinHeight="36">
          <DockPanel x:Name="RuleSetBar">
            <Grid x:Name="CompactServerSlot" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
            <Button x:Name="DeleteRuleSet" DockPanel.Dock="Right" Content="Удалить" Style="{StaticResource BtnGhost}" Height="32" Padding="10,0" Foreground="{DynamicResource RF}" AutomationProperties.Name="Удалить набор"/>
            <Button x:Name="RuleSetButton" DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Padding="11,0" Height="36" AutomationProperties.Name="Набор правил">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Набор" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="RuleSetText" Text="Основной" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                <Path Data="M6,9 L12,15 L18,9" Style="{StaticResource Icon}" Width="11" Height="11" StrokeThickness="2.6" Margin="6,1,0,0"/>
              </StackPanel>
            </Button>
            <Grid x:Name="InlineServerSlot">
            <Button x:Name="RuleSetServers" Style="{StaticResource BtnGhost}" Padding="10,0" Height="36" Margin="6,0,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Серверы набора">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="RuleSetServersText" Text="Серверы: любые" FontSize="{StaticResource FsBody}" Foreground="{DynamicResource Mu}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                <Path Data="M6,9 L12,15 L18,9" Style="{StaticResource Icon}" Width="11" Height="11" StrokeThickness="2.6" Stroke="{DynamicResource Mu}" Margin="6,1,0,0"/>
              </StackPanel>
            </Button>
            </Grid>
          </DockPanel>
          <DockPanel x:Name="RuleSetDraft" Visibility="Collapsed">
            <Button x:Name="SaveRuleSet" DockPanel.Dock="Right" Content="Сохранить" Style="{StaticResource BtnPrimary}" Height="32" Padding="14,0" AutomationProperties.Name="Сохранить новый набор"/>
            <Button x:Name="CancelRuleSet" DockPanel.Dock="Right" Content="Отмена" Style="{StaticResource BtnGhost}" Height="32" Padding="12,0" Margin="0,0,6,0" AutomationProperties.Name="Отменить новый набор"/>
            <TextBlock Text="Новый набор: добавьте сайты и программы, затем сохраните" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
          </DockPanel>
          <Popup x:Name="RuleSetPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=RuleSetButton}">
            <Grid Width="284" Margin="12,6,12,18">
              <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
              <Border Style="{StaticResource MenuCard}" Padding="13">
                <StackPanel>
                  <TextBlock Text="Наборы правил" FontWeight="SemiBold" FontSize="{StaticResource FsLabel}" Margin="9,2,9,8"/>
                  <ScrollViewer MaxHeight="272" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RuleSetItems"/></ScrollViewer>
                  <Button x:Name="NewRuleSet" Content="+  Новый набор" Style="{StaticResource BtnPrimary}" Height="38" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Popup>
          <!-- Серверы набора (MainWindow.RuleSetServers): страны целиком, со всеми протоколами. -->
          <Popup x:Name="RuleSetServersPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=RuleSetServers}">
            <Grid Width="324" Margin="12,6,12,18">
              <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
              <Border Style="{StaticResource MenuCard}" Padding="13">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Margin="9,2,9,8">
                    <TextBlock Text="Серверы набора" FontWeight="SemiBold" FontSize="{StaticResource FsLabel}"/>
                    <TextBlock x:Name="RuleSetServerNote" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                  <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RuleSetServerItems"/></ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </Popup>
        </Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,4,0,0">
        <StackPanel Margin="0,0,4,0">
          <v:QuickRouting x:Name="Quick"/>
          <Border x:Name="TargetEditor" Background="{DynamicResource CardBg}" CornerRadius="{StaticResource RadiusSheet}"
                  Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Button x:Name="ServiceCancel" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Margin="8,0,0,0"
                        AutomationProperties.Name="Закрыть редактор правила">
                  <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2"/>
                </Button>
                <TextBlock x:Name="EditorTitle" FontWeight="SemiBold" FontSize="{StaticResource FsLead}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
              <ComboBox x:Name="ServicePresetPicker" Style="{StaticResource RoutingPicker}" AutomationProperties.Name="Готовый шаблон" Margin="0,0,0,8"/>
              <TextBlock x:Name="ServiceDraftTargets" Style="{StaticResource Small}" TextWrapping="Wrap"/>
              <TextBlock x:Name="ServiceFileNames" Style="{StaticResource Small}" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,4,0,10">
                <Button x:Name="ServiceFiles" Content="Выбрать программы" Style="{StaticResource BtnGhost}" Height="34" Margin="0,0,6,0"/>
                <Button x:Name="ServiceClearFiles" Content="Очистить программы" Style="{StaticResource BtnGhost}" Height="34"/>
              </WrapPanel>
              <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Grid.ColumnSpan" Value="2"/>
                      <Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding Compact, ElementName=Quick}" Value="False"/>
                          <Condition Binding="{Binding Visibility, ElementName=ServiceServerField}" Value="Visible"/>
                        </MultiDataTrigger.Conditions><Setter Property="Grid.ColumnSpan" Value="1"/></MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="Куда направлять" Style="{StaticResource OptTitle}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="ServiceAction" Style="{StaticResource RoutingPicker}" SelectedIndex="0" AutomationProperties.Name="Куда направлять">
                    <ComboBoxItem x:Name="PinnedAction" Content="Конкретный сервер"/>
                    <ComboBoxItem Content="Через VPN"/><ComboBoxItem Content="Напрямую"/><ComboBoxItem Content="Заблокировать"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="ServiceServerField" Visibility="Collapsed">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.ColumnSpan" Value="2"/><Setter Property="Margin" Value="0,8,0,0"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Compact, ElementName=Quick}" Value="False">
                        <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="1"/>
                        <Setter Property="Grid.ColumnSpan" Value="1"/><Setter Property="Margin" Value="10,0,0,0"/>
                      </DataTrigger></Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="VPN-сервер" Style="{StaticResource OptTitle}" Margin="0,0,0,5"/>
                  <ComboBox x:Name="ServiceServerPicker" Style="{StaticResource RoutingPicker}" AutomationProperties.Name="VPN-сервер правила"/>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="ServiceSave" Content="Сохранить правило" Style="{StaticResource BtnPrimary}" Height="36" Padding="12,0" Margin="0,0,6,4"/>
                <Button x:Name="ServiceDelete" Content="Удалить привязку" Style="{StaticResource BtnGhost}" Foreground="{DynamicResource RF}" Height="36" Margin="0,0,0,4"/>
              </WrapPanel>
              <StackPanel x:Name="ServiceSuggestion" Visibility="Collapsed" Margin="0,4,0,0">
                <TextBlock x:Name="ServiceSuggestionText" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button x:Name="ServiceSuggestionAdd" Content="Добавить" Style="{StaticResource BtnSecondary}" Padding="10,0"/>
                  <Button x:Name="ServiceSuggestionDismiss" Content="Скрыть" Style="{StaticResource BtnGhost}"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Сохранённые правила" FontWeight="SemiBold" FontSize="{StaticResource FsLead}" Margin="0,14,0,5"/>
          <Border x:Name="ApplyStatus" Background="{DynamicResource WB}" CornerRadius="{StaticResource RadiusMd}" Padding="12"
                  Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ApplyStatusText" TextWrapping="Wrap" Style="{StaticResource Small}"/>
              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="RetryRules" Content="Повторить применение" Style="{StaticResource BtnGhost}"/>
                <Button x:Name="ReconnectRules" Content="Переподключить VPN" Style="{StaticResource BtnGhost}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border x:Name="ServiceApplyPanel" Background="{DynamicResource CardBg}" CornerRadius="{StaticResource RadiusMd}"
                  Padding="10,8" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ServiceApplyNote" Style="{StaticResource Small}" TextWrapping="Wrap"/>
              <Button x:Name="ServiceApply" Content="Переподключить VPN" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="EmptyRules" Text="Правил пока нет. Найдите программу, вставьте ссылку или выберите шаблон." Style="{StaticResource Small}"
                     Margin="0,6,0,8" TextWrapping="Wrap"/>
          <o:AccessibleItems x:Name="RuleList" Focusable="False" AutomationProperties.Name="Сохранённые правила"/>
          <TextBlock x:Name="RuleHint" Text="Нажмите на метку, чтобы сменить действие. Правила программ имеют приоритет над правилами сайтов."
                     Style="{StaticResource Small}" Foreground="{DynamicResource Fa}" TextWrapping="Wrap" Margin="0,10,0,2"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</UserControl>
