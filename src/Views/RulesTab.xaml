<UserControl x:Class="Oblachka.Views.RulesTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Правила (экран 11): локальный прокси, правила сайтов и программ, «Куда пойдёт сайт?». -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type o:RuleRow}">
      <Border Height="42" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="6,0,2,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Tag="delete" Style="{StaticResource SmallIconButton}" Width="30" Height="30" Foreground="{DynamicResource Fa}" AutomationProperties.Name="Удалить правило">
            <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4"/>
          </Button>
          <Button x:Name="Badge" DockPanel.Dock="Right" Tag="cycle" Style="{StaticResource Plain}" Height="26" Padding="10,0" o:Ui.CornerRadius="13" Margin="0,0,6,0"
                  FontSize="12" FontWeight="SemiBold" Content="{Binding ActionText}" Background="{DynamicResource Aci}" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Сменить действие"/>
          <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Action}" Value="Direct">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource OkB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource OkF}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Block">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource RF}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="20,18,20,16">
    <Border DockPanel.Dock="Top" CornerRadius="12" Background="{DynamicResource CardBg}" Padding="12,10,8,10">
      <DockPanel>
        <Button x:Name="CopyEndpointButton" DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="8" FontSize="12.5"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Локальный прокси для программ" FontSize="12" Foreground="{DynamicResource Mu2}"/>
          <TextBlock x:Name="EndpointText" Text="после подключения" FontFamily="{StaticResource MonoFont}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Margin="4,0">
        <Button x:Name="SitesTab" Content="Сайты" Style="{StaticResource Plain}" Height="34" Padding="2,0" FontSize="13.5" Margin="0,0,16,0"/>
        <Button x:Name="AppsTab" Content="Программы" Style="{StaticResource Plain}" Height="34" Padding="2,0" FontSize="13.5"/>
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
      <DockPanel x:Name="SiteInput">
        <Button x:Name="AddRuleButton" DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource BtnPrimary}" Height="38" Padding="14,0" o:Ui.CornerRadius="10" FontSize="13" Margin="8,0,0,0"/>
        <TextBox x:Name="RuleDomain" Style="{StaticResource FieldBox}" Height="38" Tag="example.com — с поддоменами" FontSize="13.5" AutomationProperties.Name="Новое правило для сайта"/>
      </DockPanel>
      <DockPanel x:Name="ProgramInput" Visibility="Collapsed">
        <Button x:Name="AddProgramButton" DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource BtnPrimary}" Height="38" Padding="14,0" o:Ui.CornerRadius="10" FontSize="13" Margin="8,0,0,0"/>
        <TextBox x:Name="ProgramName" Style="{StaticResource FieldBox}" Height="38" Tag="Имя программы, например steam.exe" FontSize="13.5" AutomationProperties.Name="Новое правило для программы"/>
      </DockPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom">
      <Border CornerRadius="12" Background="{DynamicResource CardBg}" Padding="12,10" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="Куда пойдёт сайт?" FontSize="12" Foreground="{DynamicResource Mu2}"/>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="WhereResult" DockPanel.Dock="Right" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="WhereInput" Style="{StaticResource FieldBox}" Height="32" Tag="music.youtube.com" FontSize="13" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Проверить, куда пойдёт сайт"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <DockPanel Margin="4,8,0,0">
        <Button x:Name="ValidateRulesButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnLink}" VerticalAlignment="Top"/>
        <TextBlock Text="Нажмите на метку, чтобы сменить действие. Правила программ сильнее правил сайтов; применяются со следующего подключения." Style="{StaticResource Small}" Foreground="{DynamicResource Fa}"/>
      </DockPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
      <Grid>
        <ItemsControl x:Name="RuleList" Focusable="False"/>
        <ItemsControl x:Name="ProgramList" Focusable="False" Visibility="Collapsed"/>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
