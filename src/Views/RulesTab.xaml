<UserControl x:Class="Oblachka.Views.RulesTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Свои правила сайтов и программ: «через VPN», «напрямую», «блокировать». -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type o:RuleRow}">
      <Border MinHeight="42" Padding="6,4,2,4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" Tag="delete" Style="{StaticResource SmallIconButton}" Width="30" Height="30" Foreground="{DynamicResource Fa}" AutomationProperties.Name="Удалить правило">
            <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4"/>
          </Button>
          <Button x:Name="Badge" DockPanel.Dock="Right" Tag="cycle" Style="{StaticResource Plain}" Height="26" Padding="10,0" o:Ui.CornerRadius="{StaticResource RadiusLg}" Margin="0,0,6,0"
                  FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Content="{Binding ActionText}" Background="{DynamicResource Aci}" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Сменить действие"/>
          <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,10,0" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RuleText" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsLabel}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Visibility="{Binding SubVisibility}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Plain}" Value="True">
          <Setter TargetName="RuleText" Property="FontFamily" Value="{StaticResource UiFont}"/>
          <Setter TargetName="RuleText" Property="FontSize" Value="{StaticResource FsRow}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Direct">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource OkB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource OkF}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Block">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RB}"/>
          <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource RF}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- «Правила» — раздел острова (0.16): свои правила для сайтов и программ. Что открывается
       без VPN целиком (YouTube и Discord, рунет) — в «Настройки → Обход блокировок». -->
  <DockPanel Margin="10,0,20,16">
    <DockPanel DockPanel.Dock="Top" Height="64">
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Правила" Style="{StaticResource Brand}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Margin="10,4,0,0">
      <StackPanel Orientation="Horizontal" Margin="4,0">
        <Button x:Name="SitesTab" Content="Сайты" Style="{StaticResource Plain}" Height="34" Padding="2,0" FontSize="{StaticResource FsLabel}" Margin="0,0,16,0"/>
        <Button x:Name="AppsTab" Content="Программы" Style="{StaticResource Plain}" Height="34" Padding="2,0" FontSize="{StaticResource FsLabel}"/>
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Top" Margin="10,10,0,0">
      <StackPanel x:Name="SiteInput">
        <DockPanel>
          <Button x:Name="AddRuleButton" DockPanel.Dock="Right" Content="Добавить" Style="{StaticResource BtnPrimary}" Height="38" Padding="14,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}" Margin="8,0,0,0"/>
          <TextBox x:Name="RuleDomain" Style="{StaticResource FieldBox}" Height="38" Tag="example.com — с поддоменами" FontSize="{StaticResource FsLabel}" AutomationProperties.Name="Новое правило для сайта"/>
        </DockPanel>
      </StackPanel>
      <!-- Программы выбираются из списка компьютера (AppPicker), а не вписываются именем файла. -->
      <StackPanel x:Name="ProgramInput" Visibility="Collapsed">
        <Button x:Name="ChooseProgramsButton" Style="{StaticResource BtnPrimary}" Height="40" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsLabel}">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource IcoPlus}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/>
            <TextBlock Text="Выбрать программы" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="LiveButton" Content="Сейчас в сети" Style="{StaticResource BtnSecondary}" Height="36" Margin="0,8,0,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsLabel}"
                AutomationProperties.Name="Программы, которые сейчас в сети"/>
        <TextBlock x:Name="ProgramModeNote" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" Margin="2,8,0,0"
                   Text="Действуют в режиме «Весь компьютер»."/>
      </StackPanel>
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Text="Нажмите на метку, чтобы сменить действие. Программа сильнее сайта." Style="{StaticResource Small}" Foreground="{DynamicResource Fa}" TextWrapping="Wrap" Margin="14,8,0,0"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,4,0,0">
      <Grid>
        <o:AccessibleItems x:Name="RuleList" Focusable="False"/>
        <o:AccessibleItems x:Name="ProgramList" Focusable="False" Visibility="Collapsed"/>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
