<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RoutePilot.Views.ConnectionView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28,28,28,20" MaxWidth="560" HorizontalAlignment="Center">
      <StackPanel>
        <Border x:Name="StatusBadge" Background="#F0F2F6" CornerRadius="18" Padding="16,8" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#8995A7" Margin="0,0,9,0"/>
            <TextBlock x:Name="StatusText" Text="Не подключено" FontSize="15" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="Headline" Text="Туннель выключен" FontSize="36" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,8"/>
        <TextBlock x:Name="Subtitle" Text="Выбери подключение и включи туннель" Style="{StaticResource MutedText}" FontSize="15" TextAlignment="Center"/>
        <Grid HorizontalAlignment="Center" Margin="0,28,0,26">
          <Button x:Name="ConnectButton" Style="{StaticResource Power}" HorizontalContentAlignment="Left" Foreground="#8A96A8" IsEnabled="False" AutomationProperties.Name="Включить туннель" ToolTip="Запустить выбранное подключение"/>
          <Button x:Name="StopButton" Style="{StaticResource Power}" HorizontalContentAlignment="Right" Foreground="#0D9267" Background="{StaticResource Green}" IsEnabled="False" Visibility="Collapsed" AutomationProperties.Name="Остановить туннель" ToolTip="Остановить подключение или отменить операцию"/>
        </Grid>
        <UniformGrid x:Name="Statistics" Columns="3" Margin="0,0,0,14" Visibility="Collapsed">
          <Border Background="#F5F6F8" CornerRadius="14" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Время" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="SessionTime" Text="0:00:00" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border Background="#F5F6F8" CornerRadius="14" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Запрос" Style="{StaticResource MutedText}"/>
              <TextBlock x:Name="RequestTime" Text="Не проверен" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border Background="#F5F6F8" CornerRadius="14" Padding="14">
            <StackPanel>
              <TextBlock Text="Получено" Style="{StaticResource MutedText}"/>
              <TextBlock Text="Не измеряем" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Margin="16,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Background="#F0F2F6" CornerRadius="12" Height="44" Width="44">
                <Path Data="{StaticResource GlobeIcon}" Stroke="{StaticResource Ink}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0">
                <TextBlock x:Name="ProfileNameText" Text="Добавь подключение" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TransportText" Style="{StaticResource MutedText}" Text="Подписка, ключ или файл" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="ChangeServerButton" Grid.Column="2" Style="{StaticResource Quiet}" Content="Сменить" Padding="8"/>
            </Grid>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="82,0,0,0"/>
            <Button x:Name="RoutesButton" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="16,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="#F0F2F6" CornerRadius="12" Height="44" Width="44">
                  <Path Data="{StaticResource RouteIcon}" Stroke="{StaticResource Ink}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0">
                  <TextBlock x:Name="ModeTitle" Text="Только через туннель" FontWeight="SemiBold" FontSize="15"/>
                  <TextBlock x:Name="ModeSubtitle" Text="Программы с настроенным SOCKS5" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource Muted}" FontSize="26" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </Border>
        <Button x:Name="CheckTunnelButton" Content="Проверить туннель" Style="{StaticResource Quiet}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="ModeNote" Text="Сейчас туннель используют программы с настроенным SOCKS5. Остальные подключения компьютера не меняются." Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
