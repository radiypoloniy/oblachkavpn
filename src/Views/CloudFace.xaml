<UserControl x:Class="Oblachka.Views.CloudFace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="32" IsHitTestVisible="False" Focusable="False">
  <!-- Облачко в карточке статуса (облик 0.20): лицо — состояние подключения. Спит — выключено,
       ждёт — подключаемся, улыбается — защищено, тревожится — связи нет. Рисунок 48×32. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="48" Height="32">
      <Path x:Name="Body" Data="M6,32 C0,32 0,20 8,20 C8,10 20,8 24,14 C28,4 42,6 42,18 C48,18 48,32 42,32 Z" Fill="{DynamicResource NightCloud}"/>
      <Canvas x:Name="Sleep">
        <Path Data="M17,23.5 q2,2 4,0 M27,23.5 q2,2 4,0 M22.5,28.5 q1.5,1 3,0" Stroke="{DynamicResource NightInk}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Canvas x:Name="Wait" Visibility="Collapsed">
        <Ellipse Canvas.Left="17.4" Canvas.Top="22.9" Width="3.2" Height="3.2" Fill="{DynamicResource CloudFace}"/>
        <Ellipse Canvas.Left="27.4" Canvas.Top="22.9" Width="3.2" Height="3.2" Fill="{DynamicResource CloudFace}"/>
        <Path Data="M22,28.5 h4" Stroke="{DynamicResource CloudFace}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Canvas>
      <Canvas x:Name="Happy" Visibility="Collapsed">
        <Path Data="M17,24 q2,-2.5 4,0 M27,24 q2,-2.5 4,0" Stroke="{DynamicResource CloudFace}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Path Data="M20.5,27 h7 q-0.4,3.6 -3.5,3.6 q-3.1,0 -3.5,-3.6 z" Fill="{DynamicResource CloudFace}"/>
        <Ellipse Canvas.Left="12.8" Canvas.Top="25.8" Width="3.4" Height="3.4" Fill="{DynamicResource Blush}"/>
        <Ellipse Canvas.Left="31.8" Canvas.Top="25.8" Width="3.4" Height="3.4" Fill="{DynamicResource Blush}"/>
      </Canvas>
      <Canvas x:Name="Worried" Visibility="Collapsed">
        <Path Data="M16,21.5 l4,-1.4 M32,21.5 l-4,-1.4 M20,29 q1,-1.4 2,0 q1,1.4 2,0 q1,-1.4 2,0 q1,1.4 2,0" Stroke="{DynamicResource CloudFace}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse Canvas.Left="17.4" Canvas.Top="22.9" Width="3.2" Height="3.2" Fill="{DynamicResource CloudFace}"/>
        <Ellipse Canvas.Left="27.4" Canvas.Top="22.9" Width="3.2" Height="3.2" Fill="{DynamicResource CloudFace}"/>
        <Path Data="M38,14 q2.4,3.4 0,5.2 q-2.4,-1.8 0,-5.2 z" Fill="{DynamicResource CloudWhite}"/>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
