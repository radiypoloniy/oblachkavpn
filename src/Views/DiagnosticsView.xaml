<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="RoutePilot.Views.DiagnosticsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="Heading" Text="Проверим подключение" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="LastCheck" Text="Проверка ещё не выполнялась" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel Margin="0,0,0,16">
              <TextBlock x:Name="CoreState" DockPanel.Dock="Right" Text="Не запущен" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="Локальный прокси" FontWeight="SemiBold"/>
            </DockPanel>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16">
              <DockPanel>
                <TextBlock x:Name="TunnelState" DockPanel.Dock="Right" Text="Не проверен" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="Запрос через туннель"/>
              </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,16">
              <TextBlock Text="DNS и IPv6 компьютера не проверялись" Style="{StaticResource MutedText}"/>
            </Border>
            <TextBlock Text="Эта версия не меняет системные маршруты. Проверка относится только к запросу через SOCKS5." Style="{StaticResource MutedText}" FontSize="13"/>
          </StackPanel>
        </Border>
        <TextBox x:Name="ProbeUrl" Text="https://www.gstatic.com/generate_204" Margin="0,20,0,10" AutomationProperties.Name="HTTPS-адрес проверки" ToolTip="Сайт проверки получит запрос через выбранный сервер"/>
        <WrapPanel>
          <Button x:Name="ProbeButton" Content="Проверить снова" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,0,8,8"/>
          <Button x:Name="FindRouteButton" Content="Подобрать рабочий сервер" IsEnabled="False" Margin="0,0,0,8"/>
        </WrapPanel>
        <Button x:Name="ReconnectButton" Content="Переподключить" IsEnabled="False" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="0,4,0,16"/>
        <Border Background="#F5F6F8" CornerRadius="16" Padding="20" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="Нужна помощь?" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Сохрани отчёт без ключей, адресов серверов и истории сайтов." Style="{StaticResource MutedText}" Margin="0,8,0,14"/>
            <Button x:Name="ExportButton" Content="Сохранить отчёт" Background="White" BorderBrush="{StaticResource Line}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="События сессии" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,20"/>
        <TextBlock x:Name="EventText" Text="Подключение ещё не запускалось" Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
        <ItemsControl x:Name="EventList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource Muted}" FontSize="13"/>
                  <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="14"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
