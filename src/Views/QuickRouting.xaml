<UserControl x:Class="Oblachka.Views.QuickRouting" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:o="clr-namespace:Oblachka">
  <StackPanel>
    <TextBox x:Name="Query" Style="{StaticResource FieldBox}" Height="40" FontSize="{StaticResource FsLabel}"
             Tag="Найти программу или вставить ссылку…" AutomationProperties.Name="Найти программу или вставить ссылку"/>
    <StackPanel x:Name="SiteResult" Visibility="Collapsed" Margin="0,6,0,0">
      <TextBlock x:Name="SiteName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <WrapPanel Margin="0,4,0,0">
        <Button x:Name="AddDirect" Content="Напрямую" Style="{StaticResource BtnOutline}" Height="30" Margin="0,0,6,0"/>
        <Button x:Name="AddVpn" Content="Через VPN" Style="{StaticResource BtnSecondary}" Height="30" Margin="0,0,6,0"/>
        <Button x:Name="SiteMore" Content="⋯" AutomationProperties.Name="Другие маршруты сайта" Style="{StaticResource BtnGhost}" Height="30"/>
      </WrapPanel>
    </StackPanel>
    <ScrollViewer MaxHeight="235" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
      <ItemsControl x:Name="Apps">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,5">
              <StackPanel>
                <DockPanel>
                  <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel Margin="28,4,0,0">
                  <Button Tag="direct" Content="Напрямую" Style="{StaticResource BtnOutline}" Height="30" Margin="0,0,6,0"/>
                  <Button Tag="vpn" Content="Через VPN" Style="{StaticResource BtnSecondary}" Height="30" Margin="0,0,6,0"/>
                  <Button Tag="more" Content="⋯" AutomationProperties.Name="Другие маршруты программы" Style="{StaticResource BtnGhost}" Height="30"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="ResultNote" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="Collapsed"/>
    <WrapPanel Margin="0,6,0,0">
      <Button x:Name="Templates" Content="Готовые шаблоны ›" Style="{StaticResource BtnGhost}" Height="32" Margin="0,0,6,0"/>
      <Button x:Name="Browse" Content="Все программы" Style="{StaticResource BtnGhost}" Height="32"/>
    </WrapPanel>
    <TextBlock Text="Сохранённые правила" FontWeight="SemiBold" FontSize="{StaticResource FsLabel}" Margin="0,10,0,2"/>
    <StackPanel x:Name="Suggestion" Visibility="Collapsed" Margin="0,4,0,0">
      <TextBlock x:Name="SuggestionText" Style="{StaticResource Small}" TextWrapping="Wrap"/>
      <WrapPanel><Button x:Name="SuggestionAdd" Content="Добавить" Style="{StaticResource BtnSecondary}"/>
        <Button x:Name="SuggestionDismiss" Content="Скрыть" Style="{StaticResource BtnGhost}"/></WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
