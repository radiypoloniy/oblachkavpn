<UserControl x:Class="Oblachka.Views.AdvancedPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Подключение (0.16): что идёт через VPN, сервер, запуск. Редкое — обход DPI,
       локальный прокси, «куда пойдёт сайт» — свёрнуто в «Ещё». -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,0,20,16">
      <TextBlock Text="ЧТО ИДЁТ ЧЕРЕЗ VPN" Style="{StaticResource SetCaption}" Margin="8,4,8,6"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <Button x:Name="ModeTun" Style="{StaticResource SetNavRow}" AutomationProperties.Name="Весь компьютер">
            <DockPanel>
              <Ellipse x:Name="ModeTunRadio" DockPanel.Dock="Right" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" VerticalAlignment="Center"/>
              <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcBlue}"><Path Data="{StaticResource IcoGlobe}" Style="{StaticResource SetGlyph}"/></Border>
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Весь компьютер" Style="{StaticResource SetTitle}"/>
                <TextBlock x:Name="SystemTunnelHint" Text="Игры, мессенджеры и любые программы. Без VPN — без интернета." Style="{StaticResource SetSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button x:Name="ModeProxy" Style="{StaticResource SetNavRow}" AutomationProperties.Name="Браузеры и программы">
            <DockPanel>
              <Ellipse x:Name="ModeProxyRadio" DockPanel.Dock="Right" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" VerticalAlignment="Center"/>
              <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGray}"><Path Data="{StaticResource IcoApp}" Style="{StaticResource SetGlyph}"/></Border>
              <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Браузеры и программы" Style="{StaticResource SetTitle}"/>
                <TextBlock Text="Прокси Windows: без прав администратора, но не для всех приложений. Браузер может показать сайтам настоящий IP через WebRTC" TextWrapping="Wrap" Style="{StaticResource SetSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SetGroup}" Margin="0,8,0,0">
        <DockPanel Style="{StaticResource SetLine}">
          <CheckBox x:Name="LocalNetwork" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Локальная сеть напрямую"/>
          <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcTeal}"><Path Data="{StaticResource IcoRoute}" Style="{StaticResource SetGlyph}"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Локальная сеть напрямую" Style="{StaticResource SetTitle}"/>
            <TextBlock Text="Принтер, NAS, телевизор и роутер в «Весь компьютер». Сработает со следующего подключения" Style="{StaticResource SetSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource SetGroup}" Margin="0,8,0,0">
        <DockPanel Style="{StaticResource SetLine}">
          <CheckBox x:Name="QuicOverTcp" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="QUIC через TCP"/>
          <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcOrange}"><Path Data="{StaticResource IcoPlay}" Style="{StaticResource SetGlyph}"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QUIC через TCP" Style="{StaticResource SetTitle}"/>
            <TextBlock Text="Если видео через VPN тормозит или рвётся: браузеры перейдут с QUIC на обычный TCP. В «Весь компьютер», со следующего подключения" TextWrapping="Wrap" Style="{StaticResource SetSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource SetGroup}" Margin="0,8,0,0">
        <DockPanel Style="{StaticResource SetLine}">
          <CheckBox x:Name="CompatibleStack" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Совместимость с играми"/>
          <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcPurple}"><Path Data="{StaticResource IcoGame}" Style="{StaticResource SetGlyph}"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Совместимость с играми" Style="{StaticResource SetTitle}"/>
            <TextBlock Text="Если игра раз в минуту теряет связь с сервером: туннель работает как в Throne — ровнее, но на быстрых каналах медленнее. В «Весь компьютер», со следующего подключения" TextWrapping="Wrap" Style="{StaticResource SetSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <TextBlock x:Name="SystemTunnelNote" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="10,6,10,0"/>
      <Button x:Name="RestoreNetwork" Content="Восстановить сеть" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" Padding="14,0" HorizontalAlignment="Left" Margin="10,8,0,0" Visibility="Collapsed"/>

      <TextBlock Text="СЕРВЕР" Style="{StaticResource SetCaption}"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <Button x:Name="OpenAutoPool" Style="{StaticResource SetNavRow}" AutomationProperties.Name="Серверы автовыбора">
            <DockPanel>
              <Path Style="{StaticResource SetChevron}"/>
              <TextBlock x:Name="AutoPoolSummary" Style="{StaticResource SetValue}"/>
              <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcOrange}"><Path Data="{StaticResource IcoBolt}" Style="{StaticResource SetGlyph}"/></Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Автовыбор" Style="{StaticResource SetTitle}"/>
                <TextBlock Text="Самый быстрый из отмеченных серверов" Style="{StaticResource SetSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="AutoRecover" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Переключать сервер при обрыве"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcTeal}"><Path Data="{StaticResource IcoSwap}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Сервер упал — переключить" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Проверяем связь и находим рабочий сервер" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="ЗАПУСК" Style="{StaticResource SetCaption}"/>
      <Border Style="{StaticResource SetGroup}">
        <StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Запускать вместе с Windows"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGray}"><Path Data="{StaticResource IcoPower}" Style="{StaticResource SetGlyph}"/></Border>
            <TextBlock Text="Запускать вместе с Windows" Style="{StaticResource SetTitle}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="ConnectOnLaunch" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Подключаться при запуске"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGreen}"><Path Data="{StaticResource IcoPlay}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Подключаться при запуске" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Если VPN был включён, когда вы выключили компьютер или закрыли Облачку" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- «Ещё» — то, что нужно одному из ста. -->
      <Expander Margin="0,14,0,0" Foreground="{DynamicResource Mu}" FontSize="{StaticResource FsLabel}" Header="Ещё" AutomationProperties.Name="Ещё настройки подключения">
        <StackPanel Margin="0,8,0,0">
          <Border Style="{StaticResource SetGroup}">
            <StackPanel>
              <!-- Обход DPI (TlsFragment): «Авто» — пробуем, когда обычное подключение не проходит. -->
              <DockPanel Style="{StaticResource SetLine}">
                <Border DockPanel.Dock="Right" Height="32" CornerRadius="{StaticResource RadiusSeg}" Background="{DynamicResource Field}" Padding="3" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="DpiAuto" Content="Авто" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
                    <Button x:Name="DpiAlways" Content="Всегда" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}" Margin="2,0"/>
                    <Button x:Name="DpiOff" Content="Выкл." Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcPurple}"><Path Data="{StaticResource IcoShield}" Style="{StaticResource SetGlyph}"/></Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="Обход DPI" Style="{StaticResource SetTitle}"/>
                  <TextBlock x:Name="DpiNote" Text="Режем рукопожатие с сервером, если фильтр его обрывает. Это не zapret." Style="{StaticResource SetSub}"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Style="{StaticResource SetLine}">
                <Button x:Name="CopyEndpointButton" DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="{StaticResource RadiusSm}" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGray}"><Path Data="{StaticResource IcoCode}" Style="{StaticResource SetGlyph}"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Локальный прокси для программ" Style="{StaticResource SetTitle}"/>
                  <TextBlock x:Name="EndpointText" Text="после подключения" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
              <StackPanel Margin="12,8,12,10">
                <TextBlock Text="Куда пойдёт сайт?" Style="{StaticResource SetTitle}"/>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="WhereResult" DockPanel.Dock="Right" FontSize="{StaticResource FsBody}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                  <TextBox x:Name="WhereInput" Style="{StaticResource FieldBox}" Height="32" Tag="music.youtube.com" FontSize="{StaticResource FsBody}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Проверить, куда пойдёт сайт"/>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- Базы адресов скачиваются сами, проверка правил — для разработки: на экране их нет. -->
          <StackPanel Visibility="Collapsed">
            <Button x:Name="GeoButton" Content="Скачать"/>
            <TextBlock x:Name="GeoStatus"/>
            <Button x:Name="ValidateRulesButton" Content="Проверить правила"/>
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
