<UserControl x:Class="Oblachka.Views.AdvancedPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Для продвинутых: то, что нужно одному из ста, — режим, обход DPI, трей, локальный прокси,
       базы адресов и проверка «куда пойдёт сайт». -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,6,20,16">
      <TextBlock Text="ЧТО ИДЁТ ЧЕРЕЗ VPN" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,4,6,6"/>
      <Button x:Name="ModeTun" Style="{StaticResource Row}" Height="Auto" Padding="12,12" AutomationProperties.Name="Весь компьютер">
        <DockPanel>
          <Ellipse x:Name="ModeTunRadio" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock Text="Весь компьютер" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
            <TextBlock x:Name="SystemTunnelHint" Text="Игры, мессенджеры и любые программы. Без VPN — без интернета." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <Button x:Name="ModeProxy" Style="{StaticResource Row}" Height="Auto" Padding="12,12" Margin="0,2,0,0" AutomationProperties.Name="Браузеры и программы">
        <DockPanel>
          <Ellipse x:Name="ModeProxyRadio" Width="18" Height="18" Stroke="{DynamicResource Ring}" StrokeThickness="1.5" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock Text="Браузеры и программы" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
            <TextBlock Text="Прокси Windows. Без прав администратора, но не для всех приложений." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <TextBlock x:Name="SystemTunnelNote" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="10,6,10,0"/>
      <Button x:Name="RestoreNetwork" Content="Восстановить сеть" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusSeg}" Padding="14,0" HorizontalAlignment="Left" Margin="10,8,0,0" Visibility="Collapsed"/>

      <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,20,6,4"/>
      <!-- Обход DPI (TlsFragment): «Авто» — пробуем, когда обычное подключение не проходит. -->
      <DockPanel Margin="12,10,6,4">
        <Border DockPanel.Dock="Right" Height="32" CornerRadius="{StaticResource RadiusSeg}" Background="{DynamicResource Field}" Padding="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="DpiAuto" Content="Авто" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
            <Button x:Name="DpiAlways" Content="Всегда" Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}" Margin="2,0"/>
            <Button x:Name="DpiOff" Content="Выкл." Style="{StaticResource Plain}" Padding="10,0" FontSize="{StaticResource FsNote}" o:Ui.CornerRadius="{StaticResource RadiusInner}"/>
          </StackPanel>
        </Border>
        <StackPanel>
          <TextBlock Text="Обход DPI" FontSize="{StaticResource FsRow}"/>
          <TextBlock x:Name="DpiNote" Text="Режем рукопожатие с сервером, если фильтр его обрывает. Это не zapret." Style="{StaticResource Small}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
      <Border CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource CardBg}" Padding="12,10,8,10" Margin="0,12,0,0">
        <DockPanel>
          <Button x:Name="CopyEndpointButton" DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource BtnOutline}" Height="32" Padding="12,0" o:Ui.CornerRadius="{StaticResource RadiusSm}" FontSize="{StaticResource FsBody}"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Локальный прокси для программ" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}"/>
            <TextBlock x:Name="EndpointText" Text="после подключения" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="ПРАВИЛА И СПИСКИ" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,20,6,4"/>
      <DockPanel Margin="12,6,6,6">
        <Button x:Name="GeoButton" DockPanel.Dock="Right" Content="Скачать" Style="{StaticResource BtnLink}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <StackPanel>
          <TextBlock Text="Базы адресов" FontSize="{StaticResource FsRow}"/>
          <TextBlock x:Name="GeoStatus" Text="Базы адресов не скачаны" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
      <Border CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource CardBg}" Padding="12,10" Margin="0,8,0,0">
        <StackPanel>
          <DockPanel>
            <Button x:Name="ValidateRulesButton" DockPanel.Dock="Right" Content="Проверить правила" Style="{StaticResource BtnLink}"/>
            <TextBlock Text="Куда пойдёт сайт?" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="WhereResult" DockPanel.Dock="Right" FontSize="{StaticResource FsBody}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="WhereInput" Style="{StaticResource FieldBox}" Height="32" Tag="music.youtube.com" FontSize="{StaticResource FsBody}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Проверить, куда пойдёт сайт"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource Caption}" FontSize="{StaticResource FsCaption}" Margin="6,20,6,4"/>
      <DockPanel Margin="12,9,6,9">
        <CheckBox x:Name="StayInTray" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Крестик сворачивает в трей"/>
        <TextBlock Text="Крестик сворачивает в трей" FontSize="{StaticResource FsRow}" VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
