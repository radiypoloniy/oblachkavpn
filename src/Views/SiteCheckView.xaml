<UserControl x:Class="Oblachka.Views.SiteCheckView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- «Почему не открывается сайт?»: сайт проверяется напрямую и через VPN, итог — человеческим языком и правилом в один клик. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="10,0,96,0">
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Не открывается сайт?" Style="{StaticResource Brand}" Margin="4,0,0,0"/>
    </DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
      <StackPanel>
        <TextBlock Text="Проверим сайт напрямую и через VPN и скажем, что мешает: блокировка провайдера, фильтр DPI, сам сайт или он не пускает из-за границы." FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" LineHeight="17" Margin="2,0,2,12"/>
        <DockPanel>
          <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource BtnPrimary}" Height="40" Padding="18,0" Margin="8,0,0,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}"/>
          <TextBox x:Name="SiteInput" Style="{StaticResource FieldBox}" Height="40" Tag="например, chatgpt.com" FontSize="{StaticResource FsBody}" AutomationProperties.Name="Адрес сайта"/>
        </DockPanel>
        <TextBlock x:Name="Progress" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" Margin="2,10,2,0" Visibility="Collapsed"/>
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,14,0,0">
          <Border x:Name="VerdictCard" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource NB}" Padding="14,12">
            <StackPanel>
              <TextBlock x:Name="VerdictTitle" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="VerdictText" FontSize="{StaticResource FsNote}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource CardBg}" Padding="14,6" Margin="0,8,0,0">
            <StackPanel>
              <DockPanel Height="34">
                <TextBlock x:Name="DirectResult" DockPanel.Dock="Right" FontSize="{StaticResource FsNote}" VerticalAlignment="Center"/>
                <TextBlock Text="Напрямую" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Height="34">
                <TextBlock x:Name="VpnResult" DockPanel.Dock="Right" FontSize="{StaticResource FsNote}" VerticalAlignment="Center"/>
                <TextBlock x:Name="VpnLabel" Text="Через VPN" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <DockPanel Height="34">
                <TextBlock x:Name="RouteResult" DockPanel.Dock="Right" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
                <TextBlock Text="Сейчас идёт" FontSize="{StaticResource FsLabel}" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Button x:Name="SuggestButton" Style="{StaticResource BtnPrimary}" Height="42" Margin="0,10,0,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" Visibility="Collapsed"/>
          <TextBlock x:Name="SuggestNote" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" Margin="2,6,2,0" Visibility="Collapsed"
                     Text="Правило появится в «Настройки → Без VPN → Свои правила», там его можно поменять или удалить."/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
