<UserControl x:Class="Oblachka.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Oblachka.Views" xmlns:o="clr-namespace:Oblachka" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="Transparent">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Строка заголовка: значок и название; за неё окно перетаскивается. -->
    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
      <Path Data="M6,32 C0,32 0,20 8,20 C8,10 20,8 24,14 C28,4 42,6 42,18 C48,18 48,32 42,32 Z" Width="22" Height="15" Stretch="Uniform" Fill="{DynamicResource Ac}" Margin="0,0,8,0"/>
      <TextBlock Text="облачка" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0" Focusable="False" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- Карточка статуса. Цвет и лицо облачка задаёт MainWindow.ApplyStatusLook. -->
        <Border x:Name="StatusCard" CornerRadius="{StaticResource RadiusSky}" Background="{DynamicResource Night}" Padding="10,9,10,10"
                BorderBrush="{DynamicResource StatusSheen}" BorderThickness="0,1,0,0">
          <StackPanel>
            <DockPanel Margin="2,0">
              <v:PowerSwitch x:Name="Power" DockPanel.Dock="Right" Margin="6,0,-2,0" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <v:CloudFace x:Name="Face" Width="29" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="VPN" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, ElementName=StatusSub}"/>
                </StackPanel>
                <DockPanel Margin="0,2,0,0">
                  <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Fa}" VerticalAlignment="Center" Margin="0,2,8,0" Visibility="Collapsed"/>
                  <TextBlock x:Name="StatusTitle" Text="Выключено" FontSize="{StaticResource FsDisplayStatus}" FontWeight="Bold"
                             Foreground="{DynamicResource CloudWhite}" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="StatusSub" Text="Нажмите, чтобы защитить" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource NightMu}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="2,2,2,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <!-- Строка сервера: нажатие открывает «Серверы». -->
            <Grid x:Name="ServerSection" Margin="0,8,0,0">
              <Button x:Name="ServerCard" Style="{StaticResource GlassRow}" AutomationProperties.Name="Сервер">
                <DockPanel>
                  <Path DockPanel.Dock="Right" Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="9" Height="12" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="6,0,0,0"/>
                  <TextBlock x:Name="ServerPing" DockPanel.Dock="Right" FontSize="{StaticResource FsBody}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <Border Visibility="Collapsed"><Image x:Name="ServerFlag"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ServerName" FontSize="{StaticResource FsBody}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ServerNote" FontSize="{StaticResource FsSmall}" Opacity="0.85" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Button>
            </Grid>
            <!-- Пауза: VPN выключается на время и включается сам (MainWindow.Pause). -->
            <Button x:Name="PauseButton" Style="{StaticResource GlassRow}" Height="32" Padding="12,0" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="Collapsed" AutomationProperties.Name="Пауза VPN">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="PauseIcon" Data="{StaticResource IcoPause}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PauseText" Text="Пауза" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Popup x:Name="PausePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=PauseButton}">
              <Grid Width="200" Margin="12,4,12,18">
                <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
                <Border Style="{StaticResource MenuCard}" Padding="14,6"><StackPanel x:Name="PauseItems"/></Border>
              </Grid>
            </Popup>
            <v:ServiceRouteSummary x:Name="ServiceSummary" Foreground="{Binding Foreground, ElementName=StatusTitle}" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <!-- Проверка связи и «что идёт мимо VPN» показывают карточка сервера и карточка обхода;
             старые чипы остаются для кода состояния, но не видны. -->
        <StackPanel Visibility="Collapsed">
          <Border x:Name="CheckChip">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="CheckIcon" Data="{StaticResource IcoCheck}" Visibility="Collapsed"/>
              <TextBlock x:Name="CheckText"/>
            </StackPanel>
          </Border>
          <Button x:Name="DirectChip"><TextBlock x:Name="DirectChipText"/></Button>
          <ItemsControl x:Name="QuickList" ItemTemplate="{StaticResource ServerRowTemplate}"/>
          <Button x:Name="ModeButton"><TextBlock x:Name="ModeText" Text="Весь компьютер"/></Button>
        </StackPanel>

        <Border x:Name="SubWarn" Margin="0,8,0,0" Padding="6" Background="{DynamicResource Bg}" CornerRadius="{StaticResource RadiusLg}" Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="SubWarnHide" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Width="28" Height="30"
                    VerticalAlignment="Center" Foreground="{DynamicResource Mu2}" ToolTip="Скрыть напоминание" AutomationProperties.Name="Скрыть напоминание">
              <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="11" Height="11" StrokeThickness="2"/>
            </Button>
            <Border DockPanel.Dock="Left" Width="44" Height="40" Margin="2,0,4,0" Background="{DynamicResource Clear}" CornerRadius="{StaticResource RadiusMd}" VerticalAlignment="Center">
              <v:CloudFace x:Name="SubWarnCloud" Width="34" Height="24"/>
            </Border>
            <Button x:Name="SubWarnAction" Style="{StaticResource Row}" o:Ui.CornerRadius="{StaticResource RadiusMd}" Padding="8,6">
              <DockPanel>
                <Path DockPanel.Dock="Right" Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="8" Height="10" Margin="8,0,0,0"/>
                <StackPanel>
                  <TextBlock x:Name="SubWarnTitle" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="SubWarnLabel" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Button>
          </DockPanel>
        </Border>
        <Border x:Name="FreeWarn" Margin="0,10,0,0" Padding="12,10" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource WB}" Visibility="Collapsed">
          <TextBlock Text="Чужой сервер. Его владелец видит, какие сайты вы открываете." FontSize="{StaticResource FsNote}" Foreground="{DynamicResource WF}" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="ForeignCard" Margin="0,10,0,0" Padding="14" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource WB}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="ForeignTitle" FontSize="{StaticResource FsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource Tx}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ForeignText" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="17"/>
            <Button x:Name="ForeignRetry" Content="Проверить снова" Style="{StaticResource BtnPrimary}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}" Margin="0,10,0,0"/>
            <Button x:Name="ForeignProxy" Content="Только браузеры" Style="{StaticResource BtnOutline}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource WL}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="RecoveryCard" Margin="0,10,0,0" Visibility="Collapsed">
          <Border CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Bg}" Padding="12,6">
            <StackPanel>
              <DockPanel MinHeight="32">
                <TextBlock x:Name="RecoveryRounds" DockPanel.Dock="Right" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
                <TextBlock Text="Два сайта не ответили" FontSize="{StaticResource FsNote}" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel MinHeight="32">
                <Ellipse x:Name="RecoverySpinner" Width="18" Height="18" Stroke="{DynamicResource Ac}" StrokeThickness="2" StrokeDashArray="8 4" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform x:Name="RecoverySpin"/></Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="RecoveryStep" Text="Ищем рабочий сервер" FontSize="{StaticResource FsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <DockPanel x:Name="RecoveryLockRow" MinHeight="32">
                <Path Data="{StaticResource IcoLock}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Mu}" StrokeThickness="2" Margin="0,0,10,0"/>
                <TextBlock Text="Пока переключаемся, мимо VPN ничего не уходит" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Button x:Name="RecoveryStop" Content="Остановить" Style="{StaticResource BtnSecondary}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}" Margin="0,8,0,0"/>
        </StackPanel>
        <Border x:Name="ClosedCard" Margin="0,10,0,0" Padding="14" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource EB}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="ClosedText" Text="Не удалось найти рабочий сервер. Ничего не утекло мимо туннеля, но и сайты сейчас не открываются." FontSize="{StaticResource FsNote}" Foreground="{DynamicResource EF}" TextWrapping="Wrap" LineHeight="17"/>
            <Button x:Name="ClosedPick" Content="Выбрать другой сервер" Style="{StaticResource BtnPrimary}" Height="34" o:Ui.CornerRadius="{StaticResource RadiusMd}" FontSize="{StaticResource FsBody}" Margin="0,10,0,0"/>
            <Button x:Name="ClosedOff" Style="{StaticResource BtnOutline}" Height="Auto" MinHeight="34" Padding="8,6" o:Ui.CornerRadius="{StaticResource RadiusMd}" Margin="0,6,0,0" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource EL}" Foreground="{DynamicResource RF}"
                    AutomationProperties.Name="Выключить VPN и открыть интернет">
              <TextBlock Text="Выключить VPN и открыть интернет" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
          </StackPanel>
        </Border>
        <Border x:Name="AnnounceCard" Margin="0,10,0,0" Padding="12,8,4,8" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource NB}" Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="AnnounceClose" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" AutomationProperties.Name="Скрыть объявление" VerticalAlignment="Top">
              <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="12" Height="12" StrokeThickness="2.4"/>
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="AnnounceText" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource NF}" TextWrapping="Wrap" LineHeight="17"/>
              <Button x:Name="AnnounceLink" Content="Подробнее" Style="{StaticResource BtnGhost}" Height="28" Padding="10,0" Margin="-10,4,0,0" HorizontalAlignment="Left" FontSize="{StaticResource FsNote}" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border x:Name="RoutingOffer" Margin="0,10,0,0" Padding="12" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Bg}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="RoutingOfferTitle" Text="Сервис предлагает маршрутизацию" FontSize="{StaticResource FsLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="RoutingOfferText" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,10"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="RoutingOfferAccept" Content="Включить" Style="{StaticResource BtnPrimary}" Height="32" Padding="14,0" o:Ui.CornerRadius="{StaticResource RadiusSm}" FontSize="{StaticResource FsNote}"/>
              <Button x:Name="RoutingOfferDecline" Content="Не надо" Style="{StaticResource BtnGhost}" Height="32" Padding="12,0" Margin="6,0,0,0" FontSize="{StaticResource FsNote}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Обход блокировок: сливочная плашка; нажатие на текст — настройки обхода. -->
        <Border Margin="0,8,0,0" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Cream}" Padding="10,0,10,0" MinHeight="48">
          <DockPanel>
            <CheckBox x:Name="BypassToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Обход блокировок: YouTube и Discord без VPN"/>
            <Button x:Name="BypassOpen" Style="{StaticResource Plain}" Tag="Transparent" Padding="0,8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Настройки обхода блокировок">
              <StackPanel>
                <TextBlock Text="Обход блокировок" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BypassText" Text="без VPN, через обход" FontSize="{StaticResource FsSmall}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource CreamMu}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
            </Button>
          </DockPanel>
        </Border>

        <!-- Разделы: открываются на острове справа. -->
        <StackPanel Margin="0,10,0,8">
          <Button x:Name="LiveNav" Style="{StaticResource SideNav}" AutomationProperties.Name="Программы и сайты">
            <DockPanel>
              <TextBlock x:Name="LiveCount" DockPanel.Dock="Right" Style="{StaticResource SideCount}"/>
              <Path Data="{StaticResource IcoNavApps}" Style="{StaticResource SideIcon}"/>
              <TextBlock Text="Программы и сайты" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Button>
          <Button x:Name="AllServersButton" Style="{StaticResource SideNav}" AutomationProperties.Name="Серверы">
            <DockPanel>
              <TextBlock x:Name="AllServersText" DockPanel.Dock="Right" Style="{StaticResource SideCount}"/>
              <Path Data="{StaticResource IcoGlobe}" Style="{StaticResource SideIcon}"/>
              <TextBlock Text="Серверы" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="ServicesNav" Style="{StaticResource SideNav}" AutomationProperties.Name="Маршрутизация">
            <DockPanel>
              <Path Data="{StaticResource IcoNavServices}" Style="{StaticResource SideIcon}"/>
              <TextBlock Text="Маршрутизация" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="HelpNav" Style="{StaticResource SideNav}" AutomationProperties.Name="Помощь">
            <DockPanel>
              <Path Data="{StaticResource IcoHelp}" Style="{StaticResource SideIcon}"/>
              <TextBlock Text="Помощь" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource SideNav}" AutomationProperties.Name="Настройки">
            <DockPanel>
              <Path Data="{StaticResource IcoNavSettings}" Style="{StaticResource SideIcon}"/>
              <TextBlock Text="Настройки" VerticalAlignment="Center"/>
            </DockPanel>
          </Button>
          <!-- Правила переехали в «Программы и сайты»; кнопка осталась для кода раздела. -->
          <Button x:Name="RulesNav" Visibility="Collapsed"><TextBlock x:Name="RulesCount"/></Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource Bg}" CornerRadius="{StaticResource RadiusLg}" Margin="12,0,12,12">
      <StackPanel>
        <Button x:Name="TodayCard" Style="{StaticResource SideTraffic}" o:Ui.CornerRadius="{StaticResource RadiusLg}" Padding="12,9"
                HorizontalContentAlignment="Stretch" AutomationProperties.Name="Трафик сегодня. Открыть аналитику">
          <DockPanel x:Name="TrafficRow">
            <v:PixelBars x:Name="TrafficBars" DockPanel.Dock="Right" Kind="Columns" Width="82" Height="33" VerticalAlignment="Center" Fill="{DynamicResource RouteVpn}" Empty="{DynamicResource Lilac}" Accent="{DynamicResource Sun}"/>
            <StackPanel VerticalAlignment="Bottom">
              <TextBlock Text="Трафик сегодня" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" Foreground="{DynamicResource Mu2}"/>
              <TextBlock x:Name="TrafficToday" Text="0 Б" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FsDisplayStatus}" FontWeight="ExtraBold" Margin="0,3,0,0"/>
              <TextBlock Text="Аналитика ›" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Ac}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Button>
        <StackPanel x:Name="PlanRow">
          <Border Height="1" Background="{DynamicResource Divider}" Margin="12,0"/>
          <DockPanel x:Name="PlanSummary" Margin="12,8">
            <v:PixelBars x:Name="PlanBars" DockPanel.Dock="Right" Kind="Segments" Count="6" Width="48" Height="8" VerticalAlignment="Center" Fill="{DynamicResource RouteVpn}" Empty="{DynamicResource Lilac}"/>
            <StackPanel Margin="0,0,10,0">
              <TextBlock x:Name="PlanText" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PlanSub" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
