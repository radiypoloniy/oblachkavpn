<UserControl x:Class="Oblachka.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Oblachka.Views" xmlns:o="clr-namespace:Oblachka" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Главный экран 420×660 (design/redesign-2026-10-14, экраны 05–09). Не прокручивается. -->
  <UserControl.Resources>
    <DataTemplate x:Key="ServerRowTemplate" DataType="{x:Type o:ServerRow}">
      <Button x:Name="RowButton" Style="{StaticResource Row}" AutomationProperties.Name="{Binding Name}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="32" Height="32" Visibility="{Binding FlagVisibility}" Stroke="#40808CA0" StrokeThickness="1">
            <Ellipse.Fill><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Ellipse.Fill>
          </Ellipse>
          <Border x:Name="IconPlate" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Aci}" Visibility="{Binding IconVisibility}">
            <Path x:Name="IconGlyph" Data="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource Ac}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Tx}"/>
            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Visibility="{Binding NoteVisibility}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding LatencyVisibility}">
            <Ellipse Width="6" Height="6" Fill="{Binding LatencyDot}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Latency}" FontSize="13" Foreground="{DynamicResource Mu2}"/>
          </StackPanel>
          <Grid Grid.Column="3" Width="22" Height="22" VerticalAlignment="Center">
            <Ellipse x:Name="MarkRing" Stroke="{DynamicResource Ring}" StrokeThickness="1.5"/>
            <Ellipse x:Name="MarkFill" Fill="{DynamicResource Ac}" Visibility="Collapsed"/>
            <Path x:Name="MarkCheck" Data="{StaticResource IcoCheck}" Width="11" Height="11" Stretch="Uniform" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/></Path.RenderTransform>
            </Path>
          </Grid>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="RowButton" Property="Background" Value="{DynamicResource Acs}"/>
          <Setter TargetName="RowButton" Property="Tag" Value="{DynamicResource Hovs}"/>
          <Setter TargetName="MarkRing" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="MarkFill" Property="Visibility" Value="Visible"/>
          <Setter TargetName="MarkCheck" Property="Visibility" Value="Visible"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" From="0.6" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" From="0.6" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconOnAccent}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Ac}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="White"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconMuted}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Field}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="{DynamicResource Mu2}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <!-- Шапка. Справа место под кнопки окна (свернуть, закрыть) — их рисует MainWindow. -->
    <DockPanel Margin="24,0,96,0">
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Настройки" ToolTip="Настройки">
        <Path Data="{StaticResource IcoSliders}" Style="{StaticResource Icon}" StrokeThickness="1.8"/>
      </Button>
      <TextBlock Text="облачка" Style="{StaticResource Brand}"/>
    </DockPanel>

    <!-- Статус и тумблер -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="24,4,24,22">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Fa}" VerticalAlignment="Center" Margin="0,2,8,0"/>
        <TextBlock x:Name="StatusTitle" Text="Не подключено" FontSize="24" FontWeight="Bold"/>
      </StackPanel>
      <TextBlock x:Name="StatusSub" Text="Нажмите кнопку или выберите сервер" FontSize="13" Foreground="{DynamicResource Mu}" HorizontalAlignment="Center" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
      <v:PowerSwitch x:Name="Power" Margin="0,22,0,0" HorizontalAlignment="Center"/>
      <Border x:Name="CheckChip" Height="28" CornerRadius="14" Padding="12,0" Margin="0,16,0,0" HorizontalAlignment="Center" Background="{DynamicResource Field}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path x:Name="CheckIcon" Data="{StaticResource IcoCheck}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource OkF}" Margin="0,0,6,0" Visibility="Collapsed"/>
          <TextBlock x:Name="CheckText" Text="Туннель выключен" FontSize="12.5" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Объявление сервиса: одна строка, крестик скрывает до следующего нового объявления. -->
    <!-- Особые состояния (экран 15): вместо списка серверов, пока ситуация не разрешится. -->
    <StackPanel Grid.Row="2">
      <Border x:Name="SubWarn" Margin="20,0,20,12" Padding="14,10,10,10" CornerRadius="12" Background="{DynamicResource SB}" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="SubWarnRenew" DockPanel.Dock="Right" Content="Продлить" Style="{StaticResource Plain}" Height="30" Padding="12,0" o:Ui.CornerRadius="8" Background="{DynamicResource SBtn}" Foreground="#2E2205" FontSize="12.5" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubWarnText" FontSize="12.5" Foreground="{DynamicResource SF}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>
      <Border x:Name="ForeignCard" Margin="20,6,20,0" Padding="18" CornerRadius="14" Background="{DynamicResource WB}" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Path Data="{StaticResource IcoWarn}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource WI}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Top" Margin="0,1,10,0"/>
            <StackPanel>
              <TextBlock x:Name="ForeignTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Tx}" TextWrapping="Wrap"/>
              <TextBlock x:Name="ForeignText" FontSize="13" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
            </StackPanel>
          </DockPanel>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="ForeignRetry" Content="Проверить снова" Style="{StaticResource BtnPrimary}" Height="36" o:Ui.CornerRadius="10" FontSize="13"/>
            <Button x:Name="ForeignProxy" Grid.Column="2" Content="Только браузеры" Style="{StaticResource BtnOutline}" Height="36" o:Ui.CornerRadius="10" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource WL}"/>
          </Grid>
        </StackPanel>
      </Border>
      <StackPanel x:Name="RecoveryCard" Margin="20,6,20,0" Visibility="Collapsed">
        <Border CornerRadius="14" Background="{DynamicResource CardBg}" Padding="16,6">
          <StackPanel>
            <DockPanel Height="38">
              <Border Width="20" Height="20" CornerRadius="10" Background="#D9731E" Margin="0,0,10,0"><TextBlock Text="!" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="RecoveryRounds" DockPanel.Dock="Right" FontSize="13.5" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
              <TextBlock Text="Два сайта не ответили" FontSize="13.5" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Height="38">
              <Ellipse x:Name="RecoverySpinner" Width="20" Height="20" Stroke="{DynamicResource Ac}" StrokeThickness="2" StrokeDashArray="8 4" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform x:Name="RecoverySpin"/></Ellipse.RenderTransform>
              </Ellipse>
              <TextBlock x:Name="RecoveryStep" Text="Ищем рабочий сервер" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel x:Name="RecoveryLockRow" Height="38">
              <Path Data="{StaticResource IcoLock}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource Mu}" StrokeThickness="2" Margin="0,0,10,0"/>
              <TextBlock Text="Пока переключаемся, мимо VPN ничего не уходит" FontSize="13" Foreground="{DynamicResource Mu}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <Button x:Name="RecoveryStop" Content="Остановить" Style="{StaticResource BtnSecondary}" Height="36" o:Ui.CornerRadius="10" FontSize="13" Margin="0,12,0,0"/>
      </StackPanel>
      <Border x:Name="ClosedCard" Margin="20,6,20,0" Padding="18" CornerRadius="14" Background="{DynamicResource EB}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Не удалось найти рабочий сервер. Ничего не утекло мимо туннеля, но и сайты сейчас не открываются." FontSize="13" Foreground="{DynamicResource EF}" TextWrapping="Wrap" LineHeight="19"/>
          <Button x:Name="ClosedPick" Content="Выбрать другой сервер" Style="{StaticResource BtnPrimary}" Height="36" o:Ui.CornerRadius="10" FontSize="13" Margin="0,12,0,0"/>
          <Button x:Name="ClosedOff" Content="Выключить VPN и открыть интернет" Style="{StaticResource BtnOutline}" Height="36" o:Ui.CornerRadius="10" Margin="0,8,0,0" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource EL}" Foreground="{DynamicResource RF}"/>
        </StackPanel>
      </Border>
      <Border x:Name="AnnounceCard" Margin="20,0,20,14" MinHeight="44" Padding="14,8,6,8" CornerRadius="12" Background="{DynamicResource NB}" Visibility="Collapsed">
      <DockPanel>
        <Path DockPanel.Dock="Left" Data="{StaticResource IcoSpeaker}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <Button x:Name="AnnounceClose" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" AutomationProperties.Name="Скрыть объявление" VerticalAlignment="Center">
          <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.4"/>
        </Button>
        <TextBlock x:Name="AnnounceText" FontSize="12.5" Foreground="{DynamicResource NF}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="17"/>
      </DockPanel>
    </Border>
    <!-- Сервис прислал маршрутизацию (заголовок routing): предложение включить и скачать базы. -->
    <Border x:Name="RoutingOffer" Margin="20,0,20,14" Padding="14,12,14,12" CornerRadius="12" Background="{DynamicResource CardBg}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="RoutingOfferTitle" Text="Сервис предлагает маршрутизацию" FontSize="13.5" FontWeight="SemiBold"/>
        <TextBlock x:Name="RoutingOfferText" FontSize="12.5" Foreground="{DynamicResource Mu}" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="RoutingOfferAccept" Content="Включить" Style="{StaticResource BtnPrimary}" Height="32" Padding="14,0" o:Ui.CornerRadius="8" FontSize="12.5"/>
          <Button x:Name="RoutingOfferDecline" Content="Не надо" Style="{StaticResource BtnGhost}" Height="32" Padding="12,0" Margin="6,0,0,0" FontSize="12.5"/>
        </StackPanel>
      </StackPanel>
    </Border>
    </StackPanel>

    <!-- Серверы: автовыбор, избранные и выбранный. -->
    <DockPanel x:Name="ServerSection" Grid.Row="3" Margin="14,0">
      <DockPanel DockPanel.Dock="Top" Height="34" Margin="12,0,4,4">
        <Button x:Name="AllServersButton" DockPanel.Dock="Right" Style="{StaticResource BtnLink}" AutomationProperties.Name="Все серверы">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="AllServersText" Text="Все" VerticalAlignment="Center"/>
            <Path Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.4" Margin="2,0,0,0"/>
          </StackPanel>
        </Button>
        <TextBlock Text="СЕРВЕР" Style="{StaticResource Caption}"/>
      </DockPanel>
      <ItemsControl x:Name="QuickList" ItemTemplate="{StaticResource ServerRowTemplate}" Focusable="False">
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,4"/></Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </DockPanel>

    <!-- Подвал: срок подписки и режим. -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
      <DockPanel Margin="24,0,14,0">
        <Button x:Name="ModeButton" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Height="30" Padding="8,0" o:Ui.CornerRadius="8" AutomationProperties.Name="Режим подключения">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ModeText" Text="Весь компьютер" FontSize="12" VerticalAlignment="Center"/>
            <Path Data="{StaticResource IcoChevronUp}" Style="{StaticResource Icon}" Width="12" Height="12" StrokeThickness="2.4" Margin="4,0,0,0"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="PlanText" FontSize="12" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
