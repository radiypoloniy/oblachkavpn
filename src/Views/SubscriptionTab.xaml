<UserControl x:Class="Oblachka.Views.SubscriptionTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Подписка (0.16): срок и трафик, обновление списка, устройство, все подписки и ключ. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,4,20,16">
      <TextBlock Text="Списки серверов" Style="{StaticResource SetCaption}"/>
      <!-- Группы (ProfileGroup): у подписки — «Обновить» и «Убрать», у «Вручную» — только «Убрать». -->
      <ItemsControl x:Name="GroupList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type o:GroupRow}">
            <Border CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource CardBg}" Padding="12,8,6,8" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Tag="remove" Style="{StaticResource SmallIconButton}" Width="30" Height="30" Foreground="{DynamicResource Fa}" ToolTip="Убрать" AutomationProperties.Name="{Binding RemoveName}">
                  <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4"/>
                </Button>
                <Button DockPanel.Dock="Right" Tag="refresh" Content="Обновить" Style="{StaticResource BtnOutline}" Height="32" Padding="9,0" Margin="8,0,4,0" VerticalAlignment="Center" Visibility="{Binding RefreshVisibility}" AutomationProperties.Name="{Binding RefreshName}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Sub}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Plan}" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="{Binding PlanVisibility}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Name="AddExternalButton" Style="{StaticResource Row}" Height="40" Padding="6,0" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Добавить подписку">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IcoPlus}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <TextBlock Text="Добавить подписку" FontSize="{StaticResource FsLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <Border x:Name="ActiveCard" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource CardBg}" Padding="14" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock x:Name="SubscriptionTitle" Text="Подписка" TextWrapping="Wrap" FontSize="{StaticResource FsLead}" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdatedText" TextWrapping="Wrap" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" Margin="0,4,0,0"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource B2}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="Действует до" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Mu2}"/>
                <TextBlock x:Name="ExpiryText" Text="—" TextWrapping="Wrap" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource B2}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="Трафик" FontSize="{StaticResource FsCaption}" Foreground="{DynamicResource Mu2}"/>
                <TextBlock x:Name="TrafficText" Text="—" TextWrapping="Wrap" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </Grid>
          <Button x:Name="RenewButton" Content="Продлить" Style="{StaticResource BtnPrimary}" Height="36"
                  HorizontalAlignment="Left" Padding="16,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" Margin="0,10,0,0"/>
          <!-- Ссылка support-url от панели; без неё кнопки нет. -->
          <Button x:Name="SupportButton" Content="Написать в поддержку" Style="{StaticResource BtnGhost}" Foreground="{DynamicResource Ac}" HorizontalAlignment="Left" Margin="-12,4,0,-6" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SetGroup}" Margin="0,10,0,0">
        <StackPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <CheckBox x:Name="AutoRefresh" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Обновлять список автоматически"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGreen}"><Path Data="{StaticResource IcoRefresh}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Автообновление подписок" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Не рвёт текущее подключение" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource SetLine}">
            <TextBlock x:Name="DeviceIdText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
            <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcGray}"><Path Data="{StaticResource IcoApp}" Style="{StaticResource SetGlyph}"/></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Это устройство" Style="{StaticResource SetTitle}"/>
              <TextBlock Text="Случайный номер для лимита устройств, не серийник" Style="{StaticResource SetSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Бесплатные серверы «на свой риск» (FreeServers): здесь и в меню «Добавить сервер» в «Серверах». -->
      <Border Style="{StaticResource SetGroup}" Margin="0,10,0,0">
        <DockPanel Style="{StaticResource SetLine}">
          <CheckBox x:Name="FreeServers" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" AutomationProperties.Name="Бесплатные серверы на свой риск"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Бесплатные серверы (на свой риск)" Style="{StaticResource SetTitle}"/>
            <TextBlock Text="Чужие серверы из открытых списков. Их владельцы видят, какие сайты вы открываете. Не участвуют в автовыборе и сами не включаются" TextWrapping="Wrap" Style="{StaticResource SetSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="Ключ" Style="{StaticResource SetCaption}"/>
      <Border Style="{StaticResource SetGroup}">
        <DockPanel Style="{StaticResource SetLine}">
          <CheckBox x:Name="Remember" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Запомнить на этом компьютере"/>
          <Border Style="{StaticResource SetIcon}" Background="{DynamicResource IcBlue}"><Path Data="{StaticResource IcoLock}" Style="{StaticResource SetGlyph}"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Запомнить на этом компьютере" Style="{StaticResource SetTitle}"/>
            <TextBlock x:Name="StorageStatus" Text="Ключ шифруется Windows для вашей учётной записи" Style="{StaticResource SetSub}"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Button x:Name="ChangeKeyButton" Content="Сменить ключ подписки…" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
