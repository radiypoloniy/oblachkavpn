<UserControl x:Class="Oblachka.Views.SubscriptionTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka">
  <!-- Настройки → Подписка (экран 12): срок и трафик, обновление списка, устройство, сторонние подписки. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,18,20,16">
      <Border CornerRadius="14" Background="{DynamicResource CardBg}" Padding="14">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="UpdatedText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Mu2}" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="SubscriptionTitle" Text="Подписка" FontSize="15" FontWeight="SemiBold"/>
          </DockPanel>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" Background="{DynamicResource B2}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="Действует до" FontSize="11.5" Foreground="{DynamicResource Mu2}"/>
                <TextBlock x:Name="ExpiryText" Text="—" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource B2}" Padding="10,8">
              <StackPanel>
                <TextBlock Text="Трафик" FontSize="11.5" Foreground="{DynamicResource Mu2}"/>
                <TextBlock x:Name="TrafficText" Text="—" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
          </Grid>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="RenewColumn" Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RenewButton" Content="Продлить" Style="{StaticResource BtnPrimary}" Height="36" o:Ui.CornerRadius="10" FontSize="13" Margin="0,0,8,0"/>
            <Button x:Name="RefreshListButton" Grid.Column="2" Content="Обновить список" Style="{StaticResource BtnOutline}" Height="36" o:Ui.CornerRadius="10"/>
          </Grid>
          <TextBlock x:Name="SubscriptionDetails" Style="{StaticResource Small}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

      <DockPanel Margin="6,8,4,4">
        <CheckBox x:Name="AutoRefresh" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Обновлять список автоматически"/>
        <StackPanel>
          <TextBlock Text="Обновлять список сам" FontSize="14"/>
          <TextBlock Text="Не рвёт текущее подключение" Style="{StaticResource Small}"/>
        </StackPanel>
      </DockPanel>
      <DockPanel Margin="6,4,4,4">
        <TextBlock x:Name="DeviceIdText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
        <StackPanel>
          <TextBlock Text="Это устройство" FontSize="14"/>
          <TextBlock Text="Случайный номер для лимита устройств, не серийник" Style="{StaticResource Small}"/>
        </StackPanel>
      </DockPanel>

      <TextBlock Text="СТОРОННИЕ ПОДПИСКИ" Style="{StaticResource Caption}" FontSize="11.5" Margin="6,10,6,2"/>
      <DockPanel Margin="6,4,2,4">
        <Button x:Name="RemoveExternalButton" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}" Width="30" Height="30" Foreground="{DynamicResource Fa}" AutomationProperties.Name="Убрать сторонние подписки">
          <Path Data="{StaticResource IcoClose}" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4"/>
        </Button>
        <TextBlock x:Name="ExternalSummary" Text="Сторонних подписок нет." FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
      <Button x:Name="AddExternalButton" Style="{StaticResource Row}" Height="40" Padding="6,0" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Добавить стороннюю подписку">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IcoPlus}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <TextBlock Text="Ссылка, vless://, JSON или файл" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <DockPanel Margin="6,10,4,0">
        <CheckBox x:Name="Remember" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Запомнить на этом компьютере"/>
        <StackPanel>
          <TextBlock Text="Запомнить на этом компьютере" FontSize="14"/>
          <TextBlock x:Name="StorageStatus" Text="Ключ шифруется Windows для вашей учётной записи" Style="{StaticResource Small}"/>
        </StackPanel>
      </DockPanel>
      <Button x:Name="ChangeKeyButton" Content="Сменить ключ подписки…" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="6,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
