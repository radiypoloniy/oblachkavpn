<UserControl x:Class="Oblachka.Views.ConnectionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- «Сейчас в сети» — раздел острова по умолчанию: программы с соединениями прямо сейчас,
       куда они идут и правило в один клик. Строка раскрывается нажатием (или правой кнопкой):
       справа — «VPN · Напрямую · Блок», ниже — что возьмёт правило и с кем программа на связи. -->
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type v:ConnectionRow}">
      <Border x:Name="Card" CornerRadius="{StaticResource RadiusLg}" Margin="0,0,0,2" Background="Transparent">
        <StackPanel>
          <Button Tag="row" Style="{StaticResource Row}" Height="Auto" MinHeight="58" Padding="10,8,10,8" AutomationProperties.Name="{Binding Name}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource Field}" Visibility="{Binding PlaceholderVisibility}">
                <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsRowLarge}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <Border Style="{StaticResource RuleTag}" Visibility="{Binding RuleVisibility}">
                    <TextBlock Text="правило" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
              <Border x:Name="Route" Grid.Column="2" Style="{StaticResource RoutePill}" Visibility="{Binding RouteVisibility}">
                <TextBlock x:Name="RouteText" Text="{Binding Route}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource PickPlate}" Visibility="{Binding PickVisibility}">
                <StackPanel Orientation="Horizontal">
                  <Button Tag="vpn" Content="VPN" Style="{StaticResource PickVpn}" o:Ui.Selected="{Binding RuleVpn, Mode=OneWay}" AutomationProperties.Name="Через VPN"/>
                  <Button Tag="direct" Content="Напрямую" Style="{StaticResource PickDirect}" o:Ui.Selected="{Binding RuleDirect, Mode=OneWay}"/>
                  <Button Tag="block" Content="Блок" Style="{StaticResource PickBlock}" o:Ui.Selected="{Binding RuleBlock, Mode=OneWay}" AutomationProperties.Name="Блокировать"/>
                </StackPanel>
              </Border>
            </Grid>
          </Button>
          <StackPanel Margin="56,0,14,12" Visibility="{Binding ActionsVisibility}">
            <TextBlock Text="{Binding Scope}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap"/>
            <Button Tag="folders" Content="{Binding FoldersLink}" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="-8,2,0,0" FontSize="{StaticResource FsSmall}" Visibility="{Binding FoldersLinkVisibility}"/>
            <ItemsControl ItemsSource="{Binding Folders}" Visibility="{Binding FoldersVisibility}" Focusable="False" Margin="0,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Path Data="{StaticResource IcoFolder}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2" Stroke="{DynamicResource Mu2}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Tx}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Сейчас на связи с" Style="{StaticResource DetailKey}"/>
            <TextBlock Text="{Binding Remotes}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Pending}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding PendingVisibility}"/>
            <Button Tag="remove" Content="Убрать правило" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="-8,6,0,0" FontSize="{StaticResource FsSmall}" Visibility="{Binding RemoveVisibility}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Expanded}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBg}"/></DataTrigger>
        <DataTrigger Binding="{Binding RouteKind}" Value="vpn">
          <Setter TargetName="Route" Property="Background" Value="{DynamicResource Aci}"/>
          <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource Ac}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteKind}" Value="direct">
          <Setter TargetName="Route" Property="Background" Value="{DynamicResource OkB}"/>
          <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource OkF}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteKind}" Value="block">
          <Setter TargetName="Route" Property="Background" Value="{DynamicResource RB}"/>
          <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource RF}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="10,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*" MaxWidth="276"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Grid.Column="1" Text="Сейчас в сети" Style="{StaticResource Brand}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="Count" Grid.Column="2" Style="{StaticResource SideCount}" Margin="10,2,0,0" VerticalAlignment="Center"/>
      <TextBox x:Name="SearchBox" Grid.Column="4" Style="{StaticResource FieldBox}" Height="36" Margin="16,0,0,0"
               Tag="Найти программу" FontSize="{StaticResource FsNote}" AutomationProperties.Name="Найти программу" WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>

    <StackPanel Grid.Row="1" Margin="20,0,20,6">
      <ListBox x:Name="Filters" ItemContainerStyle="{StaticResource FilterChip}" Background="Transparent" BorderThickness="0" Padding="0" Margin="-2,0,0,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Показать">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      </ListBox>
      <TextBlock x:Name="Note" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" Margin="2,8,0,0"/>
    </StackPanel>

    <Grid Grid.Row="2">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
        <o:AccessibleItems x:Name="AppList" Focusable="False"/>
      </ScrollViewer>
      <TextBlock x:Name="Empty" FontSize="{StaticResource FsLabel}" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="32,0"/>
    </Grid>
  </Grid>
</UserControl>
