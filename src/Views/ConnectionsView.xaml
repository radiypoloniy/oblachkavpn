<UserControl x:Class="Oblachka.Views.ConnectionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- «Программы и сайты» (облик 0.20; было «Сейчас в сети» и «Правила»): режим работы,
       программы с соединениями прямо сейчас, куда они идут и правило в один клик; внизу —
       локальная сеть и все правила сайтов и программ. Строка раскрывается нажатием (или правой кнопкой):
       справа — «VPN · Напрямую · Блок», ниже — что возьмёт правило и с кем программа на связи. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="LiveSiteRow.xaml"/></ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type v:ConnectionRow}">
      <Border x:Name="Card" CornerRadius="{StaticResource RadiusLg}" Margin="0,0,0,2" Background="Transparent">
        <StackPanel>
          <Button Tag="row" Style="{StaticResource Row}" Height="Auto" MinHeight="48" Padding="10,6" AutomationProperties.Name="{Binding Name}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusSm}" Background="{DynamicResource Field}" Visibility="{Binding PlaceholderVisibility}">
                <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FsRow}" FontWeight="SemiBold" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                <DockPanel HorizontalAlignment="Left">
                  <Border DockPanel.Dock="Right" Style="{StaticResource RuleTag}" Visibility="{Binding RuleVisibility}">
                    <TextBlock Text="правило" FontSize="{StaticResource FsCaption}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
              <Border x:Name="Route" Grid.Column="2" Style="{StaticResource RoutePill}" Visibility="{Binding RouteVisibility}">
                <TextBlock x:Name="RouteText" Text="{Binding Route}" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="ProgramPick" Grid.Column="2" Style="{StaticResource PickPlate}" Visibility="{Binding PickVisibility}">
                <StackPanel Orientation="Horizontal">
                  <Button Tag="vpn" Content="VPN" Style="{StaticResource PickVpn}" o:Ui.Selected="{Binding RuleVpn, Mode=OneWay}" AutomationProperties.Name="Через VPN"/>
                  <Button Tag="direct" Content="Напрямую" Style="{StaticResource PickDirect}" o:Ui.Selected="{Binding RuleDirect, Mode=OneWay}"/>
                  <Button Tag="block" Content="Блок" Style="{StaticResource PickBlock}" o:Ui.Selected="{Binding RuleBlock, Mode=OneWay}" AutomationProperties.Name="Блокировать"/>
                </StackPanel>
              </Border>
            </Grid>
          </Button>
          <StackPanel x:Name="AppDetails" Margin="56,0,14,12" Visibility="{Binding ActionsVisibility}">
            <StackPanel Visibility="{Binding SitesVisibility}" Margin="0,2,0,8">
              <TextBlock Text="{Binding SiteHeading}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBox Text="{Binding SiteQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Height="30" Tag="Найти сайт по домену"
                       FontSize="{StaticResource FsSmall}" AutomationProperties.Name="Поиск сайта в программе"/>
              <TextBlock Text="Сайт не найден среди текущих соединений." Style="{StaticResource Small}" Visibility="{Binding NoSiteMatchesVisibility}" Margin="0,8,0,2"/>
              <ItemsControl ItemsSource="{Binding VisibleSites}" Focusable="False" Margin="0,4,0,0"/>
              <Button Tag="more-sites" Content="{Binding MoreSitesLabel}" Visibility="{Binding MoreSitesVisibility}" Style="{StaticResource BtnLink}" HorizontalAlignment="Left"/>
            </StackPanel>
            <Expander Header="Детали программы" Style="{StaticResource LiveDisclosure}" Margin="0,2,0,0">
              <StackPanel Margin="0,6,0,0">
            <TextBlock Text="{Binding Observation}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Scope}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu}" TextWrapping="Wrap"/>
            <Button Tag="folders" Content="{Binding FoldersLink}" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="-8,2,0,0" FontSize="{StaticResource FsSmall}" Visibility="{Binding FoldersLinkVisibility}"/>
            <ItemsControl ItemsSource="{Binding Folders}" Visibility="{Binding FoldersVisibility}" Focusable="False" Margin="0,2,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,3">
                    <Path Data="{StaticResource IcoFolder}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2" Stroke="{DynamicResource Mu2}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Tx}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Файлы программы" Style="{StaticResource DetailKey}" Visibility="{Binding FilesVisibility}"/>
            <ItemsControl ItemsSource="{Binding Files}" Visibility="{Binding FilesVisibility}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type v:FileRow}">
                  <Grid Margin="0,3">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel x:Name="FileActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Tag="file-remove" Content="Убрать" Style="{StaticResource BtnLink}" FontSize="{StaticResource FsSmall}" Visibility="{Binding RemoveVisibility}" AutomationProperties.Name="Убрать правило файла"/>
                      <Border Style="{StaticResource PickPlate}" Visibility="{Binding PickVisibility}">
                        <StackPanel Orientation="Horizontal">
                          <Button Tag="file-vpn" Content="VPN" Style="{StaticResource PickVpn}" o:Ui.Selected="{Binding RuleVpn, Mode=OneWay}" AutomationProperties.Name="Этот файл через VPN"/>
                          <Button Tag="file-direct" Content="Напрямую" Style="{StaticResource PickDirect}" o:Ui.Selected="{Binding RuleDirect, Mode=OneWay}" AutomationProperties.Name="Этот файл напрямую"/>
                          <Button Tag="file-block" Content="Блок" Style="{StaticResource PickBlock}" o:Ui.Selected="{Binding RuleBlock, Mode=OneWay}" AutomationProperties.Name="Блокировать этот файл"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=o:AccessibleItems}}" Value="narrow">
                      <Setter TargetName="FileActions" Property="Grid.Row" Value="1"/>
                      <Setter TargetName="FileActions" Property="Grid.Column" Value="0"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Tag="close-all" Content="Закрыть все соединения программы" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="-8,4,0,0" FontSize="{StaticResource FsSmall}" Visibility="{Binding CloseAllVisibility}"/>
            <TextBlock Text="{Binding Pending}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding PendingVisibility}"/>
            <Button Tag="remove" Content="Убрать правило" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="-8,6,0,0" FontSize="{StaticResource FsSmall}" Visibility="{Binding RemoveVisibility}"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Expanded}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBg}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=o:AccessibleItems}}" Value="narrow">
          <Setter TargetName="AppDetails" Property="Margin" Value="12,0,12,12"/>
          <Setter TargetName="ProgramPick" Property="Grid.Row" Value="1"/>
          <Setter TargetName="ProgramPick" Property="Grid.Column" Value="1"/>
          <Setter TargetName="ProgramPick" Property="Grid.ColumnSpan" Value="2"/>
          <Setter TargetName="ProgramPick" Property="HorizontalAlignment" Value="Left"/>
          <Setter TargetName="ProgramPick" Property="Margin" Value="14,4,0,0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteKind}" Value="vpn">
          <Setter TargetName="Route" Property="Background" Value="{DynamicResource Aci}"/>
          <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource Ac}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteKind}" Value="direct">
          <Setter TargetName="Route" Property="Background" Value="{DynamicResource OkB}"/>
          <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource OkF}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteKind}" Value="switch">
          <Setter TargetName="Route" Property="Background" Value="{DynamicResource Field}"/>
          <Setter TargetName="RouteText" Property="Foreground" Value="{DynamicResource Ac}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="10,0,24,0">
      <Grid x:Name="HeaderRulesSlot" DockPanel.Dock="Right" VerticalAlignment="Center">
      <Button x:Name="RulesOpen" HorizontalAlignment="Left" Style="{StaticResource BtnPrimary}" Height="32" Padding="11,0" VerticalAlignment="Center"
              AutomationProperties.Name="Открыть маршрутизацию" ToolTip="Открыть правила для сайтов, программ и сервисов">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Маршрутизация" VerticalAlignment="Center"/>
          <Path Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="9" Height="12" StrokeThickness="1.5" Margin="7,0,0,0"/>
        </StackPanel>
      </Button>
      </Grid>
      <!-- Режим работы: весь компьютер (системный туннель) или только браузеры (прокси Windows). -->
      <!-- В узком окне переключатель переезжает строкой ниже (NarrowModeSlot), иначе закрывал заголовок. -->
      <Grid x:Name="HeaderModeSlot" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
      <Border x:Name="ModeTrack" Style="{StaticResource SegTrack}" VerticalAlignment="Center" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ModeTun" Content="Весь компьютер" Style="{StaticResource SegButton}" AutomationProperties.Name="Весь компьютер">
            <Button.ToolTip><TextBlock x:Name="SystemTunnelHint" Text="Игры, мессенджеры и любые программы. Без VPN — без интернета." MaxWidth="320" TextWrapping="Wrap"/></Button.ToolTip>
          </Button>
          <Button x:Name="ModeProxy" Content="Только браузеры" Style="{StaticResource SegButton}" AutomationProperties.Name="Браузеры и программы"
                  ToolTip="Прокси Windows: без прав администратора, но не для всех приложений. Браузер может показать сайтам настоящий IP через WebRTC"/>
        </StackPanel>
      </Border>
      </Grid>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Программы и сайты" Style="{StaticResource PageHead}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="Count" Style="{StaticResource SideCount}" Margin="10,4,12,0" VerticalAlignment="Center"/>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="24,0,24,6">
      <Grid x:Name="NarrowModeSlot" Margin="0,0,0,10" Visibility="Collapsed"/>
      <Grid x:Name="NarrowRulesSlot" Margin="0,0,0,8" Visibility="Collapsed"/>
      <DockPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Style="{StaticResource FieldBox}" Width="200" Height="32" Margin="12,0,0,0" VerticalAlignment="Center"
                 Tag="Найти программу" FontSize="{StaticResource FsNote}" AutomationProperties.Name="Найти программу"/>
        <ListBox x:Name="Filters" ItemContainerStyle="{StaticResource FilterChip}" Background="Transparent" BorderThickness="0" Padding="0" Margin="-2,0,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Показать">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
      </DockPanel>
      <TextBlock x:Name="Note" Style="{StaticResource Small}" Foreground="{DynamicResource Mu2}" TextWrapping="Wrap" Margin="2,8,0,0"/>
      <!-- Спор правил (ProgramRuleConflicts): одна программа пойдёт двумя путями. -->
      <Border x:Name="ConflictBanner" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Peach}" Padding="14,12" Margin="0,10,0,0" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="ConflictOpen" DockPanel.Dock="Right" Content="Открыть правила" Style="{StaticResource BtnPrimary}" Height="34" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <v:CloudFace Mood="Worried" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ConflictText" FontSize="{StaticResource FsBody}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2">
      <o:AccessibleItems x:Name="AppList" Focusable="False" Padding="10,0,10,10"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
        <o:AccessibleItems.Template><ControlTemplate TargetType="o:AccessibleItems">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer>
        </ControlTemplate></o:AccessibleItems.Template>
        <o:AccessibleItems.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></o:AccessibleItems.ItemsPanel>
      </o:AccessibleItems>
      <TextBlock x:Name="Empty" FontSize="{StaticResource FsLabel}" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="32,0"/>
    </Grid>

    <!-- Локальная сеть мимо туннеля. -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,8">
      <DockPanel>
        <CheckBox x:Name="LocalNetwork" Style="{StaticResource Toggle}" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="Локальная сеть напрямую"/>
        <StackPanel VerticalAlignment="Center" Margin="12,0,12,0">
          <TextBlock Text="Локальная сеть напрямую" FontSize="{StaticResource FsBody}" FontWeight="SemiBold"/>
          <TextBlock Text="Принтер, NAS и роутер мимо VPN, со следующего подключения" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
