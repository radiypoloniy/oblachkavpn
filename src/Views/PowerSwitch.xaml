<UserControl x:Class="Oblachka.Views.PowerSwitch" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160" Height="88">
  <!-- Тумблер главного экрана: ручка слева (выкл), по центру (подключаемся), справа (вкл или сеть закрыта).
       Цвет дорожки меняется наплывом слоёв: так переход плавный и при смене темы. -->
  <Button x:Name="Surface" Style="{StaticResource Plain}" Click="SurfaceClick">
    <Grid Width="160" Height="88">
      <Border x:Name="Glow" CornerRadius="44" Background="{DynamicResource Ac}" Opacity="0">
        <Border.Effect><DropShadowEffect x:Name="GlowShadow" BlurRadius="24" ShadowDepth="8" Direction="270" Color="{DynamicResource GlowColor}" Opacity="1"/></Border.Effect>
      </Border>
      <Border CornerRadius="44" Background="{DynamicResource Off}"/>
      <Border x:Name="MidLayer" CornerRadius="44" Background="{DynamicResource Mid}" Opacity="0"/>
      <Border x:Name="OnLayer" CornerRadius="44" Background="{DynamicResource Ac}" Opacity="0"/>
      <Border x:Name="BlockedLayer" CornerRadius="44" Background="{DynamicResource ETrack}" Opacity="0"/>
      <Border x:Name="Knob" Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Knob}" HorizontalAlignment="Left" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5">
        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.2"/></Border.Effect>
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1"/>
            <TranslateTransform x:Name="Slide" X="0"/>
          </TransformGroup>
        </Border.RenderTransform>
        <Path x:Name="Glyph" Data="{StaticResource IcoPower}" Width="28" Height="28" Stretch="Uniform" StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Fa}"/>
      </Border>
    </Grid>
  </Button>
</UserControl>
