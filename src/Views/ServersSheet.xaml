<UserControl x:Class="Oblachka.Views.ServersSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- «Серверы» (облик 0.20, v2): список во всю высоту. Шапка — заголовок, поиск, пинг, подписки;
       ниже вкладки подписок и порядок одной строкой; закреплённая карточка автовыбора (пул и
       «сервер упал — переключить»); строки серверов в одну линию; внизу одна главная кнопка.
       Срок и остаток подписки — в карточке внизу боковой колонки. -->
  <UserControl.Resources>
  <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="ServerSheetRow.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Заголовок подписки: имя, число серверов и «⋯» — обновить, скрыть лишние, вернуть скрытые, убрать
         (MainWindow.SheetMenus). Оранжевая точка на «⋯» — есть неотвечающие серверы или повторы. -->
    <DataTemplate DataType="{x:Type o:SheetHeader}">
      <DockPanel Margin="10,10,4,2" Height="32">
        <Button DockPanel.Dock="Right" Tag="group-menu" Style="{StaticResource IconButton}" Width="30" Height="30" Visibility="{Binding ActionsVisibility}"
                AutomationProperties.Name="{Binding MenuName}" ToolTip="Обновить, скрыть, убрать">
          <Grid Width="18" Height="18">
            <Path Data="M5,12 L5.01,12 M12,12 L12.01,12 M19,12 L19.01,12" Width="16" Height="4" Stretch="Uniform" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Mu2}"/>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Alert}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding JunkVisibility}"/>
          </Grid>
        </Button>
        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding CountText}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Fa}" Margin="8,1,0,0" VerticalAlignment="Center"/>
      </DockPanel>
    </DataTemplate>
  </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Шапка: заголовок, поиск в той же строке, пинг, подписки. -->
    <DockPanel Margin="10,0,20,0">
      <Button x:Name="SubscriptionsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="38" Height="38" Background="{DynamicResource Field}" o:Ui.CornerRadius="{StaticResource RadiusLg}" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Добавить: подписку, ключ, файл или QR" ToolTip="Добавить: подписку, ключ, файл или QR">
        <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Icon}" Width="15" Height="15" StrokeThickness="2.4"/>
      </Button>
      <Button x:Name="MeasureButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="38" Height="38" Background="{DynamicResource Field}" o:Ui.CornerRadius="{StaticResource RadiusLg}" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Обновить пинг" ToolTip="Обновить пинг: задержка через каждый сервер, работает и при подключении">
        <Path Data="{StaticResource IcoRefresh}" Style="{StaticResource Icon}" Width="16" Height="16" StrokeThickness="2.2"/>
      </Button>
      <Button x:Name="RefreshButton" Visibility="Collapsed"/>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Серверы" Style="{StaticResource PageHead}" Margin="10,0,16,0" VerticalAlignment="Center"/>
      <Grid x:Name="HeaderSearchSlot" VerticalAlignment="Center">
      <Grid x:Name="SearchField" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <TextBox x:Name="SearchBox" Height="38" Padding="34,0,12,0" FontSize="{StaticResource FsBody}" VerticalContentAlignment="Center" BorderThickness="0"
                 Background="{DynamicResource Field}" Foreground="{DynamicResource Tx}" CaretBrush="{DynamicResource Tx}" AutomationProperties.Name="Найти сервер">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Plate" CornerRadius="{StaticResource RadiusLg}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ac}" BorderThickness="0">
                <Grid>
                  <TextBlock x:Name="Hint" Text="Страна или название" Foreground="{DynamicResource Fa}" Margin="36,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Plate" Property="BorderThickness" Value="2"/>
                  <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Bg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <Path Data="{StaticResource IcoSearch}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Fa}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
      </Grid>
      </Grid>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="24,0,20,0">
      <!-- В узком окне поиск — здесь, во всю ширину: в шапке рядом с заголовком от него оставалась одна буква. -->
      <Grid x:Name="NarrowSearchSlot" Margin="0,0,0,10" Visibility="Collapsed"/>
      <!-- Вкладки подписок и порядок — одной строкой. Порядок — меню у «Лучшие сверху ▾». -->
      <DockPanel>
        <Button x:Name="SortButton" DockPanel.Dock="Right" Style="{StaticResource Plain}" Tag="Transparent" Padding="8,0" Height="32" VerticalAlignment="Center" AutomationProperties.Name="Порядок серверов">
          <StackPanel Orientation="Horizontal">
            <Path Data="M7,4 L7,20 M3,16 L7,20 L11,16 M14,6 L21,6 M14,12 L19,12 M14,18 L17,18" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4" Stroke="{DynamicResource Mu}" Margin="0,1,6,0"/>
            <TextBlock x:Name="SortText" Text="Лучшие сверху" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ListBox x:Name="SortOrder" Visibility="Collapsed" SelectedIndex="0">
          <sys:String>Лучшие сверху</sys:String>
          <sys:String>По названию</sys:String>
          <sys:String>Как в подписке</sys:String>
        </ListBox>
        <ScrollViewer x:Name="GroupTabsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <ListBox x:Name="GroupTabs" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Подписки" SelectedIndex="0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
      <!-- Вкладка «Бесплатные»: какой список загрузить, и напоминание, что серверы чужие. -->
      <StackPanel x:Name="FreePanel" Margin="0,10,0,0" Visibility="Collapsed">
        <ListBox x:Name="FreeKind" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Список бесплатных серверов" SelectedIndex="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          <sys:String>Обычный</sys:String>
          <sys:String>Мобильный</sys:String>
          <sys:String>Белые списки</sys:String>
        </ListBox>
        <Button x:Name="FreeOff" Content="Выключить бесплатные" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Padding="0" Margin="2,6,0,0"/>
        <TextBlock x:Name="FreeStatus" Style="{StaticResource Small}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"/>
        <TextBlock Text="Чужие серверы: их владельцы видят, какие сайты вы открываете. Не входите через них в банк, почту и Госуслуги." FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="2,8,0,0"/>
      </StackPanel>
      <!-- Автовыбор — закреплённая первая строка: выбрать, какие серверы в пуле, переключение при обрыве. -->
      <Border x:Name="AutoCard" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Cream}" Padding="6,6,12,6" Margin="-10,10,0,0" BorderBrush="{DynamicResource Ink}" BorderThickness="0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Упал — переключить" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" Foreground="{DynamicResource CreamMu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="AutoRecover" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Переключать сервер при обрыве"/>
          </StackPanel>
          <Button x:Name="AutoPick" Style="{StaticResource Plain}" Tag="Transparent" Padding="6,4" HorizontalContentAlignment="Stretch" o:Ui.CornerRadius="{StaticResource RadiusMd}" AutomationProperties.Name="Автовыбор">
            <DockPanel>
              <Border Width="34" Height="34" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Bg}" Margin="0,0,12,0">
                <Path Data="{StaticResource IcoAuto}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Orb}"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AutoTitle" Text="Автовыбор" FontSize="{StaticResource FsRowLarge}" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="AutoNote" Text="самый быстрый из отмеченных" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource CreamMu}" VerticalAlignment="Center"/>
                  <Button x:Name="OpenAutoPool" Style="{StaticResource BtnLink}" Height="22" Padding="6,0" Foreground="{DynamicResource Tx}" FontWeight="SemiBold" AutomationProperties.Name="Серверы автовыбора">
                    <TextBlock x:Name="AutoPoolSummary" Text="какие"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Button>
        </DockPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="14,0">
      <StackPanel>
        <ItemsControl x:Name="SheetList" Focusable="False"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Подвал: когда обновлялся пинг, «Подобрать лучшее» и его итог. -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1.5,0,0" Padding="24,10,20,14">
      <DockPanel>
        <v:TuneCard x:Name="Tune" DockPanel.Dock="Top" Visibility="Collapsed"/>
        <Button x:Name="BestButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Подобрать лучшее" Padding="22,0" ToolTip="Проверит лучшие серверы с разными настройками и подключит самый быстрый и стабильный"/>
        <TextBlock x:Name="MeasuredAgo" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Fa}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Всплывающие окна в облике приложения: «Добавить сервер», меню «⋯» и порядок списка. -->
    <Popup x:Name="AddPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
      <v:AddMenu x:Name="Add"/>
    </Popup>
    <!-- Меню «⋯» строки сервера и заголовка подписки: пункты собирает MainWindow.SheetMenus. -->
    <Popup x:Name="RowMenuPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
      <Grid Width="250" Margin="12,4,12,18">
        <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
        <Border Style="{StaticResource MenuCard}" Padding="14,6"><StackPanel x:Name="RowMenuItems"/></Border>
      </Grid>
    </Popup>
    <Popup x:Name="SortPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=SortButton}">
      <Grid Width="230" Margin="12,4,12,18">
        <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
        <Border Style="{StaticResource MenuCard}" Padding="14,6"><StackPanel x:Name="SortItems"/></Border>
      </Grid>
    </Popup>
  </Grid>
</UserControl>
