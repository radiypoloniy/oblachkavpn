<UserControl x:Class="Oblachka.Views.ServersSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Обновление подписки в шапке. Поиск, вкладки и автовыбор над списком, проверка серверов под ним. -->
  <UserControl.Resources>
  <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="ServerSheetRow.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate DataType="{x:Type o:SheetHeader}">
      <DockPanel Margin="10,10,4,2" Height="32">
        <Button DockPanel.Dock="Right" Tag="group-menu" Style="{StaticResource IconButton}" Width="30" Height="30" Visibility="{Binding ActionsVisibility}"
                AutomationProperties.Name="{Binding MenuName}" ToolTip="Управление списком">
          <Grid Width="18" Height="18">
            <Path Data="M5,12 L5.01,12 M12,12 L12.01,12 M19,12 L19.01,12" Width="16" Height="4" Stretch="Uniform" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Mu2}"/>
          </Grid>
        </Button>
        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsBody}" FontWeight="Bold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding CountText}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Fa}" Margin="8,1,0,0" VerticalAlignment="Center"/>
      </DockPanel>
    </DataTemplate>
  </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel x:Name="HeaderTools" Margin="20,0">
      <Button x:Name="SubscriptionsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Background="{DynamicResource Acs}" Foreground="{DynamicResource Ac}" o:Ui.CornerRadius="{StaticResource RadiusMd}" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Добавить: подписку, ключ, файл или QR" ToolTip="Добавить: подписку, ключ, файл или QR">
        <Path Data="{StaticResource IcoPlus}" Style="{StaticResource Icon}" Width="15" Height="15" StrokeThickness="2.4"/>
      </Button>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить список" Style="{StaticResource BtnOutline}"
              Height="32" Padding="10,0" Margin="6,0,0,0" o:Ui.CornerRadius="{StaticResource RadiusMd}" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="32" Height="32" Foreground="{DynamicResource Tx}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <TextBlock Text="Серверы" Style="{StaticResource PageHead}" VerticalAlignment="Center"/>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="20,0">
      <Grid x:Name="SearchField" Margin="0,0,0,8" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
        <TextBox x:Name="SearchBox" Height="32" Padding="32,0,10,0" FontSize="{StaticResource FsBody}" VerticalContentAlignment="Center" BorderThickness="0"
                 Background="{DynamicResource Field}" Foreground="{DynamicResource Tx}" CaretBrush="{DynamicResource Tx}" AutomationProperties.Name="Найти сервер">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Plate" CornerRadius="{StaticResource RadiusMd}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ac}" BorderThickness="0">
                <Grid>
                  <TextBlock x:Name="Hint" Text="Страна или название" Foreground="{DynamicResource Fa}" Margin="34,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Hov}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Plate" Property="BorderThickness" Value="1"/>
                  <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Bg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <Path Data="{StaticResource IcoSearch}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Fa}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False"/>
      </Grid>
      <!-- Вкладки подписок и порядок — одной строкой. Порядок — меню у «Лучшие сверху ▾». -->
      <DockPanel x:Name="GroupTools">
        <Button x:Name="SortButton" DockPanel.Dock="Right" ToolTip="{Binding Text, ElementName=SortText}" Style="{StaticResource Plain}" Tag="Transparent" Padding="8,0" Height="32" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Порядок серверов">
          <StackPanel Orientation="Horizontal">
            <Path Data="M7,4 L7,20 M3,16 L7,20 L11,16 M14,6 L21,6 M14,12 L19,12 M14,18 L17,18" Style="{StaticResource Icon}" Width="13" Height="13" StrokeThickness="2.4" Stroke="{DynamicResource Mu}" Margin="0,1,0,0"/>
            <TextBlock x:Name="SortText" Margin="6,0,0,0" Text="Лучшие сверху" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="{DynamicResource Mu}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ListBox x:Name="SortOrder" Visibility="Collapsed" SelectedIndex="0">
          <sys:String>Лучшие сверху</sys:String>
          <sys:String>По названию</sys:String>
          <sys:String>Как в подписке</sys:String>
        </ListBox>
        <ScrollViewer x:Name="GroupTabsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <ListBox x:Name="GroupTabs" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Подписки" SelectedIndex="0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
      <!-- Вкладка «Бесплатные»: какой список загрузить, и напоминание, что серверы чужие. -->
      <StackPanel x:Name="FreePanel" Margin="0,10,0,0" Visibility="Collapsed">
        <ListBox x:Name="FreeKind" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Список бесплатных серверов" SelectedIndex="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          <sys:String>Обычный</sys:String>
          <sys:String>Мобильный</sys:String>
          <sys:String>Белые списки</sys:String>
        </ListBox>
        <Button x:Name="FreeOff" Content="Выключить бесплатные" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Padding="0" Margin="2,6,0,0"/>
        <TextBlock x:Name="FreeStatus" Style="{StaticResource Small}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"/>
        <TextBlock Text="Чужие серверы: их владельцы видят, какие сайты вы открываете. Не входите через них в банк, почту и Госуслуги." FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="2,8,0,0"/>
      </StackPanel>
      <!-- Автовыбор — закреплённая первая строка: выбрать, какие серверы в пуле, переключение при обрыве. -->
      <Border x:Name="AutoCard" CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Cream}" Padding="4,4,12,4" Margin="0,6,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="AutoRecoverLabel" Text="При обрыве" FontSize="{StaticResource FsNote}" FontWeight="SemiBold" Foreground="{DynamicResource CreamMu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="AutoRecover" Style="{StaticResource Toggle}" IsChecked="True" ToolTip="Переключать сервер при обрыве" AutomationProperties.Name="Переключать сервер при обрыве"/>
          </StackPanel>
          <Button x:Name="OpenAutoPool" DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Padding="8,0" Foreground="{DynamicResource Tx}" FontWeight="SemiBold"
                  VerticalAlignment="Center" AutomationProperties.Name="Серверы автовыбора">
            <TextBlock x:Name="AutoPoolSummary" Text="Список"/>
          </Button>
          <Button x:Name="AutoPick" Style="{StaticResource Plain}" Tag="Transparent" Padding="6,4" HorizontalContentAlignment="Stretch" o:Ui.CornerRadius="{StaticResource RadiusMd}" AutomationProperties.Name="Автовыбор">
            <DockPanel>
              <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusInner}" Background="{DynamicResource Bg}" Margin="0,0,12,0">
                <Path Data="{StaticResource IcoAuto}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource CreamMu}"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AutoTitle" Text="Автовыбор" FontSize="{StaticResource FsBody}" FontWeight="Bold"/>
                <TextBlock x:Name="AutoNote" Text="Самый быстрый из отмеченных" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource CreamMu}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </DockPanel>
      </Border>
    </StackPanel>

    <ItemsControl x:Name="SheetList" Grid.Row="2" Focusable="False" Margin="0,6,0,0"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
            <ItemsPresenter Margin="20,0"/>
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="20,7,20,8">
      <StackPanel>
        <v:TuneCard x:Name="Tune" Visibility="Collapsed"/>
        <DockPanel x:Name="SubscriptionRefreshCard" Margin="0,0,0,7" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="RefreshScopeText" FontSize="{StaticResource FsSmall}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <TextBlock x:Name="RefreshStatusText" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </DockPanel>
        <DockPanel>
          <Button x:Name="BestButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Подобрать лучшее" Padding="22,0" ToolTip="Проверит лучшие серверы с разными настройками и подключит самый быстрый и стабильный"/>
          <Button x:Name="MeasureButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Background="{DynamicResource Field}" o:Ui.CornerRadius="{StaticResource RadiusMd}" Margin="0,0,6,0" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Проверить задержку на вкладке" ToolTip="Проверить задержку на вкладке">
            <Path Data="M2,12 L6,12 L9,5 L13,19 L16,12 L22,12" Style="{StaticResource Icon}" Width="16" Height="16" StrokeThickness="2"/>
          </Button>
          <TextBlock x:Name="MeasuredAgo" FontSize="{StaticResource FsSmall}" TextWrapping="Wrap" Margin="0,0,8,0" Foreground="{DynamicResource Fa}" VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Всплывающие окна в облике приложения: «Добавить сервер», меню «⋯» и порядок списка. -->
    <Popup x:Name="AddPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
      <v:AddMenu x:Name="Add"/>
    </Popup>
    <!-- Меню «⋯» строки сервера и заголовка подписки: пункты собирает MainWindow.SheetMenus. -->
    <Popup x:Name="RowMenuPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
      <Grid Width="250" Margin="12,4,12,18">
        <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
        <Border Style="{StaticResource MenuCard}" Padding="14,6"><StackPanel x:Name="RowMenuItems"/></Border>
      </Grid>
    </Popup>
    <Popup x:Name="SortPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=SortButton}">
      <Grid Width="230" Margin="12,4,12,18">
        <Border Style="{StaticResource ShadowLayer}" CornerRadius="{StaticResource RadiusSheet}"/>
        <Border Style="{StaticResource MenuCard}" Padding="14,6"><StackPanel x:Name="SortItems"/></Border>
      </Grid>
    </Popup>
  </Grid>
</UserControl>
