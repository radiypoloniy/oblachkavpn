<UserControl x:Class="Oblachka.Views.ServersSheet" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:o="clr-namespace:Oblachka" xmlns:v="clr-namespace:Oblachka.Views" xmlns:sys="clr-namespace:System;assembly=System.Runtime" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Tx}" Background="{DynamicResource Bg}">
  <!-- Панель «Все серверы» (экран 09): выезжает поверх главного окна. Группы: автовыбор, избранное,
       свои узлы, сторонние. Звезда справа переключает избранное, клик по строке — подключение. -->
  <UserControl.Resources>
    <!-- Заголовок подписки: справа «Скрыть лишние», «Вернуть скрытые», «Обновить», «Убрать». -->
    <DataTemplate DataType="{x:Type o:SheetHeader}">
      <DockPanel Margin="10,10,4,2">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ActionsVisibility}">
          <Button Tag="group-hide-junk" Content="{Binding JunkText}" Style="{StaticResource BtnLink}" Height="26" FontSize="{StaticResource FsSmall}" Visibility="{Binding JunkVisibility}"
                  ToolTip="Скрыть серверы, которые не ответили при последней проверке, и повторы — серверы с той же настройкой, что уже есть выше"/>
          <Button Tag="group-unhide" Content="{Binding UnhideText}" Style="{StaticResource BtnLink}" Height="26" FontSize="{StaticResource FsSmall}" Visibility="{Binding UnhideVisibility}"/>
          <Button Tag="group-refresh" Content="Обновить" Style="{StaticResource BtnLink}" Height="26" FontSize="{StaticResource FsSmall}" Visibility="{Binding RefreshVisibility}"/>
          <Button Tag="group-remove" Content="Убрать" Style="{StaticResource BtnLink}" Height="26" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" AutomationProperties.Name="{Binding RemoveName}"/>
        </StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="{StaticResource FsRow}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type o:ServerRow}">
      <Border x:Name="Plate" Height="54" CornerRadius="{StaticResource RadiusLg}" Margin="0,0,0,2" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="RowButton" Style="{StaticResource Row}" Padding="10,0,6,0" AutomationProperties.Name="{Binding Name}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="28" Height="28" Visibility="{Binding FlagVisibility}" Stroke="{DynamicResource FlagRing}" StrokeThickness="1">
                <Ellipse.Fill><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Ellipse.Fill>
              </Ellipse>
              <Border x:Name="IconPlate" Width="28" Height="28" CornerRadius="{StaticResource RadiusXl}" Background="{DynamicResource Aci}" Visibility="{Binding IconVisibility}">
                <Path x:Name="IconGlyph" Data="{Binding Icon}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource Ac}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FsLead}" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Tx}"/>
                <TextBlock Text="{Binding Note}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" TextTrimming="CharacterEllipsis" Visibility="{Binding NoteVisibility}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding LatencyVisibility}" ToolTip="{Binding LatencyHint}" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Ellipse Width="6" Height="6" Fill="{Binding LatencyDot}" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding Latency}" FontSize="{StaticResource FsBody}" Foreground="{DynamicResource Mu2}"/>
                </StackPanel>
                <TextBlock Text="{Binding Speed}" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}" HorizontalAlignment="Right" Visibility="{Binding SpeedVisibility}"/>
              </StackPanel>
            </Grid>
          </Button>
          <!-- Проверка одного сервера: видна при наведении и фокусе, для экранного диктора есть всегда. -->
          <Button x:Name="CheckButton" Grid.Column="1" Tag="check" Style="{StaticResource IconButton}" Width="36" Height="36" Opacity="0"
                  AutomationProperties.Name="Проверить этот сервер" ToolTip="Проверить этот сервер">
            <Path Data="{StaticResource IcoRefresh}" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{DynamicResource Mu2}"/>
          </Button>
          <!-- Убрать сервер: свой удаляется, сервер подписки скрывается. Виден при наведении. -->
          <Button x:Name="RemoveButton" Grid.Column="2" Tag="remove" Style="{StaticResource IconButton}" Width="36" Height="36" Opacity="0"
                  AutomationProperties.Name="Убрать сервер" ToolTip="Убрать сервер">
            <Path Data="{StaticResource IcoClose}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Mu2}"/>
          </Button>
          <Button x:Name="StarButton" Grid.Column="3" Tag="star" Style="{StaticResource IconButton}" Width="36" Height="36" Margin="0,0,4,0"
                  AutomationProperties.Name="Избранное" Visibility="Visible">
            <Path x:Name="StarGlyph" Data="{StaticResource IcoStar}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.8" StrokeLineJoin="Round" Stroke="{DynamicResource Fa}" Fill="Transparent"/>
          </Button>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Acs}"/>
          <Setter TargetName="RowButton" Property="Tag" Value="Transparent"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Favorite}" Value="True">
          <Setter TargetName="StarGlyph" Property="Fill" Value="{DynamicResource Star}"/>
          <Setter TargetName="StarGlyph" Property="Stroke" Value="{DynamicResource Star}"/>
          <Setter TargetName="StarButton" Property="AutomationProperties.Name" Value="Убрать из избранного"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding CanFavorite}" Value="False">
          <Setter TargetName="StarButton" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="CheckButton" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="RemoveButton" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <Trigger SourceName="Plate" Property="IsMouseOver" Value="True">
          <Setter TargetName="CheckButton" Property="Opacity" Value="1"/>
          <Setter TargetName="RemoveButton" Property="Opacity" Value="1"/>
        </Trigger>
        <Trigger SourceName="RemoveButton" Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="RemoveButton" Property="Opacity" Value="1"/>
        </Trigger>
        <Trigger SourceName="CheckButton" Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="CheckButton" Property="Opacity" Value="1"/>
        </Trigger>
        <DataTrigger Binding="{Binding IconOnAccent}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Ac}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="{DynamicResource OnAccent}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IconMuted}" Value="True">
          <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Field}"/>
          <Setter TargetName="IconGlyph" Property="Stroke" Value="{DynamicResource Mu2}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="10,0,20,0">
      <Button x:Name="BackButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Tx}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Назад">
        <Path Data="{StaticResource IcoBack}" Style="{StaticResource Icon}" StrokeThickness="2.2"/>
      </Button>
      <Button x:Name="SubscriptionsButton" DockPanel.Dock="Right" Content="Подписки и ключ" Style="{StaticResource BtnSecondary}" Height="36" Padding="16,0" Margin="6,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Обновить подписку" ToolTip="Обновить подписку">
        <Path Data="{StaticResource IcoRefresh}" Style="{StaticResource Icon}" Width="18" Height="18"/>
      </Button>
      <TextBlock Text="Серверы" Style="{StaticResource PageHead}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="20,0,20,4">
      <Grid>
        <TextBox x:Name="SearchBox" Height="42" Padding="34,0,12,0" FontSize="{StaticResource FsRow}" VerticalContentAlignment="Center" BorderThickness="0"
                 Background="{DynamicResource Field}" Foreground="{DynamicResource Tx}" CaretBrush="{DynamicResource Tx}" AutomationProperties.Name="Найти сервер">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Plate" CornerRadius="{StaticResource RadiusMd}" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ac}" BorderThickness="0">
                <Grid>
                  <TextBlock x:Name="Hint" Text="Страна или название" Foreground="{DynamicResource Fa}" Margin="36,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                  <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Plate" Property="BorderThickness" Value="2"/>
                  <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Bg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
        <Path Data="{StaticResource IcoSearch}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Fa}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
      </Grid>
      <!-- Подписка сервиса: срок и остаток квадратами; автовыбор — из каких серверов. -->
      <Border x:Name="SubStrip" Style="{StaticResource Plate}" Background="{DynamicResource NB}" Margin="0,10,0,0" Padding="16,12" Visibility="Collapsed">
        <DockPanel>
          <v:PixelBars x:Name="SubStripBars" DockPanel.Dock="Right" Kind="Segments" Count="10" Width="150" Height="14" VerticalAlignment="Center" Fill="{DynamicResource RouteVpn}" Empty="{DynamicResource Bg}"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock x:Name="SubStripTitle" FontSize="{StaticResource FsRow}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubStripText" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource NF}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Button x:Name="OpenAutoPool" Style="{StaticResource Row}" Height="Auto" MinHeight="48" Padding="12,6" Margin="0,8,0,0" BorderBrush="{DynamicResource Divider}" BorderThickness="1.5" AutomationProperties.Name="Серверы автовыбора">
        <DockPanel>
          <Path DockPanel.Dock="Right" Data="{StaticResource IcoChevronRight}" Style="{StaticResource Icon}" Width="14" Height="14" StrokeThickness="2.2" Margin="8,0,0,0"/>
          <TextBlock x:Name="AutoPoolSummary" DockPanel.Dock="Right" FontSize="{StaticResource FsNote}" Foreground="{DynamicResource Mu2}" VerticalAlignment="Center"/>
          <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Cream}" Margin="0,0,12,0">
            <Path Data="{StaticResource IcoAuto}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Orb}"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Серверы автовыбора" FontSize="{StaticResource FsRow}" FontWeight="SemiBold"/>
            <TextBlock Text="Автовыбор берёт самый быстрый из отмеченных" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Mu2}"/>
          </StackPanel>
        </DockPanel>
      </Button>
      <!-- Вкладки подписок, как в Throne: «Все» и по одной на группу. Видны, когда групп больше одной. -->
      <ScrollViewer x:Name="GroupTabsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0" Visibility="Collapsed">
        <ListBox x:Name="GroupTabs" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 AutomationProperties.Name="Подписки" SelectedIndex="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
        </ListBox>
      </ScrollViewer>
      <!-- Вкладка «Бесплатные»: какой список загрузить, и напоминание, что серверы чужие. -->
      <StackPanel x:Name="FreePanel" Margin="0,10,0,0" Visibility="Collapsed">
        <ListBox x:Name="FreeKind" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Список бесплатных серверов" SelectedIndex="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          <sys:String>Обычный</sys:String>
          <sys:String>Мобильный</sys:String>
          <sys:String>Белые списки</sys:String>
        </ListBox>
        <TextBlock Text="Чужие серверы: их владельцы видят, какие сайты вы открываете. Не входите через них в банк, почту и Госуслуги." FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource WF}" TextWrapping="Wrap" Margin="2,8,0,0"/>
      </StackPanel>
      <DockPanel Margin="0,10,0,0">
        <TextBlock x:Name="MeasuredAgo" DockPanel.Dock="Right" FontSize="{StaticResource FsSmall}" Foreground="{DynamicResource Fa}" VerticalAlignment="Center"/>
        <ListBox x:Name="SortOrder" ItemContainerStyle="{StaticResource ChipItem}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Порядок серверов" SelectedIndex="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
          <sys:String>Лучшие сверху</sys:String>
          <sys:String>По названию</sys:String>
          <sys:String>Как в подписке</sys:String>
        </ListBox>
      </DockPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Padding="10,0">
      <StackPanel>
        <ItemsControl x:Name="SheetList" Focusable="False"/>
        <Button x:Name="AddButton" Style="{StaticResource Row}" Height="44" Margin="0,6,0,0" Foreground="{DynamicResource Ac}" AutomationProperties.Name="Добавить ключ, ссылку или файл">
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="{StaticResource RadiusXl}" BorderBrush="{DynamicResource Ring}" BorderThickness="1.5">
              <Path Data="{StaticResource IcoPlus}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Ac}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <TextBlock Text="Добавить ключ, ссылку или файл" FontSize="{StaticResource FsLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel x:Name="AddPanel" Margin="50,0,0,8" Visibility="Collapsed">
          <Button x:Name="PasteButton" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Content="Вставить из буфера обмена"/>
          <Button x:Name="ImportFileButton" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Content="Открыть файл профиля (JSON, txt)"/>
          <Button x:Name="ScanButton" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Content="QR-код на экране"/>
          <Button x:Name="SubscriptionButton" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Content="Адреса подписки…"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1.5,0,0" Padding="16,10,16,14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="3" Margin="4,0,0,10">
          <CheckBox x:Name="AutoRecover" DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="True" AutomationProperties.Name="Переключать сервер при обрыве"/>
          <TextBlock Text="Сервер упал — переключить на другой" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Button x:Name="MeasureButton" Grid.Row="1" Style="{StaticResource BtnSecondary}" Content="Обновить пинг" ToolTip="Задержка через каждый сервер — работает и при подключении"/>
        <Button x:Name="BestButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="Подключить лучший"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
