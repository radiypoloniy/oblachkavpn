<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Отдельный проект: тестовый код не попадает в поставляемый Oblachka.exe. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Oblachka.Tests</AssemblyName>
    <Version>0.11.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>Oblachka.TestProgram</StartupObject>
    <RestoreSources></RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- Один источник global using на оба проекта. -->
    <Compile Include="..\src\GlobalUsings.cs" Link="GlobalUsings.cs"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Oblachka.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <!-- Картинки QR, сделанные segno 1.6.6: обычные, повёрнутая, повреждённая, версия 40, «снимок экрана». -->
    <None Include="Fixtures\Qr\*" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
